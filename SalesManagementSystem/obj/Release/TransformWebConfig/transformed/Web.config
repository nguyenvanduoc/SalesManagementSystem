<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ConfigFile" value="~/App_Config/system.dat" />
    <add key="KeyPart1" value="VanDuoc@123123!" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <!-- Cố định machineKey để tránh lỗi giải mã Anti-forgery token (HttpAntiForgeryException) khi AppPool recycle hoặc deploy code mới -->
    <machineKey validationKey="68132D9D50B565C83437DE7CD518C1D61405106E22769493B14006D41E7A7B9B422B294328EB5A66DF15EA57DA3CCBFEA4F1D77C0739E0785BD92AF6B6FE9365" decryptionKey="290483C210A6F4E83201948BCE107384D024B105F8214DE29034E28194CE8120" validation="SHA1" decryption="AES" />
    <!-- Session timeout 40 tiếng (2400 phút). Keep-alive JS sẽ ping mỗi 4 phút để duy trì session khi đang sử dụng -->
    <sessionState timeout="2400" />
    <customErrors mode="Off" />
    <compilation targetFramework="4.8" />
    <!-- maxRequestLength is in KB, 51200 KB = 50 MB -->
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="51200" executionTimeout="3600" />
    <!-- Bắt buộc UTF-8 cho toàn bộ response — fix lỗi vỡ chữ tiếng Việt -->
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="vi-VN" uiCulture="vi-VN" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- maxAllowedContentLength is in Bytes, 52428800 Bytes = 50 MB -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
