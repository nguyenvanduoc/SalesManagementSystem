@{
    ViewBag.Title = "Dashboard";
}

<style>
    /* ─── Stat Cards ─────────────────────────────── */
    .stat-card {
        background: #fff;
        border-radius: 14px;
        padding: 22px 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        border: 1px solid #eaf0f6;
        transition: transform .2s, box-shadow .2s;
        text-decoration: none;
        color: inherit;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 22px rgba(0,0,0,.11);
        color: inherit;
    }
    .stat-icon {
        width: 54px; height: 54px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }
    .stat-icon.green  { background: #e8f8f5; color: #1abc9c; }
    .stat-icon.blue   { background: #eaf4fb; color: #2e86c1; }
    .stat-icon.orange { background: #fef5e7; color: #e67e22; }
    .stat-icon.red    { background: #fdedec; color: #e74c3c; }

    .stat-body .label { font-size: .78rem; color: #95a5a6; font-weight: 500; margin-bottom: 3px; }
    .stat-body .value { font-size: 1.65rem; font-weight: 700; color: #1a2035; line-height: 1; }
    .stat-body .trend { font-size: .76rem; margin-top: 5px; }
    .trend.up   { color: #1abc9c; }
    .trend.down { color: #e74c3c; }

    /* ─── Section card ───────────────────────────── */
    .card-panel {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        border: 1px solid #eaf0f6;
        overflow: hidden;
    }
    .card-panel .card-header-custom {
        padding: 16px 22px;
        border-bottom: 1px solid #eaf0f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .card-panel .card-header-custom h5 {
        margin: 0;
        font-size: .95rem;
        font-weight: 700;
        color: #1a2035;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .card-panel .card-body-custom { padding: 18px 22px; }

    /* ─── Quick actions ──────────────────────────── */
    .quick-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 18px 12px;
        background: #f8fafc;
        border: 2px dashed #d5e8f0;
        border-radius: 12px;
        text-decoration: none;
        color: #2c3e50;
        font-size: .82rem;
        font-weight: 600;
        transition: background .2s, border-color .2s;
    }
    .quick-btn:hover {
        background: #e8f8f5;
        border-color: #1abc9c;
        color: #1abc9c;
    }
    .quick-btn i { font-size: 1.6rem; }

    /* ─── Module shortcuts ───────────────────────── */
    .module-card {
        background: #fff;
        border-radius: 14px;
        padding: 20px;
        text-decoration: none;
        display: block;
        border: 1px solid #eaf0f6;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
        transition: transform .2s, box-shadow .2s;
    }
    .module-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,.1); }
    .module-card .mod-icon {
        width: 48px; height: 48px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 12px;
    }
    .module-card h6 { font-size: .9rem; font-weight: 700; color: #1a2035; margin-bottom: 4px; }
    .module-card p  { font-size: .78rem; color: #7f8c8d; margin: 0; }
</style>

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1><i class="bi bi-speedometer2 me-2" style="color:var(--accent)"></i>Dashboard</h1>
        <div class="breadcrumb-wrap mt-1">
            <a href="#">Trang chủ</a> / Dashboard
        </div>
    </div>
    <div class="text-muted" style="font-size:.82rem">
        <i class="bi bi-calendar3 me-1"></i>
        <span id="currentDate"></span>
    </div>
</div>

<!-- ═══════════════ STAT CARDS ═══════════════ -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <a href="#" class="stat-card">
            <div class="stat-icon green"><i class="bi bi-cart-check-fill"></i></div>
            <div class="stat-body">
                <div class="label">Đơn hàng hôm nay</div>
                <div class="value">24</div>
                <div class="trend up"><i class="bi bi-arrow-up-short"></i>12% so với hôm qua</div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <a href="#" class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-currency-dollar"></i></div>
            <div class="stat-body">
                <div class="label">Doanh thu tháng này</div>
                <div class="value">48.2M</div>
                <div class="trend up"><i class="bi bi-arrow-up-short"></i>8.4% so với tháng trước</div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <a href="#" class="stat-card">
            <div class="stat-icon orange"><i class="bi bi-boxes"></i></div>
            <div class="stat-body">
                <div class="label">Sản phẩm trong kho</div>
                <div class="value">312</div>
                <div class="trend down"><i class="bi bi-arrow-down-short"></i>5 loại sắp hết hàng</div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <a href="#" class="stat-card">
            <div class="stat-icon red"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="stat-body">
                <div class="label">Lợi nhuận tháng</div>
                <div class="value">14.7M</div>
                <div class="trend up"><i class="bi bi-arrow-up-short"></i>+3.1% so với tháng trước</div>
            </div>
        </a>
    </div>
</div>

<!-- ═══════════════ ROW 2: Quick Actions + Modules ═══════════════ -->
<div class="row g-3 mb-4">
    <!-- Quick Actions -->
    <div class="col-12 col-lg-4">
        <div class="card-panel h-100">
            <div class="card-header-custom">
                <h5><i class="bi bi-lightning-charge-fill" style="color:#f39c12"></i> Thao tác nhanh</h5>
            </div>
            <div class="card-body-custom">
                <div class="row g-2">
                    <div class="col-6">
                        <a href="@Url.Action("Create","Order")" class="quick-btn">
                            <i class="bi bi-cart-plus" style="color:#1abc9c"></i>
                            Tạo đơn hàng
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="@Url.Action("StockIn","Inventory")" class="quick-btn">
                            <i class="bi bi-arrow-down-circle" style="color:#2e86c1"></i>
                            Nhập kho
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="@Url.Action("Create","Product")" class="quick-btn">
                            <i class="bi bi-plus-square" style="color:#8e44ad"></i>
                            Thêm sản phẩm
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="#" class="quick-btn">
                            <i class="bi bi-file-earmark-arrow-down" style="color:#e67e22"></i>
                            Xuất báo cáo
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Module shortcuts -->
    <div class="col-12 col-lg-8">
        <div class="card-panel h-100">
            <div class="card-header-custom">
                <h5><i class="bi bi-grid-fill" style="color:#2e86c1"></i> Phân hệ chính</h5>
            </div>
            <div class="card-body-custom">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <a href="@Url.Action("Index","Order")" class="module-card">
                            <div class="mod-icon" style="background:#e8f8f5">
                                <i class="bi bi-cart3" style="color:#1abc9c"></i>
                            </div>
                            <h6>Đơn hàng</h6>
                            <p>Quản lý bán hàng</p>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a href="@Url.Action("Index","Product")" class="module-card">
                            <div class="mod-icon" style="background:#eaf4fb">
                                <i class="bi bi-box2-fill" style="color:#2e86c1"></i>
                            </div>
                            <h6>Sản phẩm</h6>
                            <p>Danh mục hàng hóa</p>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a href="@Url.Action("Index","Inventory")" class="module-card">
                            <div class="mod-icon" style="background:#fef5e7">
                                <i class="bi bi-boxes" style="color:#e67e22"></i>
                            </div>
                            <h6>Kho bãi</h6>
                            <p>Nhập xuất tồn kho</p>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a href="#" class="module-card">
                            <div class="mod-icon" style="background:#f9ebea">
                                <i class="bi bi-bar-chart-line-fill" style="color:#e74c3c"></i>
                            </div>
                            <h6>Báo cáo</h6>
                            <p>Doanh thu & lợi nhuận</p>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════ ROW 3: Recent Orders ═══════════════ -->
<div class="row g-3">
    <div class="col-12">
        <div class="card-panel">
            <div class="card-header-custom">
                <h5><i class="bi bi-clock-history" style="color:#1a5276"></i> Đơn hàng gần đây</h5>
                <a href="@Url.Action("Index","Order")" style="font-size:.82rem;color:var(--accent)">
                    Xem tất cả <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body-custom" style="padding:0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:.875rem">
                        <thead style="background:#f8fafc">
                            <tr>
                                <th class="ps-4 py-3 text-muted fw-600" style="font-size:.75rem;letter-spacing:.5px">MÃ ĐH</th>
                                <th class="py-3 text-muted fw-600" style="font-size:.75rem;letter-spacing:.5px">NGÀY</th>
                                <th class="py-3 text-muted fw-600" style="font-size:.75rem;letter-spacing:.5px">nhân sự</th>
                                <th class="py-3 text-muted fw-600" style="font-size:.75rem;letter-spacing:.5px">TỔNG TIỀN</th>
                                <th class="py-3 text-muted fw-600" style="font-size:.75rem;letter-spacing:.5px">TRẠNG THÁI</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-4 py-3 fw-bold">#DH-0024</td>
                                <td class="py-3 text-muted">02/06/2026</td>
                                <td class="py-3">Nguyễn Văn A</td>
                                <td class="py-3 fw-600" style="color:#1abc9c">2,450,000₫</td>
                                <td class="py-3"><span class="badge rounded-pill" style="background:#e8f8f5;color:#1abc9c;padding:5px 12px">Hoàn thành</span></td>
                            </tr>
                            <tr>
                                <td class="ps-4 py-3 fw-bold">#DH-0023</td>
                                <td class="py-3 text-muted">02/06/2026</td>
                                <td class="py-3">Trần Thị B</td>
                                <td class="py-3 fw-600" style="color:#1abc9c">980,000₫</td>
                                <td class="py-3"><span class="badge rounded-pill" style="background:#fef5e7;color:#e67e22;padding:5px 12px">Đang xử lý</span></td>
                            </tr>
                            <tr>
                                <td class="ps-4 py-3 fw-bold">#DH-0022</td>
                                <td class="py-3 text-muted">01/06/2026</td>
                                <td class="py-3">Lê Văn C</td>
                                <td class="py-3 fw-600" style="color:#1abc9c">5,120,000₫</td>
                                <td class="py-3"><span class="badge rounded-pill" style="background:#e8f8f5;color:#1abc9c;padding:5px 12px">Hoàn thành</span></td>
                            </tr>
                            <tr>
                                <td class="ps-4 py-3 fw-bold">#DH-0021</td>
                                <td class="py-3 text-muted">01/06/2026</td>
                                <td class="py-3">Phạm Thị D</td>
                                <td class="py-3 fw-600" style="color:#e74c3c">750,000₫</td>
                                <td class="py-3"><span class="badge rounded-pill" style="background:#fdedec;color:#e74c3c;padding:5px 12px">Đã huỷ</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    // Server-side date generation (tránh lỗi TS của Visual Studio cho file cshtml)
    document.getElementById('currentDate').textContent = '@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("vi-VN"))';
</script>
}