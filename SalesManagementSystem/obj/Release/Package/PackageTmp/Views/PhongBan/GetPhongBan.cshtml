@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.Entities.PhongBan>

@{
    ViewBag.Title = "Quản lý Phòng Ban";
}

@using SalesManagementSystem.Helpers
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">@ViewBag.Title</h4>
    <div class="d-flex gap-2">
        @if (PermissionHelper.HasPermission("PhongBan", LoaiPhanQuyen.Them))
        {
            <button type="button" class="btn btn-primary" style="background-color: #3498db; border-color: #3498db;" onclick="openFormModal('@Url.Action("CreatePhongBan", "PhongBan")')">
                <i class="bi bi-plus-lg fw-bold"></i> Thêm mới
            </button>
        }
        @if (PermissionHelper.HasPermission("PhongBan", LoaiPhanQuyen.Xoa))
        {
            <button type="button" class="btn btn-danger" style="background-color: #e74c3c; border-color: #e74c3c;" onclick="deleteSelected()">
                <i class="bi bi-trash"></i> Xóa
            </button>
        }
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form id="searchForm" method="get">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <input type="text" name="keyword" class="form-control" placeholder="Nhập tên hoặc mã phòng ban..." value="@ViewBag.Keyword">
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn text-white px-3" style="background-color: #2998e4; border: none;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn text-white px-3" style="background-color: #f1c40f; border: none;" onclick="resetSearch()">
                        Làm mới
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="table-container">
    @Html.Partial("_PhongBanList", Model)
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Check/Uncheck all checkboxes
            $(document).on('change', '#checkAll', function() {
                $('.row-checkbox').prop('checked', $(this).prop('checked'));
            });

            // If any row checkbox is unchecked, uncheck the header checkbox
            $(document).on('change', '.row-checkbox', function() {
                if ($('.row-checkbox:checked').length === $('.row-checkbox').length && $('.row-checkbox').length > 0) {
                    $('#checkAll').prop('checked', true);
                } else {
                    $('#checkAll').prop('checked', false);
                }
            });

            $('#searchForm').submit(function(e) {
                e.preventDefault();
                loadData($(this).serialize());
            });

            $(document).on('click', '.ajax-link', function(e) {
                e.preventDefault();
                if ($(this).parent().hasClass('disabled') || $(this).parent().hasClass('active')) return;
                var url = $(this).attr('href');
                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function(result) {
                        $('#table-container').html(result);
                    }
                });
            });

            $(document).on('change', '#pageSizeSelect', function() {
                var pageSize = $(this).val();
                var currentKeyword = $('input[name="keyword"]').val();
                loadData('page=1&pageSize=' + pageSize + '&keyword=' + encodeURIComponent(currentKeyword));
            });
        });

        function loadData(data) {
            $.ajax({
                url: '@Url.Action("GetPhongBan", "PhongBan")',
                type: 'GET',
                data: data,
                success: function(result) {
                    $('#table-container').html(result);
                },
                error: function() {
                    showToast('error', 'Có lỗi xảy ra khi tải dữ liệu.');
                }
            });
        }

        function resetSearch() {
            $('input[name="keyword"]').val('');
            loadData('');
        }

        function deleteSelected() {
            var selectedIds = [];
            $('.row-checkbox:checked').each(function() {
                selectedIds.push($(this).val());
            });

            if (selectedIds.length === 0) {
                showToast('warning', 'Vui lòng chọn ít nhất một phòng ban để thao tác.');
                return;
            }

            var url = '@Url.Action("DeletePhongBan", "PhongBan")';
            var msg = "Bạn có chắc chắn muốn xóa " + selectedIds.length + " phòng ban đã chọn không?";
            
            confirmBatchDelete(url, selectedIds, msg);
        }
    </script>
}
