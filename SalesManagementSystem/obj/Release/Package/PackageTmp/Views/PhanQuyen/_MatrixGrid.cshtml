@model IEnumerable<SalesManagementSystem.Models.ViewModels.PhanQuyenMatrixViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-warning text-white fw-bold" id="btnCollapseAllGroup" style="background-color: #f1c40f; border: none;">
            <i class="bi bi-x"></i> Đóng tất cả
        </button>
        <button type="button" class="btn btn-sm btn-info text-white fw-bold" id="btnExpandAllGroup" style="background-color: #3498db; border: none;">
            <i class="bi bi-plus"></i> Mở tất cả
        </button>
        <div class="form-check ms-3 d-flex align-items-center">
            <input class="form-check-input" type="checkbox" id="checkAllMatrix" style="cursor: pointer;">
            <label class="form-check-label ms-2 text-dark" for="checkAllMatrix" style="cursor: pointer;">Chọn tất cả</label>
        </div>
        <div class="form-check ms-4 d-flex align-items-center">
            <input class="form-check-input" type="checkbox" id="checkInherit" style="cursor: pointer;">
            <label class="form-check-label ms-2 text-primary fw-bold" for="checkInherit" style="cursor: pointer;">Kế thừa quyền cấp trên</label>
        </div>
    </div>
</div>

<div class="table-responsive" style="border: 1px solid #dee2e6;">
    <table id="tblMatrixGrid" class="table table-custom table-bordered table-hover mb-0" style="width:100%; min-width:1000px;">
        <thead>
            <tr>
                <th class="align-middle" style="width: 40%">Chức năng</th>
                <th class="text-center align-middle" style="width: 10%">Xem</th>
                <th class="text-center align-middle" style="width: 10%">Thêm</th>
                <th class="text-center align-middle" style="width: 10%">Sửa</th>
                <th class="text-center align-middle" style="width: 10%">Xóa</th>
                <th class="text-center align-middle" style="width: 20%">Tùy chọn</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model)
            {
                <tr class="group-header" style="background-color: #e9ecef; cursor: pointer;">
                    <td colspan="6" class="fw-bold">
                        <i class="bi bi-caret-down-fill me-1"></i>
                        <input type="checkbox" class="form-check-input me-2 group-checkbox">
                        @group.NhomChaManHinh
                    </td>
                </tr>
                foreach (var screen in group.Screens)
                {
                    <tr class="screen-row">
                        <td class="ps-5">
                            <input type="checkbox" class="form-check-input me-2 screen-checkbox">
                            <span>@screen.TenManHinh</span>
                        </td>
                        
                        @for (int i = 1; i <= 4; i++)
                        {
                            <td class="text-center align-middle">
                                @{
                                    var action = screen.Actions.FirstOrDefault(a => a.LoaiPhanQuyen == i);
                                    if (action != null)
                                    {
                                        <input type="checkbox" class="form-check-input action-checkbox" value="@action.IDAction" @(action.IsChoPhep ? "checked" : "")>
                                    }
                                }
                            </td>
                        }
                        
                        <!-- Cột Tùy chọn (LoaiPhanQuyen = 5) -->
                        <td class="align-middle" style="text-align: left; padding-left: 10px;">
                            @{
                                var customActions = screen.Actions.Where(a => a.LoaiPhanQuyen == 5).ToList();
                                if (customActions.Any())
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var cAction in customActions)
                                        {
                                            <div class="form-check m-0">
                                                <input type="checkbox" id="chk_@cAction.IDAction" class="form-check-input action-checkbox" value="@cAction.IDAction" @(cAction.IsChoPhep ? "checked" : "")>
                                                <label class="form-check-label text-dark" for="chk_@cAction.IDAction" style="cursor: pointer;">@cAction.GhiChu</label>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </td>
                    </tr> 
                }
            }
        </tbody>
    </table>
</div>

<script>
    $(document).ready(function() {
        // Toggle group
        $('.group-header').click(function(e) {
            if ($(e.target).is('input')) return; // ignore checkbox click
            var icon = $(this).find('i.bi');
            icon.toggleClass('bi-caret-down-fill bi-caret-right-fill');
            $(this).nextUntil('.group-header').toggle();
        });

        $('#btnCollapseAllGroup').click(function() {
            $('.group-header i.bi').removeClass('bi-caret-down-fill').addClass('bi-caret-right-fill');
            $('.screen-row').hide();
        });

        $('#btnExpandAllGroup').click(function() {
            $('.group-header i.bi').removeClass('bi-caret-right-fill').addClass('bi-caret-down-fill');
            $('.screen-row').show();
        });

        // Checkbox cascades
        $('#checkAllMatrix').change(function() {
            var isChecked = $(this).prop('checked');
            $('#matrixContainer .form-check-input:not(#checkInherit)').prop('checked', isChecked);
        });

        $('.group-checkbox').change(function() {
            var isChecked = $(this).prop('checked');
            $(this).closest('tr').nextUntil('.group-header').find('.form-check-input').prop('checked', isChecked);
            updateCheckAllState();
        });

        $('.screen-checkbox').change(function() {
            var isChecked = $(this).prop('checked');
            $(this).closest('tr').find('.action-checkbox').prop('checked', isChecked);
            
            // Check if all screens in group are checked, then check group
            var groupRow = $(this).closest('tr').prevAll('.group-header').first();
            var allScreens = groupRow.nextUntil('.group-header').find('.screen-checkbox');
            var allChecked = allScreens.length === allScreens.filter(':checked').length;
            groupRow.find('.group-checkbox').prop('checked', allChecked);
            
            updateCheckAllState();
        });

        $('.action-checkbox').change(function() {
            var screenRow = $(this).closest('tr');
            var allActions = screenRow.find('.action-checkbox');
            var allChecked = allActions.length === allActions.filter(':checked').length;
            screenRow.find('.screen-checkbox').prop('checked', allChecked);
            
            // Also update group
            var groupRow = screenRow.prevAll('.group-header').first();
            var allScreens = groupRow.nextUntil('.group-header').find('.screen-checkbox');
            var allGroupChecked = allScreens.length === allScreens.filter(':checked').length;
            groupRow.find('.group-checkbox').prop('checked', allGroupChecked);
            
            updateCheckAllState();
        });

        function updateCheckAllState() {
            var allActionBoxes = $('.action-checkbox');
            var allChecked = allActionBoxes.length > 0 && allActionBoxes.length === allActionBoxes.filter(':checked').length;
            $('#checkAllMatrix').prop('checked', allChecked);
        }
        
        // Setup initial partial states if needed (not strictly required if server state matches)
    });
</script>

<style>
    #tblMatrixGrid th {
        position: relative;
        background-clip: padding-box;
    }
    #tblMatrixGrid th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblMatrixGrid th .resizer:hover, #tblMatrixGrid th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var table = document.getElementById('tblMatrixGrid');
        if (!table) return;
        
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            // Skip for icon columns, checkbox columns and action columns
            if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
            if(th.innerText.trim() === 'Thao tác' || th.innerText.trim() === 'STT') return;
            
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                
                e.preventDefault();
            });
        });
    })();
</script>
