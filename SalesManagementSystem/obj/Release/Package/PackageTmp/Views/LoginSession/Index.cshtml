@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.AclLoginSessionViewModel>
@{
    ViewBag.Title = "Lịch sử đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">@ViewBag.Title</h4>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Index", "LoginSession")" id="searchForm">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="keyword" class="form-control" placeholder="Tìm theo tài khoản, họ tên, IP..." value="@ViewBag.Keyword">
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn text-white px-3" style="background-color: #2998e4; border: none;">
                        <i class="fas fa-search me-1"></i> Tìm kiếm
                    </button>
                    <button type="button" onclick="resetSearch()" class="btn text-white px-3" style="background-color: #f1c40f; border: none;">
                        Làm mới
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="gridData">
    @Html.Partial("_LoginSessionList", Model)
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Xử lý submit form tìm kiếm qua Ajax
            $('#searchForm').on('submit', function (e) {
                e.preventDefault();
                var url = $(this).attr('action');
                var data = $(this).serialize();
                loadGridData(url + '?' + data);
            });
        });

        // Hàm tải dữ liệu grid qua Ajax
        function loadGridData(url) {
            $.ajax({
                url: url,
                type: 'GET',
                success: function (result) {
                    $('#gridData').html(result);
                },
                error: function () {
                    alert('Đã xảy ra lỗi khi tải dữ liệu!');
                }
            });
        }

        // Lắng nghe thay đổi kích thước trang (pageSize)
        $(document).on('change', '#pageSizeSelect', function() {
            var keyword = $('input[name="keyword"]').val();
            var pageSize = $(this).val();
            loadGridData('@Url.Action("Index", "LoginSession")?page=1&pageSize=' + pageSize + '&keyword=' + encodeURIComponent(keyword));
        });

        // Xử lý nút bấm phân trang sử dụng AJAX
        $(document).on('click', '.ajax-link', function (e) {
            e.preventDefault();
            if ($(this).parent().hasClass('disabled') || $(this).parent().hasClass('active')) return;
            var url = $(this).attr('href');
            if (url) {
                loadGridData(url);
            }
        });

        // Hàm Làm mới
        function resetSearch() {
            $('input[name="keyword"]').val('');
            $('#searchForm').submit();
        }

        // Xử lý nút Kích
        $(document).on('click', '.btn-kick', function () {
            var id = $(this).data('id');
            if (confirm('Bạn có chắc chắn muốn ngắt phiên đăng nhập của người dùng này? Họ sẽ bị văng ra ngoài ngay lập tức.')) {
                $.ajax({
                    url: '@Url.Action("KickUser", "LoginSession")',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            showToast('success', res.message);
                            $('#searchForm').submit();
                        } else {
                            showToast('error', res.message);
                        }
                    },
                    error: function () {
                        showToast('error', 'Lỗi hệ thống khi ngắt phiên.');
                    }
                });
            }
        });
    </script>
}
