@model SalesManagementSystem.Models.ViewModels.DMBieuMauCreateEditViewModel

<form id="bieuMauForm" action="@Url.Action("CreateEdit", "DMBieuMau")" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ID)

    <div class="modal-header bg-light">
        <h5 class="modal-title text-primary fw-bold">
            <i class="bi bi-file-earmark-text me-2"></i> @(Model.ID == 0 ? "Thêm mới biểu mẫu" : "Cập nhật biểu mẫu")
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    
    <div class="modal-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label fw-bold">Mã biểu mẫu <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.MaBieuMau, new { @class = "form-control", @placeholder = "VD: H05001" })
                @Html.ValidationMessageFor(m => m.MaBieuMau, "", new { @class = "text-danger d-block mt-1" })
            </div>
            <div class="col-md-8">
                <label class="form-label fw-bold">Tên biểu mẫu <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.TenBieuMau, new { @class = "form-control", @placeholder = "VD: QuanLyNhanVien" })
                @Html.ValidationMessageFor(m => m.TenBieuMau, "", new { @class = "text-danger d-block mt-1" })
            </div>
            <div class="col-12">
                <small class="text-muted d-block mt-1">Gợi ý: Chọn file trước để tự động lấy Mã và Tên biểu mẫu từ tên file (định dạng [Mã]_[Tên].ext)</small>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">File biểu mẫu @(Model.ID == 0 ? Html.Raw("<span class='text-danger'>*</span>") : Html.Raw(""))</label>
            <input type="file" name="UploadedFile" id="UploadedFile" class="form-control" accept=".doc,.docx,.xls,.xlsx,.pdf" />
            @Html.ValidationMessageFor(m => m.UploadedFile, "", new { @class = "text-danger d-block mt-1" })
            @if (Model.ID > 0 && !string.IsNullOrEmpty(Model.TenFile))
            {
                <small class="text-muted d-block mt-1">File hiện tại: @Model.TenFile (Chọn file mới nếu muốn thay thế)</small>
            }
        </div>
    </div>
    
    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Đóng
        </button>
        <button type="submit" class="btn btn-primary" id="btnSaveBieuMau">
            <i class="bi bi-save me-1"></i> Lưu dữ liệu
        </button>
    </div>
</form>

<script>
    $(document).ready(function () {
        // Validation with jquery.validate (if loaded) or custom submit handler
        var form = $('#bieuMauForm');
        
        form.on('submit', function (e) {
            e.preventDefault();
            e.stopPropagation(); // Ngăn global handler trong _Layout.cshtml chạy lần 2
            
            // Client side validation
            var maBieuMau = $('#MaBieuMau').val().trim();
            var tenBieuMau = $('#TenBieuMau').val().trim();
            if (!maBieuMau || !tenBieuMau) {
                showToast('error', 'Mã và Tên biểu mẫu không được để trống.');
                return false;
            }

            var formData = new FormData(this);
            $('#btnSaveBieuMau').prop('disabled', true).html('<i class="spinner-border spinner-border-sm me-1"></i> Đang lưu...');

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.success) {
                        form.closest('.modal').modal('hide');
                        showToast('success', res.message);
                        if (typeof TabManager !== 'undefined') {
                            TabManager.reloadActiveTabGrid(false);
                        } else {
                            $('#searchForm').submit(); // reload list (fallback)
                        }
                    } else {
                        // If it returns HTML with validation errors
                        $('#globalFormModal .modal-content').html(res);
                    }
                },
                error: function () {
                    showToast('error', 'Có lỗi xảy ra trong quá trình lưu dữ liệu.');
                },
                complete: function () {
                    $('#btnSaveBieuMau').prop('disabled', false).html('<i class="bi bi-save me-1"></i> Lưu dữ liệu');
                }
            });
        });

        // Tự động điền Tên biểu mẫu từ tên file upload
        $('#UploadedFile').on('change', function () {
            var file = this.files[0];
            if (file) {
                var fileName = file.name;
                var lastDotIndex = fileName.lastIndexOf('.');
                if (lastDotIndex > 0) {
                    fileName = fileName.substring(0, lastDotIndex); // Bỏ đuôi file
                }
                
                // Phân tích tên file: [MãBiểuMẫu]_[TênBiểuMẫu]
                var parts = fileName.split('_');
                if (parts.length >= 2) {
                    var ma = parts[0];
                    // Nếu tên file có nhiều dấu _, phần còn lại là tên biểu mẫu
                    var ten = fileName.substring(ma.length + 1);
                    
                    // Chỉ tự động điền nếu người dùng chưa nhập gì
                    if (!$('#MaBieuMau').val()) {
                        $('#MaBieuMau').val(ma);
                    }
                    if (!$('#TenBieuMau').val()) {
                        $('#TenBieuMau').val(ten);
                    }
                } else {
                    // Nếu không đúng định dạng _, chỉ điền vào Tên
                    if (!$('#TenBieuMau').val()) {
                        $('#TenBieuMau').val(fileName);
                    }
                }
            }
        });
    });
</script>


