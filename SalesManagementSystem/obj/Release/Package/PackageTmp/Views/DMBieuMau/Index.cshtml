@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.DMBieuMauViewModel>

@{
    ViewBag.Title = "Danh mục biểu mẫu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">@ViewBag.Title</h4>
    @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("DMBieuMau", SalesManagementSystem.Helpers.LoaiPhanQuyen.Them))
    {
        <button type="button" class="btn btn-primary" onclick="openFormModal('@Url.Action("CreateEdit", "DMBieuMau", new { id = 0 })')">
            <i class="bi bi-plus-circle me-1"></i> Thêm mới
        </button>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Index", "DMBieuMau")" id="searchForm">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="keyword" class="form-control" placeholder="Tìm theo Mã hoặc Tên biểu mẫu..." value="@ViewBag.Keyword">
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn text-white px-3" style="background-color: #2998e4; border: none;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <a href="@Url.Action("Index")" class="btn text-white px-3" style="background-color: #f1c40f; border: none;">
                        Làm mới
                        
                    </a>
                </div>
            </div>  
        </form>
    </div>
</div>

<div id="gridData">
    @Html.Partial("_BieuMauList", Model)
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#searchForm').on('submit', function (e) {
                e.preventDefault();
                var url = $(this).attr('action');
                var data = $(this).serialize();
                loadGridData(url + '?' + data);
            });
        });

        function loadGridData(url) {
            $.ajax({
                url: url,
                type: 'GET',
                success: function (result) {
                    $('#gridData').html(result);
                },
                error: function () {
                    alert('Đã xảy ra lỗi khi tải dữ liệu!');
                }
            });
        }
    </script>
}
