@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.Entities.NhanSu>

@{
    ViewBag.Title = "Danh sách nhân sự";
}

@using SalesManagementSystem.Helpers
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">@ViewBag.Title</h4>
    <div class="d-flex gap-2">
        @if (PermissionHelper.HasPermission("NhanSu", LoaiPhanQuyen.Them))
        {
            <button type="button" class="btn btn-primary" style="background-color: #3498db; border-color: #3498db;" onclick="openFormModal('@Url.Action("Create", "NhanSu")')">
                <i class="bi bi-plus-lg fw-bold"></i> Thêm
            </button>
        }
        <a href="@Url.Action("ExportExcel", "NhanSu")" class="btn btn-success no-ajax" style="background-color: #2ecc71; border-color: #2ecc71;">
            <i class="bi bi-file-earmark-excel fw-bold"></i> Xuất Excel (NS01)
        </a>
        <a href="@Url.Action("ExportExcelNS02", "NhanSu")" class="btn btn-success no-ajax" style="background-color: #27ae60; border-color: #27ae60;">
            <i class="bi bi-file-earmark-excel fw-bold"></i> Xuất Excel nhóm theo Chức vụ (NS02)
        </a>
        @if (PermissionHelper.HasPermission("NhanSu", LoaiPhanQuyen.Xoa))
        {
            <button type="button" class="btn btn-danger" style="background-color: #e74c3c; border-color: #e74c3c;" onclick="deleteSelectedNhanSu()">
                <i class="bi bi-trash"></i> Xóa
            </button>
        }
    </div>
</div>

<!-- Bộ lọc tìm kiếm theo chuẩn UI -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Index")" id="searchForm">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <input type="text" name="keyword" class="form-control" placeholder="Nhập tên, mã hoặc Số điện thoại..." value="@Request.QueryString["keyword"]">
                </div>
                <div class="col-md-3">
                    <select name="gender" class="form-select">
                        <option value="">-- Tất cả giới tính --</option>
                        <option value="true" @(Request.QueryString["gender"] == "true" ? "selected" : "")>Nam</option>
                        <option value="false" @(Request.QueryString["gender"] == "false" ? "selected" : "")>Nữ</option>
                    </select>
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn text-white px-3" style="background-color: #2998e4; border: none;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn text-white px-3 btn-reset" style="background-color: #f1c40f; border: none;">
                        Làm mới
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="table-container">
    @Html.Partial("_NhanSuList", Model)
</div>

@section Scripts {
    <script>
        (function() {
            var $pane = $('#searchForm').closest('.tab-pane');
            if ($pane.length === 0) $pane = $('body');

            // Check/Uncheck all checkboxes
            $pane.on('change', '#checkAll', function() {
                $pane.find('.row-checkbox').prop('checked', $(this).prop('checked'));
            });

            // If any row checkbox is unchecked, uncheck the header checkbox
            $pane.on('change', '.row-checkbox', function() {
                if ($pane.find('.row-checkbox:checked').length === $pane.find('.row-checkbox').length && $pane.find('.row-checkbox').length > 0) {
                    $pane.find('#checkAll').prop('checked', true);
                } else {
                    $pane.find('#checkAll').prop('checked', false);
                }
            });


            window.deleteSelectedNhanSu = function() {
                var selectedIds = [];
                $pane.find('.row-checkbox:checked').each(function() {
                    selectedIds.push($(this).val());
                });

                if (selectedIds.length === 0) {
                    showToast('warning', 'Vui lòng chọn ít nhất một nhân sự để thao tác.');
                    return;
                }

                var url = '@Url.Action("BatchDelete", "NhanSu")';
                var msg = "Bạn có chắc chắn muốn xóa " + selectedIds.length + " nhân sự đã chọn không?";
                
                confirmBatchDelete(url, selectedIds, msg);
            };
        })();
    </script>
}
