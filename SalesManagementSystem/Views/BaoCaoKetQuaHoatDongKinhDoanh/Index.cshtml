@model SalesManagementSystem.Models.ViewModels.BaoCaoKetQuaHoatDongKinhDoanhViewModel
@{
    ViewBag.Title = "BÁO CÁO KẾT QUẢ HOẠT ĐỘNG KINH DOANH";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold text-uppercase" style="color:#0b5b84;font-size:1.25rem;">
        @ViewBag.Title
    </h4>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form id="filterForm">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Thời gian</label>
                    <select class="form-select ddl-thoi-gian" id="ThoiGian">
                        <option value="current_month">Đầu tháng đến hiện tại</option>
                        <option value="month_1">Tháng 1</option>
                        <option value="month_2">Tháng 2</option>
                        <option value="month_3">Tháng 3</option>
                        <option value="month_4">Tháng 4</option>
                        <option value="month_5">Tháng 5</option>
                        <option value="month_6">Tháng 6</option>
                        <option value="month_7">Tháng 7</option>
                        <option value="month_8">Tháng 8</option>
                        <option value="month_9">Tháng 9</option>
                        <option value="month_10">Tháng 10</option>
                        <option value="month_11">Tháng 11</option>
                        <option value="month_12">Tháng 12</option>
                        <option value="quarter_1">Quý 1</option>
                        <option value="quarter_2">Quý 2</option>
                        <option value="quarter_3">Quý 3</option>
                        <option value="quarter_4">Quý 4</option>
                        <option value="current_year" selected="selected">Từ đầu năm đến hiện tại</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" class="form-control" name="TuNgay" id="TuNgay" value="@Model.Filter.TuNgay.Value.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" class="form-control" name="DenNgay" id="DenNgay" value="@Model.Filter.DenNgay.Value.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Kho hàng</label>
                    @Html.DropDownList("IDKho", ViewBag.KhoHangList as SelectList, "Tất cả", new { @class = "form-select", id = "IDKho" })
                </div>
                <div class="col-md-3">
                    <label class="form-label">Mã sản phẩm</label>
                    <input type="text" class="form-control" name="MaSanPham" id="MaSanPham" placeholder="Nhập mã SP..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tên sản phẩm</label>
                    <input type="text" class="form-control" name="TenSanPham" id="TenSanPham" placeholder="Nhập tên SP..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đơn vị tính</label>
                    <input type="text" class="form-control" name="DonViTinh" id="DonViTinh" placeholder="Nhập ĐVT..." />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="button" class="btn text-white me-2" style="background:#2998e4" id="btnSearch">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn text-white me-2" style="background:#f1c40f" id="btnReset">
                        Làm mới
                    </button>
                    <button type="button" class="btn btn-success" id="btnExcel">
                        <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="listContainer">
    <!-- Dữ liệu sẽ được load qua AJAX vào đây -->
</div>

<script>
    (function () {
        function getPane() {
            var $pane = $('#filterForm').last().closest('.tab-pane');
            return $pane.length ? $pane : $(document);
        }

        function fDate(y, m, d) {
            var sm = m < 10 ? '0' + m : m;
            var sd = d < 10 ? '0' + d : d;
            return y + '-' + sm + '-' + sd;
        }

        function getDays(y, m) {
            var days = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
            if (m === 2 && ((y % 4 === 0 && y % 100 !== 0) || y % 400 === 0)) return 29;
            return days[m];
        }

        function getThoiGianRange(val) {
            if (!val) return null;
            var now = new Date();
            var y = now.getFullYear();
            var s = '';
            var e = '';

            if (val === 'current_month') {
                var cm = now.getMonth() + 1;
                s = fDate(y, cm, 1);
                e = fDate(y, cm, now.getDate());
            } else if (val.indexOf('month_') === 0) {
                var m = parseInt(val.replace('month_', ''), 10);
                s = fDate(y, m, 1);
                e = fDate(y, m, getDays(y, m));
            } else if (val.indexOf('quarter_') === 0) {
                var q = parseInt(val.replace('quarter_', ''), 10);
                var startM = (q - 1) * 3 + 1;
                var endM = startM + 2;
                s = fDate(y, startM, 1);
                e = fDate(y, endM, getDays(y, endM));
            } else if (val === 'current_year') {
                s = fDate(y, 1, 1);
                e = fDate(y, now.getMonth() + 1, now.getDate());
            }
            return s && e ? { tuNgay: s, denNgay: e } : null;
        }

        function setDateInput($input, value) {
            var input = $input[0];
            if (input && input._flatpickr) {
                input._flatpickr.setDate(value);
            } else {
                $input.val(value);
            }
        }

        function applyThoiGian(val, shouldLoad) {
            var range = getThoiGianRange(val);
            if (!range) return;
            var $pane = getPane();
            $pane.find('#ThoiGian').val(val);
            setDateInput($pane.find('#TuNgay'), range.tuNgay);
            setDateInput($pane.find('#DenNgay'), range.denNgay);
            if (shouldLoad) {
                loadData();
            }
        }

        function syncThoiGian() {
            var $pane = getPane();
            var tuNgay = $pane.find('#TuNgay').val();
            var denNgay = $pane.find('#DenNgay').val();
            var matchedValue = '';

            $pane.find('#ThoiGian option').each(function () {
                var range = getThoiGianRange(this.value);
                if (range && range.tuNgay === tuNgay && range.denNgay === denNgay) {
                    matchedValue = this.value;
                    return false;
                }
            });
            $pane.find('#ThoiGian').val(matchedValue);
        }

        function loadData() {
            var $pane = getPane();
            var $form = $pane.find('#filterForm');
            if ($form.length === 0) $form = $('#filterForm').last();

            var $btn = $form.find('#btnSearch');
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang tải...');

            var $listContainer = $pane.find('#listContainer');
            if ($listContainer.length === 0) $listContainer = $('#listContainer').last();
            $listContainer.html('<div class="text-center p-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-muted">Đang tải dữ liệu...</div></div>');

            $.ajax({
                url: '@Url.Action("GetList", "BaoCaoKetQuaHoatDongKinhDoanh")',
                type: 'POST',
                data: $form.serialize(),
                success: function (res) {
                    if (typeof res === 'object' && res.success === false) {
                        $listContainer.html('<div class="alert alert-danger">Lỗi từ máy chủ: ' + (res.message || '') + '</div>');
                        if (typeof showToast === 'function') { showToast('error', res.message || 'Lỗi dữ liệu'); }
                    } else {
                        $listContainer.html(res);
                    }
                },
                error: function (xhr, status, error) {
                    $listContainer.html('<div class="alert alert-danger">Lỗi kết nối server: ' + error + '</div>');
                    if (typeof showToast === 'function') { showToast('error', 'Có lỗi xảy ra khi gọi server'); }
                },
                complete: function () {
                    $btn.prop('disabled', false).html('<i class="bi bi-search"></i> Tìm kiếm');
                }
            });
        }

        function initEvents() {
            var $pane = getPane();

            $pane.find('#filterForm').off('submit').on('submit', function (e) {
                e.preventDefault();
                loadData();
            });

            $pane.find('#btnSearch').off('click').on('click', function (e) {
                e.preventDefault();
                loadData();
            });

            $pane.find('#ThoiGian').off('change').on('change', function () {
                applyThoiGian($(this).val(), true);
            });

            $pane.find('#TuNgay, #DenNgay').off('change').on('change', function () {
                syncThoiGian();
            });

            $pane.find('#btnReset').off('click').on('click', function (e) {
                e.preventDefault();
                var $form = $pane.find('#filterForm');
                if ($form.length === 0) $form = $('#filterForm').last();

                $form.find('input[type="text"]').val('');
                $form.find('select').not('#ThoiGian').val('').trigger('change');
                applyThoiGian('current_year', true);
            });

            $pane.find('#btnExcel').off('click').on('click', function (e) {
                e.preventDefault();
                var url = '@Url.Action("ExportExcel", "BaoCaoKetQuaHoatDongKinhDoanh")?' + $pane.find('#filterForm').serialize();
                window.location.href = url;
            });

            syncThoiGian();
            loadData();
        }

        $(document).ready(function () {
            initEvents();
        });

        // Tự động khởi chạy khi được nạp qua SPA AJAX
        setTimeout(initEvents, 50);
    })();
</script>
