@{
    var salesDetails = ViewBag.SalesDetails as List<dynamic>;
    var purchaseDetails = ViewBag.PurchaseDetails as List<dynamic>;
}

<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0" style="border-radius: 8px;">
            <div class="modal-header text-white p-3" style="background: linear-gradient(135deg, #0b5b84, #1d82b8); border-top-left-radius: 8px; border-top-right-radius: 8px;">
                <h5 class="modal-title fw-bold text-uppercase" id="detailsModalLabel">
                    <i class="bi bi-info-circle-fill me-2"></i> Chi tiết đối chiếu dữ liệu sản phẩm
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Thông tin sản phẩm -->
                <div class="bg-light p-3 rounded mb-4 shadow-sm border-start border-4 border-info">
                    <div class="row text-center text-md-start">
                        <div class="col-md-4 mb-2 mb-md-0">
                            <span class="text-muted small d-block">Mã sản phẩm</span>
                            <strong class="text-dark" style="font-size: 1.1rem;">@ViewBag.MaSanPham</strong>
                        </div>
                        <div class="col-md-6 mb-2 mb-md-0">
                            <span class="text-muted small d-block">Tên sản phẩm</span>
                            <strong class="text-dark" style="font-size: 1.1rem;">@ViewBag.TenSanPham</strong>
                        </div>
                        <div class="col-md-2">
                            <span class="text-muted small d-block">Đơn vị tính</span>
                            <strong class="text-dark" style="font-size: 1.1rem;">@ViewBag.DVT</strong>
                        </div>
                    </div>
                </div>

                <!-- Nav tabs -->
                <ul class="nav nav-pills mb-3" id="detailsTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold text-uppercase px-4 shadow-sm" id="sales-tab" data-bs-toggle="tab" data-bs-target="#sales" type="button" role="tab" aria-controls="sales" aria-selected="true">
                            <i class="bi bi-cart-check-fill me-2"></i> Chi tiết Doanh thu bán hàng
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-uppercase px-4 shadow-sm" id="purchases-tab" data-bs-toggle="tab" data-bs-target="#purchases" type="button" role="tab" aria-controls="purchases" aria-selected="false">
                            <i class="bi bi-box-seam me-2"></i> Chi tiết Nhập kho (Giá vốn & Vận chuyển)
                        </button>
                    </li>
                </ul>

                <!-- Tab panes -->
                <div class="tab-content border p-3 rounded bg-white shadow-sm" style="min-height: 300px;">
                    <!-- Sales Tab -->
                    <div class="tab-pane fade show active" id="sales" role="tabpanel" aria-labelledby="sales-tab">
                        
                        @{
                            // Thống kê tỷ lệ khách hàng mua sản phẩm này
                            var customerStats = new List<dynamic>();
                            decimal totalSalesQty = 0;
                            if (salesDetails != null && salesDetails.Any())
                            {
                                totalSalesQty = salesDetails.Sum(x => (decimal)x.SoLuong);
                                customerStats = salesDetails
                                    .GroupBy(x => (string)(x.TenKhachHang ?? "Khách hàng lẻ"))
                                    .Select(g => new {
                                        CustomerName = g.Key,
                                        TotalQty = g.Sum(x => (decimal)x.SoLuong),
                                        TotalAmount = g.Sum(x => (decimal)x.ThanhTien),
                                        Ratio = totalSalesQty > 0 ? (g.Sum(x => (decimal)x.SoLuong) / totalSalesQty) * 100 : 0
                                    })
                                    .OrderByDescending(x => x.TotalQty)
                                    .Select(x => (dynamic)x)
                                    .ToList();
                            }
                        }

                        @if (customerStats.Any())
                        {
                            <div class="card border-0 mb-4 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold text-dark mb-3" style="font-size: 0.9rem;">
                                        <i class="bi bi-pie-chart-fill text-info me-2"></i>TỶ LỆ KHÁCH HÀNG MUA SẢN PHẨM NÀY
                                    </h6>
                                    <div class="row row-cols-1 row-cols-md-3 g-3">
                                        @foreach (var stat in customerStats)
                                        {
                                            <div class="col">
                                                <div class="bg-white p-3 rounded-3 shadow-sm border-start border-4 border-info h-100">
                                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                                        <span class="fw-bold text-dark text-truncate" style="max-width: 70%; font-size: 0.88rem;" title="@stat.CustomerName">@stat.CustomerName</span>
                                                        <span class="badge bg-info text-white rounded-pill px-2.5 py-1" style="font-size:0.75rem">@(((decimal)stat.Ratio).ToString("N1"))%</span>
                                                    </div>
                                                    <div class="progress my-2" style="height: 6px; border-radius: 3px; background-color: #f1f5f9;">
                                                        <div class="progress-bar bg-info" role="progressbar" style="width: @(stat.Ratio)%; border-radius: 3px;" aria-valuenow="@stat.Ratio" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <div class="d-flex justify-content-between text-muted small mt-1.5" style="font-size: 0.8rem;">
                                                        <span>Số lượng: <strong class="text-dark">@(((decimal)stat.TotalQty).ToString("N0"))</strong></span>
                                                        <span>Doanh thu: <strong class="text-success">@(((decimal)stat.TotalAmount).ToString("N0"))</strong></span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <h6 class="fw-bold mb-3 text-secondary text-uppercase border-bottom pb-2">Hóa đơn bán hàng phát sinh trong kỳ</h6>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover align-middle mb-0 text-center" style="font-size: 0.95rem;">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 60px;">STT</th>
                                        <th>Số chứng từ</th>
                                        <th>Ngày chứng từ</th>
                                        <th>Khách hàng</th>
                                        <th>Số lượng bán</th>
                                        <th>Đơn giá bán</th>
                                        <th>Thành tiền doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (salesDetails != null && salesDetails.Any())
                                    {
                                        int stt = 1;
                                        foreach (var s in salesDetails)
                                        {
                                            <tr>
                                                <td>@(stt++)</td>
                                                <td class="fw-bold text-primary">@s.SoChungTu</td>
                                                <td>@(((DateTime)s.NgayChungTu).ToString("dd/MM/yyyy"))</td>
                                                <td class="fw-semibold text-start">@(s.TenKhachHang ?? "Khách hàng lẻ")</td>
                                                <td class="text-end fw-bold text-dark">@(((decimal)s.SoLuong).ToString("N0"))</td>
                                                <td class="text-end">@(((decimal)s.DonGia).ToString("N0"))</td>
                                                <td class="text-end fw-bold text-success">@(((decimal)s.ThanhTien).ToString("N0"))</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted p-4">Không có hóa đơn phát sinh trong kỳ</td>
                                        </tr>
                                    }
                                </tbody>
                                @if (salesDetails != null && salesDetails.Any())
                                {
                                    <tfoot class="table-light fw-bold text-end">
                                        <tr>
                                            <td colspan="4" class="text-center text-uppercase">Tổng cộng:</td>
                                            <td class="text-success">@(((decimal)salesDetails.Sum(x => (decimal)x.SoLuong)).ToString("N0"))</td>
                                            <td></td>
                                            <td class="text-success">@(((decimal)salesDetails.Sum(x => (decimal)x.ThanhTien)).ToString("N0"))</td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>


                    <!-- Purchases Tab -->
                    <div class="tab-pane fade" id="purchases" role="tabpanel" aria-labelledby="purchases-tab">
                        <h6 class="fw-bold mb-3 text-secondary text-uppercase border-bottom pb-2">Phiếu nhập kho đầu vào (Được dùng để tính Bình quân gia quyền)</h6>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-info-circle me-1"></i> Giá vốn hàng bán và Chi phí vận chuyển được tính bằng phương pháp **Bình quân gia quyền di động** dựa trên toàn bộ các phiếu nhập kho đã ghi sổ dưới đây.
                        </p>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover align-middle mb-0 text-center" style="font-size: 0.95rem;">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 60px;">STT</th>
                                        <th>Số chứng từ</th>
                                        <th>Ngày nhập</th>
                                        <th>Số lượng nhập</th>
                                        <th>Đơn giá nhập</th>
                                        <th>Thành tiền hàng</th>
                                        <th>Đơn giá VC</th>
                                        <th>Thành tiền VC</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (purchaseDetails != null && purchaseDetails.Any())
                                    {
                                        int stt = 1;
                                        foreach (var p in purchaseDetails)
                                        {
                                            <tr>
                                                <td>@(stt++)</td>
                                                <td class="fw-bold text-success">@p.SoChungTu</td>
                                                <td>@(((DateTime)p.NgayNhap).ToString("dd/MM/yyyy"))</td>
                                                <td class="text-end fw-bold text-dark">@(((decimal)p.SoLuong).ToString("N0"))</td>
                                                <td class="text-end">@(((decimal)p.DonGia).ToString("N0"))</td>
                                                <td class="text-end fw-bold text-primary">@(((decimal)p.ThanhTienHang).ToString("N0"))</td>
                                                <td class="text-end text-warning">@(((decimal)p.DonGiaVanChuyen).ToString("N0"))</td>
                                                <td class="text-end fw-bold text-warning">@(((decimal)p.TienVanChuyen).ToString("N0"))</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted p-4">Không có phiếu nhập kho nào được ghi sổ trước thời điểm này</td>
                                        </tr>
                                    }
                                </tbody>
                                @if (purchaseDetails != null && purchaseDetails.Any())
                                {
                                    <tfoot class="table-light fw-bold text-end">
                                        <tr>
                                            <td colspan="3" class="text-center text-uppercase">Tổng cộng / Trung bình:</td>
                                            <td class="text-primary">@(((decimal)purchaseDetails.Sum(x => (decimal)x.SoLuong)).ToString("N0"))</td>
                                            <td class="text-primary">
                                                @{
                                                    var totalQty = purchaseDetails.Sum(x => (decimal)x.SoLuong);
                                                    var avgPrice = totalQty > 0 ? purchaseDetails.Sum(x => (decimal)x.SoLuong * (decimal)x.DonGia) / totalQty : 0;
                                                    @avgPrice.ToString("N2")
                                                }
                                            </td>
                                            <td class="text-primary">@(((decimal)purchaseDetails.Sum(x => (decimal)x.ThanhTienHang)).ToString("N0"))</td>
                                            <td class="text-warning">
                                                @{
                                                    var avgVc = totalQty > 0 ? purchaseDetails.Sum(x => (decimal)x.SoLuong * (decimal)x.DonGiaVanChuyen) / totalQty : 0;
                                                    @avgVc.ToString("N2")
                                                }
                                            </td>
                                            <td class="text-warning">@(((decimal)purchaseDetails.Sum(x => (decimal)x.TienVanChuyen)).ToString("N0"))</td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer p-3 bg-light" style="border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                <button type="button" class="btn btn-secondary text-white fw-bold px-4" data-bs-dismiss="modal" style="background-color: #6c757d; border: none; border-radius: 4px;">ĐÓNG</button>
            </div>
        </div>
    </div>
</div>
