@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.TaiKhoanThanhToanListViewModel>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height:350px;">
            <table id="tblTaiKhoanThanhToanList" class="table table-custom table-bordered table-hover mb-0" style="width:100%; min-width:1000px;">
                <thead>
                    <tr>
                        <th width="50" class="text-center fw-bold">Thao tác</th>
                        <th width="50" class="text-center fw-bold">STT</th>
                        <th width="120" class="text-center fw-bold">Mã tài khoản</th>
                        <th class="fw-bold">Tên tài khoản</th>
                        <th width="120" class="text-center fw-bold">Số tài khoản</th>
                        <th width="150" class="fw-bold">Ngân hàng</th>
                        <th width="150" class="fw-bold">Chủ tài khoản</th>
                        <th width="180" class="text-center fw-bold">Tài khoản kế toán</th>
                        <th width="110" class="text-center fw-bold">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border-0 shadow-none" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-grid-3x3-gap-fill text-muted"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow-sm">
                                            @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("TaiKhoanThanhToan", SalesManagementSystem.Helpers.LoaiPhanQuyen.CapNhat))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item py-2" onclick="openFormModal('@Url.Action("Edit", "TaiKhoanThanhToan", new { id = item.ID })')">
                                                        <i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật
                                                    </button>
                                                </li>
                                            }
                                            @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("TaiKhoanThanhToan", SalesManagementSystem.Helpers.LoaiPhanQuyen.Xoa))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item py-2 text-danger" onclick="confirmDelete('@Url.Action("Delete", "TaiKhoanThanhToan", new { id = item.ID })', 'Bạn có chắc chắn muốn xóa tài khoản thanh toán @item.MaTaiKhoan?')">
                                                        <i class="bi bi-trash-fill text-danger me-2"></i>Xóa
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="text-center align-middle fw-semibold text-primary">@item.MaTaiKhoan</td>
                                <td class="align-middle">@item.TenTaiKhoan</td>
                                <td class="text-center align-middle">@item.SoTaiKhoan</td>
                                <td class="align-middle">@item.NganHang</td>
                                <td class="align-middle">@item.ChuTaiKhoan</td>
                                <td class="text-center align-middle">@(string.IsNullOrEmpty(item.SoTaiKhoanKeToan) ? "" : $"{item.SoTaiKhoanKeToan} - {item.TenTaiKhoanKeToan}")</td>
                                <td class="text-center align-middle">
                                    @if (item.IsHoatDong)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">Ngừng</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không có dữ liệu
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @Html.Partial("_Pagination", Model)
</div>

<style>
    #tblTaiKhoanThanhToanList th {
        position: relative;
        background-clip: padding-box;
    }
    #tblTaiKhoanThanhToanList th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblTaiKhoanThanhToanList th .resizer:hover, #tblTaiKhoanThanhToanList th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var table = document.getElementById('tblTaiKhoanThanhToanList');
        if (!table) return;
        
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            // Skip for icon columns, checkbox columns and action columns
            if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
            if(th.innerText.trim() === 'Thao tác') return;
            
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                
                e.preventDefault();
            });
        });
    })();
</script>
