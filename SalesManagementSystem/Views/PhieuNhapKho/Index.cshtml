@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.PhieuNhapKhoListViewModel>
@{
    ViewBag.Title = "Quản lý Phiếu nhập kho";
    var uid = Guid.NewGuid().ToString("N");
}

<style>
    .pnk-row.active-row td {
        background-color: #e3f2fd !important;
    }
    .pnk-detail-row td {
        box-shadow: inset 0 3px 6px -3px rgba(0,0,0,0.1), inset 0 -3px 6px -3px rgba(0,0,0,0.1);
    }
</style>

<div id="pnk-@uid">
    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
        <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">
            <i class="bi bi-box-seam me-2"></i>@ViewBag.Title
        </h4>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm" style="background-color: #3498db; border-color: #3498db;">
                <i class="bi bi-plus-lg fw-bold me-1"></i> Thêm mới
            </a>
            <button type="button" class="btn btn-success btn-export-excel shadow-sm" style="background-color: #27ae60; border-color: #27ae60;">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
            </button>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <form id="searchForm" action="@Url.Action("GetList")" method="get">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Từ ngày</label>
                        <input type="date" name="tuNgay" class="form-control form-control-sm" value="@ViewBag.TuNgay" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Đến ngày</label>
                        <input type="date" name="denNgay" class="form-control form-control-sm" value="@ViewBag.DenNgay" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Số chứng từ</label>
                        <input type="text" name="soChungTu" class="form-control form-control-sm" placeholder="Nhập số phiếu..." value="@ViewBag.SoChungTu" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Kho nhập</label>
                        @Html.DropDownList("idKho", (SelectList)ViewBag.Khos, "-- Tất cả --", new { @class = "form-select form-select-sm ddlKho" })
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Nhà cung cấp</label>
                        @Html.DropDownList("idNhaCungCap", (SelectList)ViewBag.NhaCungCaps, "-- Tất cả --", new { @class = "form-select form-select-sm ddlNhaCungCap" })
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Người giao hàng</label>
                        <input type="text" name="tenNguoiGiao" class="form-control form-control-sm" placeholder="Nhập người giao..." value="@ViewBag.TenNguoiGiao" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Phương tiện</label>
                        @Html.DropDownList("idPhuongTien", (SelectList)ViewBag.PhuongTiens, "-- Tất cả --", new { @class = "form-select form-select-sm ddlPhuongTien" })
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Trạng thái</label>
                        <select name="trangThai" class="form-select form-select-sm">
                            <option value="">-- Tất cả --</option>
                            <option value="1" @(ViewBag.TrangThai == 1 ? "selected" : "")>Đề nghị ghi</option>
                            <option value="2" @(ViewBag.TrangThai == 2 ? "selected" : "")>Đã ghi</option>
                            <option value="3" @(ViewBag.TrangThai == 3 ? "selected" : "")>Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2 mt-3 justify-content-end">
                        <button type="submit" class="btn btn-sm text-white px-3" style="background-color: #2998e4; border: none;">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                        <button type="button" class="btn btn-sm text-white px-3 btn-reset" style="background-color: #f1c40f; border: none;">
                            Làm mới
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="table-container">
        @Html.Partial("_PhieuNhapKhoList", Model)
    </div>

    <div class="modal fade pnk-huy-modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content" style="border-top: 5px solid #ffc107;">
                <div class="modal-header">
                    <h5 class="modal-title text-dark"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Thông báo!</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" class="pnk-huy-id" />
                    <p>Bạn đang thực hiện Hủy phiếu nhập kho Đã ghi. Vui lòng nhập lý do:</p>
                    <textarea class="form-control pnk-txt-lydohuy" rows="3" placeholder="Nhập lý do hủy phiếu (Bắt buộc)"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn fw-bold text-white shadow-sm pnk-btn-confirm-huy" style="background-color: #ffc107; min-width: 100px;">ĐỒNG Ý</button>
                    <button type="button" class="btn fw-bold text-dark shadow-sm" style="background-color: #e2e8f0; min-width: 100px;" data-bs-dismiss="modal">ĐỂ SAU</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function() {
        var $container = $('#pnk-@uid');
        var $form = $container.find('#searchForm');
        var $ddlKho = $container.find('.ddlKho');
        var $ddlNhaCungCap = $container.find('.ddlNhaCungCap');

        $(document).ready(function() {
            $form.on('submit', function (e) {
                e.preventDefault();
                var params = $(this).serialize();
                var url = '@Url.Action("GetList")?' + params;
                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (res) {
                        $container.find('#table-container').html(res);
                    },
                    error: function () {
                        if (typeof showToast === 'function') {
                            showToast('error', 'Lỗi khi tải dữ liệu.');
                        }
                    }
                });
            });

            // Delegate row clicks for inline detail view
            $container.on('click', '.pnk-row', function (e) {
                if ($(e.target).closest('a, button, select, input, .dropdown, .dropdown-menu').length) {
                    return;
                }

                var $row = $(this);
                var id = $row.data('id');
                if (!id) return;

                var $nextRow = $row.next();
                var isAlreadyExpanded = $nextRow.hasClass('pnk-detail-row') && $nextRow.data('parent-id') == id;

                // Close any currently open detail rows
                $container.find('.pnk-detail-row').remove();
                $container.find('.pnk-row').removeClass('active-row');
                $container.find('.toggle-icon').removeClass('bi-caret-down-fill text-primary').addClass('bi-caret-right-fill text-muted');

                if (isAlreadyExpanded) {
                    return;
                }

                // Highlight active row
                $row.addClass('active-row');
                $row.find('.toggle-icon').removeClass('bi-caret-right-fill text-muted').addClass('bi-caret-down-fill text-primary');

                // Create placeholder detail row
                var $detailRow = $('<tr class="pnk-detail-row" data-parent-id="' + id + '">' +
                    '<td colspan="15" class="p-3" style="background-color: #fcfdfd; border-left: 4px solid #2998e4;">' +
                    '   <div class="text-center p-4 text-muted">' +
                    '       <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>' +
                    '       Đang tải chi tiết...' +
                    '   </div>' +
                    '</td>' +
                    '</tr>');

                $row.after($detailRow);

                // Load view content via AJAX
                $.ajax({
                    url: '@Url.Action("GetDetailInline", "PhieuNhapKho")',
                    type: 'GET',
                    data: { id: id },
                    success: function (html) {
                        $detailRow.find('td').html(html);
                    },
                    error: function () {
                        $detailRow.find('td').html('<div class="text-danger text-center p-3"><i class="bi bi-exclamation-triangle-fill me-2"></i> Lỗi khi tải thông tin chi tiết.</div>');
                    }
                });
            });
        });

        $container.find('.btn-reset').on('click', function() {
            $form[0].reset();
            $form.trigger('submit');
        });

        $container.find('.btn-export-excel').on('click', function() {
            var params = $form.serialize();
            window.location.href = '@Url.Action("ExportExcel")?' + params;
        });

        // Publish functions to global scope but tied to this container (for onclick handlers like ghiSoPhieu)
        // A better approach is to use event delegation inside container.
        window.ghiSoPhieu = function(id) {
            showConfirm('Bạn có chắc chắn muốn ghi phiếu nhập kho này?', function() {
                $.post('@Url.Action("GhiSo")', { id: id }, function (res) {
                    if (res.success) {
                        if (typeof showToast === 'function') showToast('success', res.message);
                        $form.trigger('submit');
                    } else {
                        if (typeof showToast === 'function') showToast('error', res.message);
                    }
                });
            });
        };
        $container.find('.pnk-btn-confirm-huy').on('click', function() {
            var id = $container.find('.pnk-huy-id').val();
            var lyDo = $container.find('.pnk-txt-lydohuy').val().trim();
            if (!lyDo) { 
                showToast('warning', 'Vui lòng nhập lý do hủy!'); 
                return; 
            }

            $.post('@Url.Action("HuyPhieu")', { id: id, lyDoHuy: lyDo }, function (res) {
                if (res.success) { 
                    showToast('success', 'Hủy phiếu thành công'); 
                    $container.find('.pnk-huy-modal').modal('hide');
                    // Trigger reload in active tab using TabManager
                    if (typeof TabManager !== 'undefined') TabManager.reloadActiveTabGrid(false);
                } else {
                    showToast('error', res.message);
                }
            });
        });
    })();

    // These functions must be global and stateless to avoid tab closure overwrites.
    function getPnkContainer(btn) {
        return $(btn).closest('[id^="pnk-"]');
    }

    window.ghiSoPhieu = function(btn, id) {
        var $form = getPnkContainer(btn).find('#searchForm');
        showConfirm('Bạn có chắc chắn muốn ghi dữ liệu phiếu nhập kho này?', function() {
            $.post('@Url.Action("GhiSo")', { id: id }, function (res) {
                if (res.success) {
                    if (typeof showToast === 'function') showToast('success', res.message);
                    $form.trigger('submit');
                } else {
                    if (typeof showToast === 'function') showToast('error', res.message);
                }
            });
        });
    };

    window.deleteItem = function(btn, id) {
        var $form = getPnkContainer(btn).find('#searchForm');
        showConfirm('Bạn có chắc chắn muốn xóa phiếu nhập nháp này?', function() {
            $.post('@Url.Action("Delete")', { id: id }, function (res) {
                if (res.success) { 
                    showToast('success', 'Xóa thành công'); 
                    $form.trigger('submit');
                } else {
                    showToast('error', res.message);
                }
            });
        });
    };

    window.moHuyPhieu = function(btn, id) {
        var $container = getPnkContainer(btn);
        $container.find('.pnk-huy-id').val(id);
        $container.find('.pnk-txt-lydohuy').val('');
        $container.find('.pnk-huy-modal').modal('show');
    };
</script>
}
