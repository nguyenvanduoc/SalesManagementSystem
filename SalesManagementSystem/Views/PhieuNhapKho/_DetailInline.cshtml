@model SalesManagementSystem.Models.ViewModels.PhieuNhapKhoViewModel

<div class="table-responsive">
    <table class="table table-custom table-bordered table-hover align-middle mb-0">
        <thead>
            <tr>
                <th class="text-center" style="width:40px;">STT</th>
                <th class="text-start">Sản phẩm</th>
                <th class="text-center" style="width:70px;">ĐVT</th>
                <th class="text-end" style="width:90px;">Số lượng</th>
                <th class="text-end" style="width:110px;">Đơn giá</th>
                <th class="text-center" style="width:120px;">Ngày sản xuất</th>
                <th class="text-center" style="width:120px;">Hạn sử dụng</th>
                <th class="text-end" style="width:120px;">Thành tiền</th>
                <th class="text-end" style="width:120px;">Tổng cộng</th>
                <th class="text-start">Ghi chú</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ChiTiets != null && Model.ChiTiets.Any())
            {
                int stt = 1;
                foreach (var item in Model.ChiTiets)
                {
                    <tr>
                        <td class="text-center">@(stt++)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.MaSanPham))
                            {
                                <span>@item.MaSanPham - @item.TenSanPham</span>
                            }
                            else
                            {
                                <span>@item.TenSanPham</span>
                            }
                        </td>
                        <td class="text-center">@item.DVT</td>
                        <td class="text-end">@(item.SoLuong > 0 ? item.SoLuong.ToString("N0") : "0")</td>
                        <td class="text-end">@(item.DonGia > 0 ? item.DonGia.ToString("N0") : "0")</td>
                        <td class="text-center">@(item.NgaySanXuat.HasValue ? item.NgaySanXuat.Value.ToString("dd/MM/yyyy") : "")</td>
                        <td class="text-center">@(item.HanSuDung.HasValue ? item.HanSuDung.Value.ToString("dd/MM/yyyy") : "")</td>
                        <td class="text-end">@(item.ThanhTien > 0 ? item.ThanhTien.ToString("N0") : "0")</td>
                        <td class="text-end">@(item.TongSauThue > 0 ? item.TongSauThue.ToString("N0") : "0")</td>
                        <td>@item.GhiChu</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center py-4 text-muted">Không có dữ liệu chi tiết hàng hóa</td>
                </tr>
            }
        </tbody>
        @if (Model.ChiTiets != null && Model.ChiTiets.Any())
        {
            <tfoot style="background-color: #f8f9fa;">
                <tr class="fw-bold">
                    <td colspan="3" class="text-end">Tổng cộng</td>
                    <td class="text-end">@(Model.ChiTiets.Sum(x => x.SoLuong).ToString("N0"))</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td class="text-end">@(Model.ChiTiets.Sum(x => x.ThanhTien).ToString("N0"))</td>
                    <td class="text-end">@(Model.ChiTiets.Sum(x => x.TongSauThue).ToString("N0"))</td>
                    <td></td>
                </tr>
            </tfoot>
        }
    </table>
</div>
