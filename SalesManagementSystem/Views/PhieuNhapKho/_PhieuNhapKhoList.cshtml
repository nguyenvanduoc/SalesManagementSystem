@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.PhieuNhapKhoListViewModel>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height: 350px;">
            <table id="tblPhieuNhapKho" class="table table-custom table-bordered table-hover align-middle mb-0" style="width:100%; min-width:1350px;">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 35px;"></th>
                        <th class="text-center" style="width: 60px;">Thao tác</th>
                        <th class="text-center" style="width: 50px;">STT</th>
                        <th>Số chứng từ</th>
                        <th class="text-center">Ngày nhập</th>
                        <th>Kho nhập</th>
                        <th>Nhà cung cấp</th>
                        <th>Người nhận</th>
                        <th>Phương tiện</th>
                        <th class="text-end">Số lượng</th>
                        <th class="text-end d-none">Tiền thuế</th>
                        <th class="text-end">Tổng cộng</th>
                        <th>Người tạo</th>
                        <th class="text-center">Ngày tạo</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr class="pnk-row" data-id="@item.ID" style="cursor: pointer;">
                                <td class="text-center align-middle">
                                    <i class="bi bi-caret-right-fill text-muted toggle-icon" style="font-size: 0.95rem;"></i>
                                </td>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 6px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>
                                            <li><hr class="dropdown-divider"></li>
                                            @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("PhieuNhapKho", SalesManagementSystem.Helpers.LoaiPhanQuyen.Xem))
                                            {
                                                <li>
                                                    <a href="@Url.Action("Edit", "PhieuNhapKho", new { id = item.ID, isView = true })" class="dropdown-item">
                                                        <i class="bi bi-eye me-2 text-info"></i> Xem chi tiết
                                                    </a>
                                                </li>
                                            }
                                            @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("PhieuNhapKho", SalesManagementSystem.Helpers.LoaiPhanQuyen.Them))
                                            {
                                                <li>
                                                    <a href="@Url.Action("Copy", "PhieuNhapKho", new { id = item.ID })" class="dropdown-item">
                                                        <i class="bi bi-files me-2 text-secondary"></i> Sao chép
                                                    </a>
                                                </li>
                                            }
                                            @if (item.TrangThai == 1 && SalesManagementSystem.Helpers.PermissionHelper.HasPermission("PhieuNhapKho", SalesManagementSystem.Helpers.LoaiPhanQuyen.CapNhat))
                                            {
                                                <li>
                                                    <a href="@Url.Action("Edit", "PhieuNhapKho", new { id = item.ID })" class="dropdown-item">
                                                        <i class="bi bi-pencil-square me-2 text-primary"></i> Sửa
                                                    </a>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item text-success" onclick="ghiSoPhieu(this, @item.ID)">
                                                        <i class="bi bi-check-circle me-2 text-success"></i> Ghi dữ liệu
                                                    </button>
                                                </li>
                                            }
                                            
                                            @if (item.TrangThai == 2 && SalesManagementSystem.Helpers.PermissionHelper.HasPermission("PhieuNhapKho", SalesManagementSystem.Helpers.LoaiPhanQuyen.TuyChon))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-warning" onclick="moHuyPhieu(this, @item.ID)">
                                                        <i class="bi bi-x-circle me-2 text-warning"></i> Hủy phiếu
                                                    </button>
                                                </li>
                                            }
                                            
                                            @if (item.TrangThai == 1 && SalesManagementSystem.Helpers.PermissionHelper.HasPermission("PhieuNhapKho", SalesManagementSystem.Helpers.LoaiPhanQuyen.Xoa))
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger" onclick="deleteItem(this, @item.ID)">
                                                        <i class="bi bi-trash-fill me-2 text-danger"></i> Xóa
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="align-middle">@item.SoChungTu</td>
                                <td class="text-center align-middle">@(item.NgayNhap.ToString("dd/MM/yyyy"))</td>
                                <td class="align-middle">@item.TenKho</td>
                                <td class="align-middle">@item.TenNhaCungCap</td>
                                <td class="align-middle">@item.TenNguoiNhan</td>
                                <td class="align-middle">@item.TenPhuongTien</td>
                                <td class="text-end align-middle">@(item.TongSoLuong.ToString("N0"))</td>
                                <td class="text-end align-middle d-none">@(item.TongTienThue.ToString("N0"))</td>
                                <td class="text-end align-middle">
                                    @item.TongCong.ToString("N0")
                                </td>
                                <td class="align-middle">@item.NguoiTaoText</td>
                                <td class="text-center align-middle">
                                    @(item.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "")
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.TrangThai == 1)
                                    {
                                        <span class="badge bg-secondary" style="font-size: 0.8rem; padding: 5px 8px;">Đề nghị ghi</span>
                                    }
                                    else if (item.TrangThai == 2)
                                    {
                                        if (item.TrangThaiThanhToan == 1)
                                        {
                                            <span class="badge bg-warning text-dark" style="font-size: 0.8rem; padding: 5px 8px;">Thanh toán một phần</span>
                                        }
                                        else if (item.TrangThaiThanhToan == 2)
                                        {
                                            <span class="badge bg-success" style="font-size: 0.8rem; padding: 5px 8px;">Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger" style="font-size: 0.8rem; padding: 5px 8px;">Chưa thanh toán</span>
                                        }
                                    }
                                    else if (item.TrangThai == 3)
                                    {
                                        <span class="badge bg-danger" style="font-size: 0.8rem; padding: 5px 8px;">Đã hủy</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="15" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không có dữ liệu
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    <tfoot>
                        <tr class="fw-bold" style="background-color: #f8f9fa;">
                            <td colspan="9" class="text-end">Tổng cộng</td>
                            <td class="text-end">@(Model.Items.Sum(x => x.TongSoLuong).ToString("N0"))</td>
                            <td class="text-end d-none">@(Model.Items.Sum(x => x.TongTienThue).ToString("N0"))</td>
                            <td class="text-end" style="color: #1a5276; font-size: 1.1em;">@(Model.Items.Sum(x => x.TongCong).ToString("N0"))</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
    
    @Html.Partial("_Pagination", Model)
</div>

<style>
    #tblPhieuNhapKho th {
        position: relative;
        background-clip: padding-box;
    }
    #tblPhieuNhapKho th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblPhieuNhapKho th .resizer:hover, #tblPhieuNhapKho th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var table = document.getElementById('tblPhieuNhapKho');
        if (!table) return;
        
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            // Không áp dụng cho cột mở rộng và thao tác
            if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '60px' || th.style.width === '50px')) return;
            if(th.innerText.trim() === 'Thao tác') return;
            
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                
                e.preventDefault();
            });
        });
    })();
</script>
