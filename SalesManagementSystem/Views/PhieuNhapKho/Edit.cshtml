@model SalesManagementSystem.Models.ViewModels.PhieuNhapKhoViewModel
@using System.Linq
@{
    ViewBag.Title = Model.ID == 0 ? "Thêm mới Phiếu nhập kho" : "Cập nhật Phiếu nhập kho";
    var isView = ViewBag.IsView != null ? (bool)ViewBag.IsView : Model.IsReadOnly;
    string chiTietsJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChiTiets);
}

<style>
    .don-header-card { background:#fff; border:1px solid #dce4ec; border-radius:6px; padding:16px; margin-bottom:12px; box-shadow:0 1px 4px rgba(0,0,0,.06); }
    .don-section-title { font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:#7f8c8d; margin-bottom:10px; }
    .tong-tien-box { background:linear-gradient(135deg,#1a5276,#2980b9); border-radius:8px; padding:16px 20px; color:#fff; text-align:right; }
    .tong-tien-box .label { font-size:.8rem; opacity:.85; margin-bottom:4px; }
    .tong-tien-box .amount { font-size:1.8rem; font-weight:800; letter-spacing:.5px; }
    .grid-detail thead th { background:#f4f6f9; font-size:.8rem; font-weight:700; color:#2c3e50; vertical-align:middle; white-space:nowrap; text-align:center !important; }
    .grid-detail tbody td { vertical-align:middle; padding:5px 6px; }
    .grid-detail input.form-control, .grid-detail select.form-select { font-size:.85rem; padding:3px 7px; height:30px; }
    .btn-add-row { background:#2ecc71; color:#fff; border:none; border-radius:4px; padding:5px 14px; font-size:.85rem; }
    .btn-add-row:hover { background:#27ae60; color:#fff; }
    .readonly-cell { background:#f8f9fa; font-size:.85rem; color:#495057; border: 1px solid #ced4da; }
    .form-toolbar { background:#f8f9fa; border:1px solid #dce4ec; border-radius:6px; padding:10px 16px; margin-bottom:12px; display:flex; gap:8px; align-items:center; }
    .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #ced4da; border-radius: 0.375rem; }
    .select2-container--default .select2-selection--single .select2-selection__rendered { font-size: .85rem; color: #495057; line-height: 36px; padding-left: 12px; }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
</style>

@{ string containerId = "pnk_edit_" + Guid.NewGuid().ToString("N"); }

<div id="@containerId">
@if (ViewBag.IsInlineDetail != true)
{
    <!-- Toolbar -->
    <div class="form-toolbar mt-3">
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        @if (!isView)
        {
            <button type="button" id="btnSaveDraft" class="btn btn-sm btn-secondary me-1">
                <i class="bi bi-file-earmark-text me-1"></i> Lưu nháp
            </button>
            <button type="button" id="btnSavePhieu" class="btn btn-sm text-white" style="background-color:#2998e4;border:none;">
                <i class="bi bi-save me-1"></i> Lưu phiếu nhập
            </button>
        }
        @if (!isView)
        {
            <button type="button" id="btnGhiDuLieu" class="btn btn-sm btn-success" onclick="LuuVaGhiNow(this)" style="@((Model.TrangThai == 0 || Model.TrangThai == 1) ? "" : "display:none;")">
                <i class="bi bi-check-circle me-1"></i> Lưu và ghi
            </button>
        }
        <span class="text-muted small ms-auto fw-bold">
            <i class="bi bi-box-arrow-in-right me-1"></i> @(isView ? "XEM CHI TIẾT PHIẾU NHẬP KHO" : ViewBag.Title)
        </span>
    </div>
}

<form id="frmPhieuNhapKho" autocomplete="off">
    <input type="hidden" id="ID" value="@Model.ID" />
    
    <div class="row g-3">
        <!-- Nội dung chính -->
        <div class="col-md-12">

            @if (ViewBag.IsInlineDetail != true)
            {
                <!-- Card: Thông tin đối tác -->
                <div class="don-header-card">
                    <div class="don-section-title"><i class="bi bi-building me-1"></i>Thông tin đối tác & Kho</div>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Loại nhập kho <span class="text-danger">*</span></label>
                            <select id="IDLoaiNhapKho_@containerId" class="sel-IDLoaiNhapKho form-control" style="width:100%;" @(isView ? "disabled" : "")><option value=""></option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Kho nhập <span class="text-danger">*</span></label>
                            <select id="IDKho_@containerId" class="sel-IDKho form-control" style="width:100%;" @(isView ? "disabled" : "")><option value=""></option></select>
                        </div>
                        <div class="col-md-3" id="colKhoNguon" style="display:none;">
                            <label class="form-label text-muted fw-semibold small">Kho xuất <span class="text-danger">*</span></label>
                            <select id="IDKhoNguon_@containerId" class="sel-IDKhoNguon form-control" style="width:100%;" @(isView ? "disabled" : "")><option value=""></option></select>
                        </div>
                        <div class="col-md-3" id="colKhachHang" style="display:none;">
                            <label class="form-label text-muted fw-semibold small">Khách hàng <span class="text-danger">*</span></label>
                            <select id="IDKhachHang_@containerId" class="sel-IDKhachHang form-control" style="width:100%;" @(isView ? "disabled" : "")><option value=""></option></select>
                        </div>
                        <div class="col-md-3" id="colNhaCungCap">
                            <label class="form-label text-muted fw-semibold small">Nhà cung cấp <span class="text-danger">*</span></label>
                            <select id="IDNhaCungCap_@containerId" class="sel-IDNhaCungCap form-control" style="width:100%;" @(isView ? "disabled" : "")><option value=""></option></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-semibold small">Người nhận</label>
                            <input type="text" id="TenNguoiNhan" class="form-control form-control-sm" value="@Model.TenNguoiNhan" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-semibold small">Người giao hàng</label>
                            <input type="text" id="TenNguoiGiao" class="form-control form-control-sm" value="@Model.TenNguoiGiao" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-semibold small">SĐT người giao</label>
                            <input type="text" id="SoDienThoaiNguoiGiao" class="form-control form-control-sm" value="@Model.SoDienThoaiNguoiGiao" @(isView ? "disabled" : "") />
                        </div>
                    </div>
                </div>

                <!-- Card: Thông tin vận chuyển -->
                <div class="don-header-card">
                    <div class="don-section-title"><i class="bi bi-truck me-1"></i>Thông tin vận chuyển</div>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Phương tiện</label>
                            <select id="IDPhuongTien_@containerId" class="sel-IDPhuongTien form-control" style="width:100%;" @(isView ? "disabled" : "")><option value=""></option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Ngày giao hàng</label>
                            <input type="date" id="NgayGiaoHang" class="form-control form-control-sm" value="@(Model.NgayGiaoHang?.ToString("yyyy-MM-dd"))" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Tài xế</label>
                            <input type="text" id="HoTenTaiXe" class="form-control form-control-sm" value="@Model.HoTenTaiXe" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">SĐT Tài xế</label>
                            <input type="text" id="SoDienThoaiTaiXe" class="form-control form-control-sm" value="@Model.SoDienThoaiTaiXe" @(isView ? "disabled" : "") />
                        </div>
                    </div>
                </div>

                <!-- Card: Thông tin chứng từ -->
                <div class="don-header-card">
                    <div class="don-section-title"><i class="bi bi-file-earmark-text me-1"></i>Thông tin chứng từ</div>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Số chứng từ <span class="text-danger">*</span></label>
                            <input type="text" id="SoChungTu" class="form-control form-control-sm readonly-cell fw-bold text-primary" value="@Model.SoChungTu" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Ngày nhập <span class="text-danger">*</span></label>
                            <input type="date" id="NgayNhap" class="form-control form-control-sm" value="@Model.NgayNhap.ToString("yyyy-MM-dd")" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Số hóa đơn</label>
                            <input type="text" id="SoHoaDon" class="form-control form-control-sm" value="@Model.SoHoaDon" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Ngày hóa đơn</label>
                            <input type="date" id="NgayHoaDon" class="form-control form-control-sm" value="@(Model.NgayHoaDon?.ToString("yyyy-MM-dd"))" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-muted fw-semibold small">Ghi chú</label>
                            <textarea id="GhiChu" class="form-control form-control-sm" rows="1" @(isView ? "disabled" : "") placeholder="Nhập ghi chú...">@Model.GhiChu</textarea>
                        </div>
                    </div>
                </div>
            }

            <!-- Card: Grid chi tiết sản phẩm -->
            <div class="@(ViewBag.IsInlineDetail == true ? "" : "don-header-card mb-0")">
                @if (ViewBag.IsInlineDetail != true)
                {
                    <div class="d-flex align-items-center mb-2 gap-2">
                        <div class="don-section-title mb-0"><i class="bi bi-table me-1"></i>Chi tiết hàng hóa</div>
                        @if (!isView)
                        {
                            <button type="button" class="btn-add-row ms-auto" id="PNK_btnAddRow">
                                <i class="bi bi-plus-lg me-1"></i> Thêm mặt hàng
                            </button>
                        }
                    </div>
                }
                <div class="table-responsive">
                    <table class="table @(ViewBag.IsInlineDetail == true ? "table-hover align-middle table-borderless" : "table-bordered") grid-detail mb-0" id="PNK_tblChiTiet" style="min-width:900px;">
                        <thead>
                            <tr>
                                <th style="width:40px;">STT</th>
                                <th style="min-width:220px;" class="text-start">Sản phẩm</th>
                                <th style="width:70px;">ĐVT</th>
                                <th style="width:90px;">Số lượng</th>
                                <th style="width:110px;">Đơn giá</th>
                                <th style="width:120px;">Ngày sản xuất</th>
                                <th style="width:120px;">Hạn sử dụng</th>
                                <th style="width:120px;">Thành tiền</th>
                                <th style="width:110px;">Đơn giá VC</th>
                                <th style="width:110px;">Tiền VC</th>
                                <th style="width:70px;" class="d-none">Thuế %</th>
                                <th style="width:110px;" class="d-none">Tiền thuế</th>
                                <th style="width:120px;">Tổng cộng</th>
                                <th style="min-width:120px;">Ghi chú</th>
                                @if (!isView) { <th style="width:40px;"></th> }
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Rendered by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Card: Tổng tiền -->
            <div class="@(ViewBag.IsInlineDetail == true ? "py-3 px-2 border-top mt-1" : "don-header-card mt-3 mb-0")">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small me-2">Trạng thái:</span>
                        @if (Model.TrangThai == 1) 
                        { 
                            if (Model.TrangThaiThanhToan == 1)
                            {
                                <span class="badge bg-secondary" id="badgeTrangThai">Đề nghị ghi (thanh toán một phần)</span> 
                            }
                            else if (Model.TrangThaiThanhToan == 2)
                            {
                                <span class="badge bg-secondary" id="badgeTrangThai">Đề nghị ghi (đã thanh toán)</span> 
                            }
                            else
                            {
                                <span class="badge bg-secondary" id="badgeTrangThai">Đề nghị ghi</span> 
                            }
                        }
                        else if (Model.TrangThai == 2) { <span class="badge bg-success" id="badgeTrangThai">Đã ghi</span> }
                        else if (Model.TrangThai == 3) { <span class="badge bg-danger" id="badgeTrangThai">Đã hủy</span> }
                        else { <span class="badge bg-secondary" id="badgeTrangThai">Thêm mới</span> }
                    </div>
                    
                    <div class="d-flex align-items-center gap-3">
                        <div>
                            <span class="text-muted small me-1">Tổng số lượng:</span>
                            <span class="fs-6 text-dark" id="dispTongSoLuong">@(Model.ChiTiets != null ? Model.ChiTiets.Sum(c => c.SoLuong).ToString("N0") : "0")</span>
                        </div>
                        <div>
                            <span class="text-muted small me-1">Cộng tiền hàng:</span>
                            <span class="fs-6 text-dark" id="dispTongTienHang">0</span>
                        </div>
                        <div>
                            <span class="text-muted small me-1">Tiền vận chuyển:</span>
                            <span class="fs-6 text-dark" id="dispTienVanChuyen">0</span>
                        </div>
                        <div class="d-none">
                            <span class="text-muted small me-1">Tiền thuế GTGT:</span>
                            <span class="fs-6 text-dark" id="dispTongTienThue">0</span>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted text-uppercase fw-bold">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold" style="color:#1a5276;" id="dispTongCong">0</span>
                        <span class="text-muted small">VNĐ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
</div>

@if (ViewBag.IsInlineDetail == true)
{
    <script>
        var isViewMode = @(isView.ToString().ToLower());

        $(document).ready(function () {
            $.getScript('@Url.Content("~/Scripts/phieu-nhap-kho.js?v=3.1")', function() {
                var pnk = new window.PhieuNhapKhoClass({
                containerSelector: '#@containerId',
                searchLoaiNhapKhoUrl: '@Url.Action("SearchLoaiNhapKho")',
                searchKhachHangUrl: '@Url.Action("SearchKhachHang")',
                searchKhoUrl: '@Url.Action("SearchKhoHang")',
                searchNccUrl: '@Url.Action("SearchNhaCungCap")',
                searchSpUrl: '@Url.Action("SearchSanPham")',
                searchPhuongTienUrl: '@Url.Action("SearchPhuongTien")',
                chiTietsJson: @Html.Raw(chiTietsJson),
                selectedLoaiNhapKhoId: @(Model.IDLoaiNhapKho.HasValue && Model.IDLoaiNhapKho.Value > 0 ? Model.IDLoaiNhapKho.Value.ToString() : "null"),
                selectedLoaiNhapKhoMa: '@Html.Raw(Model.MaLoaiNhap)',
                selectedLoaiNhapKhoText: '@Html.Raw(Model.TenLoaiNhap)',
                selectedKhoNguonId: @(Model.IDKhoNguon.HasValue && Model.IDKhoNguon.Value > 0 ? Model.IDKhoNguon.Value.ToString() : "null"),
                selectedKhoNguonText: '@Html.Raw(Model.TenKhoNguon)',
                selectedKhachHangId: @(Model.IDKhachHang.HasValue && Model.IDKhachHang.Value > 0 ? Model.IDKhachHang.Value.ToString() : "null"),
                selectedKhachHangText: '@Html.Raw(Model.TenKhachHang)',
                selectedKhoId: @(Model.IDKho.HasValue && Model.IDKho.Value > 0 ? Model.IDKho.Value.ToString() : "null"),
                selectedKhoText: '@Html.Raw(Model.TenKho)',
                selectedNccId: @(Model.IDNhaCungCap.HasValue && Model.IDNhaCungCap.Value > 0 ? Model.IDNhaCungCap.Value.ToString() : "null"),
                selectedNccText: '@Html.Raw(Model.TenNhaCungCap)',
                selectedPhuongTienId: @(Model.IDPhuongTien.HasValue && Model.IDPhuongTien.Value > 0 ? Model.IDPhuongTien.Value.ToString() : "null"),
                selectedPhuongTienText: '@Html.Raw(Model.TenPhuongTien)',
                isViewMode: isViewMode,
                isInlineDetail: true
            });
            pnk.init();
            $('#@containerId').data('pnkInstance', pnk);

                if (isViewMode) {
                    $('.sel-sanpham, .txt-soluong, .txt-dongia, .txt-thue, .txt-ghichu, .txt-ngaysanxuat, .txt-hansudung, .txt-dongiavanchuyen').prop('disabled', true).addClass('readonly-cell');
                    $('.btn-remove-row, #btnAddRow, #btnSavePhieu').hide();
                }
            });
        });
    </script>
    <style>
        .readonly-cell { background-color: #e9ecef !important; border: 1px solid #ced4da; }
        .grid-detail { border-collapse: collapse !important; width: 100% !important; border: none !important; }
        .grid-detail thead th { background-color: #f3f4f6 !important; border-bottom: 2px solid #e5e7eb !important; border-top: none !important; font-size: 0.85rem !important; padding: 10px 8px !important; color: #374151 !important; }
        .grid-detail tbody tr { border-bottom: 1px solid #f3f4f6 !important; }
        .grid-detail tbody td { padding: 10px 12px !important; font-size: 0.85rem !important; color: #4b5563 !important; border-top: none !important; border-left: none !important; border-right: none !important; }
    </style>
}
else
{
    @section Scripts {
    <script src="@Url.Content("~/Scripts/phieu-nhap-kho.js?v=3.1")"></script>
    <script>
        var isViewMode = @(isView.ToString().ToLower());

        $(document).ready(function () {
            var pnk = new window.PhieuNhapKhoClass({
                containerSelector: '#@containerId',
                searchLoaiNhapKhoUrl: '@Url.Action("SearchLoaiNhapKho")',
                searchKhachHangUrl: '@Url.Action("SearchKhachHang")',
                searchKhoUrl: '@Url.Action("SearchKhoHang")',
                searchNccUrl: '@Url.Action("SearchNhaCungCap")',
                searchSpUrl: '@Url.Action("SearchSanPham")',
                searchPhuongTienUrl: '@Url.Action("SearchPhuongTien")',
                chiTietsJson: @Html.Raw(chiTietsJson),
                selectedLoaiNhapKhoId: @(Model.IDLoaiNhapKho.HasValue && Model.IDLoaiNhapKho.Value > 0 ? Model.IDLoaiNhapKho.Value.ToString() : "null"),
                selectedLoaiNhapKhoMa: '@Html.Raw(Model.MaLoaiNhap)',
                selectedLoaiNhapKhoText: '@Html.Raw(Model.TenLoaiNhap)',
                selectedKhoNguonId: @(Model.IDKhoNguon.HasValue && Model.IDKhoNguon.Value > 0 ? Model.IDKhoNguon.Value.ToString() : "null"),
                selectedKhoNguonText: '@Html.Raw(Model.TenKhoNguon)',
                selectedKhachHangId: @(Model.IDKhachHang.HasValue && Model.IDKhachHang.Value > 0 ? Model.IDKhachHang.Value.ToString() : "null"),
                selectedKhachHangText: '@Html.Raw(Model.TenKhachHang)',
                selectedKhoId: @(Model.IDKho.HasValue && Model.IDKho.Value > 0 ? Model.IDKho.Value.ToString() : "null"),
                selectedKhoText: '@Html.Raw(Model.TenKho)',
                selectedNccId: @(Model.IDNhaCungCap.HasValue && Model.IDNhaCungCap.Value > 0 ? Model.IDNhaCungCap.Value.ToString() : "null"),
                selectedNccText: '@Html.Raw(Model.TenNhaCungCap)',
                selectedPhuongTienId: @(Model.IDPhuongTien.HasValue && Model.IDPhuongTien.Value > 0 ? Model.IDPhuongTien.Value.ToString() : "null"),
                selectedPhuongTienText: '@Html.Raw(Model.TenPhuongTien)',
                isViewMode: isViewMode,
                isInlineDetail: false
            });
            pnk.init();
            $('#@containerId').data('pnkInstance', pnk);

            if (isViewMode) {
                $('.sel-sanpham, .txt-soluong, .txt-dongia, .txt-thue, .txt-ghichu, .txt-ngaysanxuat, .txt-hansudung, .txt-dongiavanchuyen').prop('disabled', true).addClass('readonly-cell');
                $('.btn-remove-row, #btnAddRow, #btnSavePhieu').hide();
            }

            $('#btnSaveDraft').on('click', function () {
                var pnk = $('#@containerId').data('pnkInstance');
                if (!pnk) { showToast('error', 'Lỗi khởi tạo đối tượng JavaScript'); return; }
                var data = pnk.validateAndSerialize();
                if (!data) return;
                data.TrangThai = 0;

                showConfirm("Bạn có chắc chắn muốn lưu nháp phiếu này?", function() {
                    $.ajax({
                        url: '@Url.Action("Save")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(data),
                        success: function (res) {
                            if (res.success) {
                                showToast('success', res.message);
                                if (data.ID == 0 && res.id) {
                                    $('#ID').val(res.id);
                                    $('#SoChungTu').val(res.soChungTu);
                                    $('#btnGhiDuLieu').show();
                                    $('#badgeTrangThai').text('Nháp');
                                } else {
                                    $('#badgeTrangThai').text('Nháp');
                                }
                            } else {
                                showToast('error', res.message);
                            }
                        },
                        error: function () { showToast('error', 'Đã xảy ra lỗi hệ thống'); }
                    });
                });
            });

            $('#btnSavePhieu').on('click', function () {
                var pnk = $('#@containerId').data('pnkInstance');
                if (!pnk) { showToast('error', 'Lỗi khởi tạo đối tượng JavaScript'); return; }
                var data = pnk.validateAndSerialize();
                if (!data) return;
                data.TrangThai = 1;

                showConfirm("Bạn có chắc chắn muốn lưu phiếu này?", function() {
                    $.ajax({
                        url: '@Url.Action("Save")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(data),
                        success: function (res) {
                            if (res.success) {
                                showToast('success', res.message);
                                if (data.ID == 0 && res.id) {
                                    $('#ID').val(res.id);
                                    $('#SoChungTu').val(res.soChungTu);
                                    $('#btnGhiDuLieu').show();
                                    $('#badgeTrangThai').text('Đề nghị ghi');
                                }
                            } else {
                                showToast('error', res.message);
                            }
                        },
                        error: function () { showToast('error', 'Đã xảy ra lỗi hệ thống'); }
                    });
                });
            });
        });

        function LuuVaGhiNow(btn) {
            var $container = $(btn).closest('[id^="pnk_edit_"]');
            var pnk = $container.data('pnkInstance');
            if (!pnk) { showToast('error', 'Lỗi khởi tạo đối tượng JavaScript'); return; }
            var data = pnk.validateAndSerialize();
            if (!data) return;
            data.TrangThai = 1;

            showConfirm('Bạn có chắc chắn muốn lưu và ghi dữ liệu phiếu này? Kho sẽ được cập nhật.', function() {
                $.ajax({
                    url: '@Url.Action("Save")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (saveRes) {
                        if (saveRes.success) {
                            var currentId = saveRes.id || data.ID || $('#ID').val() || @Model.ID;
                            $('#ID').val(currentId);
                            if (saveRes.soChungTu) {
                                $('#SoChungTu').val(saveRes.soChungTu);
                            }

                            $.post('@Url.Action("GhiSo")', { id: currentId }, function (ghiRes) {
                                if (ghiRes.success) {
                                    showToast('success', 'Lưu và ghi dữ liệu thành công');
                                    var $context = btn ? $(btn).closest('.tab-pane') : $(document);
                                    if ($context.length === 0) $context = $(document);

                                    $context.find('#badgeTrangThai').removeClass('bg-secondary bg-danger').addClass('bg-success').text('Đã ghi');
                                    $context.find('#btnGhiDuLieu, #btnSavePhieu, .btn-remove-row, #btnAddRow').hide();
                                    $context.find('.sel-sanpham, .txt-soluong, .txt-dongia, .txt-thue, .txt-ghichu').prop('disabled', true);
                                    $context.find('select, input, textarea').prop('disabled', true);
                                } else {
                                    showToast('error', 'Lưu thành công nhưng ghi dữ liệu thất bại: ' + ghiRes.message);
                                }
                            });
                        } else {
                            showToast('error', 'Lưu phiếu nhập thất bại: ' + saveRes.message);
                        }
                    },
                    error: function () {
                        showToast('error', 'Đã xảy ra lỗi hệ thống khi lưu phiếu.');
                    }
                });
            });
        }
    </script>
    <style>
        .readonly-cell { background-color: #e9ecef !important; border: 1px solid #ced4da; }
    </style>
    }
}
