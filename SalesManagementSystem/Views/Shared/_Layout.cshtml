<!-- Scripts -->
<script src="@Url.Content("~/Scripts/jquery-3.7.0.min.js")"></script>
<script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Sidebar toggle
    const toggleBtn   = document.getElementById('sidebarToggle');
    const body        = document.body;

    // Khôi phục trạng thái từ localStorage
    if (localStorage.getItem('sidebarCollapsed') === '1') {
        body.classList.add('sidebar-collapsed');
    }

    // Bật/tắt Sidebar (Desktop/Mobile)
    toggleBtn.addEventListener('click', function () {
        if (window.innerWidth > 768) {
            body.classList.toggle('sidebar-collapsed');
            localStorage.setItem('sidebarCollapsed', body.classList.contains('sidebar-collapsed') ? '1' : '0');
        } else {
            body.classList.toggle('sidebar-open');
        }
    });

    // Lưu trữ và phục hồi trạng thái mở của Menu Accordion
    document.addEventListener("DOMContentLoaded", function () {
        var openMenus = JSON.parse(localStorage.getItem('openMenus') || '[]');
        
        // Phục hồi trạng thái (những nhóm có id nằm trong openMenus sẽ được mở ra)
        openMenus.forEach(function (id) {
            var group = document.getElementById(id);
            if (group && !group.classList.contains('show')) {
                group.classList.add('show');
                var toggle = document.querySelector('[href="#' + id + '"]');
                if (toggle) {
                    toggle.classList.remove('collapsed');
                    toggle.setAttribute('aria-expanded', 'true');
                }
            }
        });

        // Lắng nghe sự kiện Bootstrap collapse để lưu trạng thái
        var groups = document.querySelectorAll('.nav-group-collapse');
        groups.forEach(function (group) {
            group.addEventListener('shown.bs.collapse', function (e) {
                if (e.target === this) {
                    var arr = JSON.parse(localStorage.getItem('openMenus') || '[]');
                    if (!arr.includes(this.id)) arr.push(this.id);
                    localStorage.setItem('openMenus', JSON.stringify(arr));
                }
            });
            group.addEventListener('hidden.bs.collapse', function (e) {
                if (e.target === this) {
                    var arr = JSON.parse(localStorage.getItem('openMenus') || '[]');
                    arr = arr.filter(id => id !== this.id);
                    localStorage.setItem('openMenus', JSON.stringify(arr));
                }
            });
        });
    });

    // Expand / Collapse tất cả Accordions
    function toggleAllAccordions() {
        var groups = document.querySelectorAll('.nav-group-collapse');
        var toggles = document.querySelectorAll('.nav-group-toggle');
        var icon = document.getElementById('expandAllIcon');
        
        // Kiểm tra xem có đang mở cái nào không
        var isAnyOpen = false;
        groups.forEach(function(g) { if (g.classList.contains('show')) isAnyOpen = true; });

        var arr = []; // Cập nhật localStorage
        if (isAnyOpen) {
            // Đóng tất cả
            toggles.forEach(function(t) { 
                t.classList.add('collapsed'); 
                t.setAttribute('aria-expanded', 'false'); 
            });
            groups.forEach(function(g) { 
                var bsCollapse = bootstrap.Collapse.getInstance(g);
                if (bsCollapse) bsCollapse.hide();
                else g.classList.remove('show');
            });
            localStorage.setItem('openMenus', JSON.stringify([]));
            if(icon) { icon.classList.remove('bi-caret-up-fill'); icon.classList.add('bi-caret-down-fill'); }
        } else {
            // Mở tất cả
            toggles.forEach(function(t) { 
                t.classList.remove('collapsed'); 
                t.setAttribute('aria-expanded', 'true'); 
            });
            groups.forEach(function(g) { 
                arr.push(g.id);
                var bsCollapse = bootstrap.Collapse.getInstance(g);
                if (bsCollapse) bsCollapse.show();
                else g.classList.add('show');
            });
            localStorage.setItem('openMenus', JSON.stringify(arr));
            if(icon) { icon.classList.remove('bi-caret-down-fill'); icon.classList.add('bi-caret-up-fill'); }
        }
    }

    // Đóng sidebar khi click ngoài (mobile)
    document.addEventListener('click', function (e) {
        if (window.innerWidth <= 768
            && !document.getElementById('sidebar').contains(e.target)
            && e.target !== toggleBtn
            && !toggleBtn.contains(e.target)) {
            body.classList.remove('sidebar-open');
        }
    });

    // Hàm gọi Global Delete Modal (Xóa 1 phần tử)
    function confirmDelete(url, customMessage) {
        var form = document.getElementById('globalDeleteForm');
        form.action = url;
        
        // Xóa các input hidden cũ nếu có
        var existingIds = form.querySelectorAll('input[name="ids"]');
        existingIds.forEach(function(el) { el.remove(); });
        
        // Reset nội dung
        var msgEl = document.getElementById('globalDeleteMessage');
        if (!msgEl.dataset.originalMsg) {
            msgEl.dataset.originalMsg = msgEl.innerText;
        }
        msgEl.innerText = customMessage || msgEl.dataset.originalMsg;

        var myModal = new bootstrap.Modal(document.getElementById('globalDeleteModal'));
        myModal.show();
    }

    // Hàm gọi Global Delete Modal (Xóa nhiều phần tử)
    function confirmBatchDelete(url, ids, message) {
        var form = document.getElementById('globalDeleteForm');
        form.action = url;
        
        // Xóa các input hidden cũ nếu có
        var existingIds = form.querySelectorAll('input[name="ids"]');
        existingIds.forEach(function(el) { el.remove(); });
        
        // Thêm hidden input cho từng ID
        ids.forEach(function(id) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'ids';
            input.value = id;
            form.appendChild(input);
        });

        // Thay đổi thông báo
        var msgEl = document.getElementById('globalDeleteMessage');
        if (!msgEl.dataset.originalMsg) {
            msgEl.dataset.originalMsg = msgEl.innerText;
        }
        msgEl.innerText = message || msgEl.dataset.originalMsg;

        var myModal = new bootstrap.Modal(document.getElementById('globalDeleteModal'));
        myModal.show();
    }

    // Hàm gọi Global Confirm Modal (Xác nhận chung)
    function showConfirm(message, onConfirm) {
        var msgEl = document.getElementById('globalConfirmMessage');
        msgEl.innerText = message;
        
        var btnYes = document.getElementById('btnGlobalConfirmYes');
        btnYes.onclick = function() {
            var myModal = bootstrap.Modal.getInstance(document.getElementById('globalConfirmModal'));
            if (myModal) myModal.hide();
            if (typeof onConfirm === 'function') onConfirm();
        };

        var myModal = new bootstrap.Modal(document.getElementById('globalConfirmModal'));
        myModal.show();
    }

    // Theo dõi phần tử được click cuối cùng để xác định tab chứa nút gọi modal
    var lastClickedElement = null;
    $(document).on('mousedown', function(e) {
        lastClickedElement = e.target;
    });

    // Hàm hiển thị Form Modal qua AJAX (Tạo modal riêng cho từng tab)
    function openFormModal(url) {
        var ownerTabId = null;
        if (lastClickedElement) {
            var $pane = $(lastClickedElement).closest('.tab-pane');
            if ($pane.length > 0) {
                ownerTabId = $pane.attr('id');
            }
        }
        if (!ownerTabId) {
            ownerTabId = $('.tab-pane.active').attr('id');
        }
        if (!ownerTabId) ownerTabId = 'global';

        var modalId = 'formModal_' + ownerTabId;
        var $modal = $('#' + modalId);

        // Tạo modal mới nếu chưa có
        if ($modal.length === 0) {
            var modalHtml = '<div class="modal fade form-modal" id="' + modalId + '" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" data-owner-tab="' + ownerTabId + '">' +
                '<div class="modal-dialog modal-lg modal-dialog-centered">' +
                    '<div class="modal-content shadow-lg border-0 form-modal-content"></div>' +
                '</div></div>';
            $('body').append(modalHtml);
            $modal = $('#' + modalId);
            
            // Xử lý sự kiện ẩn modal
            $modal.on('hidden.bs.modal', function () {
                $(this).removeClass('d-none');
                // Nếu không còn modal nào đang hiển thị thì gỡ backdrop d-none dự phòng
                if ($('.modal.show').length === 0) {
                    $('.modal-backdrop').removeClass('d-none');
                    $('body').removeClass('modal-open');
                }
            });
        }

        $.ajax({
            url: url,
            type: 'GET',
            success: function(res) {
                // Đảm bảo kích thước mặc định là modal-lg
                $modal.find('.modal-dialog').removeClass('modal-xl modal-sm').addClass('modal-lg');
                $modal.find('.form-modal-content').html(res);
                
                var formModal = bootstrap.Modal.getOrCreateInstance($modal[0]);
                formModal.show();
            },
            error: function() {
                showToast('error', 'Không thể tải dữ liệu form.');
            }
        });
    }

    // Bắt sự kiện submit form bên trong form-modal
    $(document).on('submit', '.form-modal-content form', function(e) {
        e.preventDefault();
        var form = $(this);
        var formData = new FormData(this);
        var $modal = form.closest('.modal');
        
        $.ajax({
            url: form.attr('action'),
            type: form.attr('method') || 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                if (res.success === true) {
                    $modal.modal('hide');
                    showToast('success', res.message);
                    if (typeof TabManager !== 'undefined') {
                        TabManager.reloadActiveTabGrid(false);
                    } else if (typeof loadData === 'function') {
                        loadData('');
                    } else {
                        location.reload();
                    }
                } else if (res.success === false) {
                    showToast('error', res.message);
                } else {
                    // Nếu validation lỗi, trả về HTML partial view chứa form
                    $modal.find('.form-modal-content').html(res);
                }
            },
            error: function() {
                showToast('error', 'Có lỗi xảy ra khi lưu dữ liệu.');
            }
        });
    });

    function showToast(type, message) {
        var toastEl = document.getElementById('globalToast');
        var messageEl = document.getElementById('globalToastMessage');
        
        // Reset classes
        toastEl.className = 'toast align-items-center border-0 shadow-lg text-white';
        
        var iconHtml = '';
        var btnClose = toastEl.querySelector('.btn-close');
        btnClose.className = 'btn-close btn-close-white me-2 m-auto';

        if (type === 'success') {
            toastEl.classList.add('bg-success');
            iconHtml = '<i class="bi bi-check-circle-fill me-2 fs-5"></i>';
        } else if (type === 'error' || type === 'danger') {
            toastEl.classList.add('bg-danger');
            iconHtml = '<i class="bi bi-x-circle-fill me-2 fs-5"></i>';
        } else if (type === 'warning') {
            toastEl.classList.add('bg-warning', 'text-dark');
            toastEl.classList.remove('text-white');
            btnClose.className = 'btn-close me-2 m-auto'; // Nút close đen cho nền vàng
            iconHtml = '<i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>';
        } else {
            toastEl.classList.add('bg-dark');
            iconHtml = '<i class="bi bi-info-circle-fill me-2 fs-5"></i>';
        }

        messageEl.innerHTML = iconHtml + '<span>' + message + '</span>';
        
        var bsToast = new bootstrap.Toast(toastEl);
        bsToast.show();
    }

    // Global Ajax Error Handler
    $(document).ajaxError(function(event, jqxhr, settings, thrownError) {
        if (jqxhr.status === 403) {
            showToast('error', 'Từ chối truy cập: Bạn không có quyền thực hiện chức năng này.');
        } else if (jqxhr.status === 401) {
            showToast('error', 'Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.');
            setTimeout(function() { window.location.href = '@Url.Action("Index", "Login")'; }, 1500);
        } else if (jqxhr.status === 404) {
            showToast('error', 'Không tìm thấy dữ liệu hoặc màn hình.');
        } else if (jqxhr.status >= 500) {
            showToast('error', 'Lỗi hệ thống (' + jqxhr.status + '). Vui lòng thử lại sau.');
        }
    });

    // Xử lý thông báo Toast từ Controller (TempData) - Giữ lại cho các form truyền thống
    @if (TempData["ToastMessage"] != null)
    {
        var toastType = TempData["ToastType"] ?? "success";
        var toastMsg = TempData["ToastMessage"];
        TempData.Remove("ToastMessage");
        TempData.Remove("ToastType");
        <text>
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof showToast === 'function') {
                showToast('@toastType', '@toastMsg');
            }
        });
        </text>
    }

    // Bắt sự kiện submit form Delete bằng AJAX để không bị chớp màn hình (giữ nguyên trang)
    $(document).on('submit', '#globalDeleteForm', function(e) {
        e.preventDefault();
        var form = $(this);
        $.ajax({
            url: form.attr('action'),
            type: form.attr('method') || 'POST',
            data: form.serialize(),
            success: function(res) {
                if (res.success === true) {
                    $('#globalDeleteModal').modal('hide');
                    showToast('success', res.message);
                    // Dùng TabManager.reloadActiveTabGrid() thay cho loadData() toàn cục
                    if (typeof TabManager !== 'undefined') {
                        TabManager.reloadActiveTabGrid(false);
                    } else if (typeof loadData === 'function') {
                        loadData('');
                    } else {
                        location.reload();
                    }
                } else {
                    showToast('error', res.message || 'Có lỗi xảy ra.');
                }
            },
            error: function() {
                showToast('error', 'Lỗi hệ thống khi xóa.');
            }
        });
    });

    // Sửa lỗi dropdown "Thao tác" bị cắt ngang bởi table-responsive
    // Dùng event delegation trên document để hoạt động được với cả bảng tải qua AJAX/SPA
    $(document).on('mouseenter', '.table-responsive .dropdown-hover', function() {
        $(this).closest('.table-responsive').css('overflow', 'visible');
    }).on('mouseleave', '.table-responsive .dropdown-hover', function() {
        $(this).closest('.table-responsive').css('overflow', '');
    });
</script>
<script src="~/Scripts/tab-manager.js?v=@DateTime.Now.Ticks"></script>
<script src="~/Scripts/global-search.js?v=@DateTime.Now.Ticks"></script>
@RenderSection("scripts", required: false)

<script>
    /* ================================================================
       GLOBAL AJAX ERROR HANDLER (Bắt lỗi 401 khi mất Session)
    ================================================================ */
    $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
        if (jqxhr.status === 401 || jqxhr.status === 403) {
            localStorage.removeItem('tabManagerState');
            window.location.href = '@Url.Action("Logout", "Login")';
        }
    });

    /* ================================================================
       GLOBAL AJAX SEND HANDLER (Blink effect cho màn hình tìm kiếm)
    ================================================================ */
    $(document).ajaxSend(function (event, jqxhr, settings) {
        if (settings.url && (settings.url.toLowerCase().indexOf('getlist') !== -1 || settings.url.toLowerCase().indexOf('search') !== -1)) {
            var $tableContainer = $('.tab-pane.active #table-container, .tab-pane.active [id^="table-container-"]');
            if ($tableContainer.length === 0) {
                $tableContainer = $('#table-container, [id^="table-container-"]'); 
            }
            if ($tableContainer.length > 0) {
                $tableContainer.css('opacity', '0.5');
                setTimeout(function() { $tableContainer.css('opacity', '1'); }, 100);
            }
        }
    });

    /* ================================================================
       GLOBAL FORM RESET HANDLER (Chuẩn SKILL.md)
    ================================================================ */
    $(document).on('click', '.btn-reset, [id^="btnReset"]', function () {
        var $form = $(this).closest('form');
        if ($form.length === 0) {
            // Trường hợp nút không nằm trong form, tìm form gần nhất trong tab
            $form = $(this).closest('.tab-pane').find('form').first();
            if ($form.length === 0) $form = $('form').first();
        }
        
        if ($form.length > 0) {
            // 1. Clear form cơ bản
            $form[0].reset();
            
            // 2. Clear thư viện Select2 (nếu có)
            var $select2 = $form.find('.select2, .select2-hidden-accessible');
            if ($select2.length > 0) {
                $select2.val(null).trigger('change');
            }

            // 3. Xử lý giá trị flatpickr (đặt lại mặc định cho Từ ngày/Đến ngày)
            var today = new Date();
            var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            var lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

            $form.find('.flatpickr-input').each(function() {
                if (this._flatpickr) {
                    var name = $(this).attr('name');
                    if (name === 'tuNgay') {
                        this._flatpickr.setDate(firstDay);
                    } else if (name === 'denNgay') {
                        this._flatpickr.setDate(lastDay);
                    } else {
                        this._flatpickr.clear();
                    }
                }
            });
            
            // Đợi một chút để DOM cập nhật xong rồi mới submit
            setTimeout(function() {
                $form.trigger('submit');
            }, 50);
        }
    });

    /* ================================================================
       GLOBAL DATE PICKER (Flatpickr)
    ================================================================ */
    function initGlobalDatePickers(context) {
        var today = new Date();
        var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        var lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

        $(context).find('input[type="date"]').each(function () {
            var $this = $(this);
            if ($this.hasClass('flatpickr-input') || $this.hasClass('date-initialized')) return;
            $this.addClass('date-initialized');

            var name = $this.attr('name');
            var val = $this.val();

            // Nếu ô ngày trống và tên là tuNgay/denNgay thì set mặc định đầu/cuối tháng
            if (!val && (name === 'tuNgay' || name === 'denNgay')) {
                if (name === 'tuNgay') val = flatpickr.formatDate(firstDay, "Y-m-d");
                if (name === 'denNgay') val = flatpickr.formatDate(lastDay, "Y-m-d");
                $this.val(val); // Set value immediately so normal form submit works
            }

            // Đổi type thành text để trình duyệt không hiện lịch mặc định
            $this.attr('type', 'text');

            flatpickr(this, {
                dateFormat: "Y-m-d", // Format gửi lên server
                altInput: true,
                altFormat: "d/m/Y", // Format hiển thị
                allowInput: true,
                defaultDate: val,
                locale: "vn"
            });
        });
    }

    // Khởi tạo cho các thẻ có sẵn khi trang vừa load
    $(document).ready(function() {
        initGlobalDatePickers(document);
        syncThoiGianFilter(document);
    });

    // Dùng MutationObserver để bắt các Tab hoặc form được load động bằng AJAX
    var observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
            if (mutation.addedNodes && mutation.addedNodes.length > 0) {
                mutation.addedNodes.forEach(function (node) {
                    if (node.nodeType === 1) { // ELEMENT_NODE
                        // Kiểm tra nếu bản thân node là date hoặc con nó là date
                        if ($(node).is('input[type="date"]')) {
                            initGlobalDatePickers($(node).parent());
                        } else if ($(node).find('input[type="date"]').length > 0) {
                            initGlobalDatePickers(node);
                        }
                        
                        if ($(node).is('.ddl-thoi-gian')) {
                            syncThoiGianFilter($(node).parent());
                        } else if ($(node).find('.ddl-thoi-gian').length > 0) {
                            syncThoiGianFilter(node);
                        }
                    }
                });
            }
        });
    });
    observer.observe(document.body, { childList: true, subtree: true });

    /* ================================================================
       GLOBAL THOI GIAN FILTER HANDLER
       - Đồng bộ giá trị Combobox khi tải trang dựa trên Từ ngày/Đến ngày
    ================================================================ */
    function syncThoiGianFilter(context) {
        var $ctx = $(context || document);
        $ctx.find('.ddl-thoi-gian').each(function() {
            if ($(this).data('synced')) return;
            $(this).data('synced', true);
            
            var $form = $(this).closest('form');
            var txtTu = $form.find('input[name="tuNgay"]').val();
            var txtDen = $form.find('input[name="denNgay"]').val();
            if (!txtTu || !txtDen) return;
            
            var tuDate = new Date(txtTu);
            var denDate = new Date(txtDen);
            
            var yTu = tuDate.getFullYear();
            var mTu = tuDate.getMonth() + 1;
            var dTu = tuDate.getDate();
            
            var yDen = denDate.getFullYear();
            var mDen = denDate.getMonth() + 1;
            var dDen = denDate.getDate();
            
            var isFirstDay = dTu === 1;
            var daysInMonth = new Date(yDen, mDen, 0).getDate();
            var isLastDay = dDen === daysInMonth;
            
            if (yTu === yDen && mTu === mDen && isFirstDay && isLastDay) {
                $(this).val('month_' + mTu);
            }
        });
    }

    /* ================================================================
       - Xử lý thay đổi Combobox "Thời gian" tự động cập nhật Từ ngày/Đến ngày
    ================================================================ */
    $(document).on('change', '.ddl-thoi-gian', function() {
        try {
            var val = this.value;
            if (!val) return;
            
            var now = new Date();
            var y = now.getFullYear();
            var s = '', e = '';
            
            function getDays(year, month) {
                var days = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
                if (month === 2 && ((year % 4 === 0 && year % 100 !== 0) || year % 400 === 0)) return 29;
                return days[month];
            }
            
            function fDate(year, month, day) {
                var m = month < 10 ? '0' + month : month;
                var d = day < 10 ? '0' + day : day;
                return year + '-' + m + '-' + d;
            }
            
            if (val === 'current_month') {
                var cm = now.getMonth() + 1;
                s = fDate(y, cm, 1);
                e = fDate(now.getFullYear(), now.getMonth() + 1, now.getDate());
            } else if (val.indexOf('month_') === 0) {
                var m = parseInt(val.replace('month_', ''), 10);
                s = fDate(y, m, 1);
                e = fDate(y, m, getDays(y, m));
            } else if (val.indexOf('quarter_') === 0) {
                var q = parseInt(val.replace('quarter_', ''), 10);
                var startM = (q - 1) * 3 + 1;
                var endM = startM + 2;
                s = fDate(y, startM, 1);
                e = fDate(y, endM, getDays(y, endM));
            }

            if (s && e) {
                // Tìm 2 ô input gần nhất trong cùng 1 form
                var $form = $(this).closest('form');
                if ($form.length === 0) return;
                
                var txtTuNgay = $form.find('input[name="tuNgay"]')[0];
                var txtDenNgay = $form.find('input[name="denNgay"]')[0];
                
                if (txtTuNgay && txtDenNgay) {
                    if (txtTuNgay._flatpickr) txtTuNgay._flatpickr.setDate(s);
                    else { $(txtTuNgay).val(s).trigger('change'); }
                    
                    if (txtDenNgay._flatpickr) txtDenNgay._flatpickr.setDate(e);
                    else { $(txtDenNgay).val(e).trigger('change'); }
                    
                    setTimeout(function() {
                        var btn = $form.find('button[type="submit"]')[0];
                        if (btn) {
                            btn.click();
                        } else {
                            $form.trigger('submit');
                        }
                    }, 50);
                }
            }
        } catch(err) {
            console.error("Loi xu ly thoi gian: ", err);
        }
    });

    /* ================================================================
       SESSION KEEP-ALIVE
       - Ping /Home/KeepAlive mỗi 4 phút để giữ App Pool sống
       - Tự động logout sau 8 tiếng (28800 giây)
       - Hiện cảnh báo 2 phút trước khi hết hạn
    ================================================================ */
    (function () {
        var SESSION_MAX_MS   = 40 * 60 * 60 * 1000;  // 40 tiếng
        var WARN_BEFORE_MS   = 2 * 60 * 1000;        // cảnh báo trước 2 phút
        var PING_INTERVAL_MS = 4 * 60 * 1000;        // ping mỗi 4 phút
        var loginTime        = Date.now();
        var warnShown        = false;
        var keepAliveUrl     = '@Url.Action("KeepAlive", "Home")';
        var logoutUrl        = '@Url.Action("Logout", "Login")';

        function pingServer() {
            $.ajax({
                url: keepAliveUrl,
                type: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (res) {
                    if (!res.alive) {
                        // Session đã mất → về trang đăng nhập
                        localStorage.removeItem('tabManagerState');
                        window.location.href = logoutUrl;
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403) {
                        localStorage.removeItem('tabManagerState');
                        window.location.href = logoutUrl;
                    }
                }
            });
        }

        function checkTimeout() {
            var elapsed = Date.now() - loginTime;
            var remaining = SESSION_MAX_MS - elapsed;

            if (remaining <= 0) {
                // Hết 8 tiếng → logout
                localStorage.removeItem('tabManagerState');
                window.location.href = logoutUrl;
                return;
            }

            if (remaining <= WARN_BEFORE_MS && !warnShown) {
                warnShown = true;
                // Hiện toast cảnh báo sắp hết hạn
                var toast = $('<div style="position:fixed;bottom:24px;right:24px;z-index:99999;background:#e74c3c;color:#fff;padding:14px 20px;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,0.2);font-size:0.9rem;max-width:320px;">' +
                    '<b><i class="bi bi-clock-history"></i> Phiên làm việc sắp hết hạn</b><br>' +
                    'Còn khoảng 2 phút nữa hệ thống sẽ tự động đăng xuất.<br>' +
                    '<small>Làm mới trang để gia hạn thêm 40 tiếng.</small></div>');
                $('body').append(toast);
                setTimeout(function () { toast.fadeOut(500, function () { toast.remove(); }); }, 90000);
            }
        }

        // Ping ngay lần đầu sau 30 giây, rồi mỗi 4 phút
        setTimeout(function () {
            pingServer();
            setInterval(pingServer, PING_INTERVAL_MS);
        }, 30000);

        // Kiểm tra 40 tiếng mỗi 30 giây
        setInterval(checkTimeout, 30000);
    })();
</script>
</body>
</html>



