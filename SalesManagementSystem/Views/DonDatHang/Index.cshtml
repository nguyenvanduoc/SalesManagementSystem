@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.DonDatHangViewModel>

@{
    ViewBag.Title = "Danh sách đơn đặt hàng";
    var uid = Guid.NewGuid().ToString("N");
}

<style>
    .ddh-row.active-row td {
        background-color: #e3f2fd !important;
    }
    .ddh-detail-row > td {
        box-shadow: inset 0 3px 6px -3px rgba(0,0,0,0.1), inset 0 -3px 6px -3px rgba(0,0,0,0.1);
    }
</style>

@using SalesManagementSystem.Helpers

<div id="ddh-@uid">
    <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">
        <i class="bi bi-cart3 me-2"></i>@ViewBag.Title
    </h4>
    <div class="d-flex gap-2">
        @if (PermissionHelper.HasPermission("DonDatHang", LoaiPhanQuyen.Them))
        {
            <a href="@Url.Action("Create","DonDatHang")" class="btn btn-primary"
               style="background-color:#3498db;border-color:#3498db;">
                <i class="bi bi-plus-lg fw-bold"></i> Thêm đơn
            </a>
        }
        <div class="dropdown d-inline-block">
            <button class="btn btn-success dropdown-toggle no-ajax" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color:#28a745;border-color:#28a745;">
                <i class="bi bi-file-earmark-excel"></i> Xuất excel
            </button>
            <ul class="dropdown-menu shadow-sm">
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="exportExcelList()"><i class="bi bi-list-task me-2 text-muted"></i>Xuất danh sách (DH02)</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="exportExcelDH03()"><i class="bi bi-list-nested me-2 text-muted"></i>Xuất chi tiết (DH03)</a></li>
            </ul>
        </div>
        @if (PermissionHelper.HasPermission("DonDatHang", LoaiPhanQuyen.Xoa))
        {
            <button type="button" class="btn btn-danger"
                    style="background-color:#e74c3c;border-color:#e74c3c;"
                    onclick="deleteSelected()">
                <i class="bi bi-trash"></i> Xóa
            </button>
        }
    </div>
</div>

<!-- Bộ lọc -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form id="searchForm" action="@Url.Action("GetList","DonDatHang")" method="get">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Từ ngày</label>
                    <input type="date" name="tuNgay" class="form-control form-control-sm"
                           value="@ViewBag.TuNgay" />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Đến ngày</label>
                    <input type="date" name="denNgay" class="form-control form-control-sm"
                           value="@ViewBag.DenNgay" />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Khách hàng</label>
                    @Html.DropDownList("idKhachHang",
                        (SelectList)ViewBag.KhachHangs,
                        "-- Tất cả --",
                        new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Nhân viên</label>
                    @Html.DropDownList("idNhanVien",
                        (SelectList)ViewBag.NhanViens,
                        "-- Tất cả --",
                        new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Trạng thái</label>
                    @Html.DropDownList("trangThai",
                        (SelectList)ViewBag.TrangThais,
                        "-- Tất cả --",
                        new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Số đơn hàng</label>
                    <input type="text" name="soDonHang" class="form-control form-control-sm"
                           placeholder="Tìm số đơn..." value="@ViewBag.SoDonHang" />
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-sm text-white px-3"
                            style="background-color:#2998e4;border:none;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <button type="button" onclick="resetSearchDonDatHang()" class="btn btn-sm text-white px-3"
                            style="background-color:#f1c40f;border:none;">
                        Làm mới
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="table-container">
    @Html.Partial("_DonDatHangList", Model)
</div>

<!-- Modal Chuyển trạng thái -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-primary">Chuyển trạng thái đơn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="statusOrderId" />
                <div class="mb-3">
                    <label class="form-label">Chọn trạng thái mới:</label>
                    <select id="statusNewStatus" class="form-select">
                        @foreach (var item in (SelectList)ViewBag.TrangThais)
                        {
                            if (item.Value == "3" || item.Value == "4")
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="submitStatusChange()">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

</div>

@section Scripts {
<script>
    (function() {
        var $container = $('#ddh-@uid');
        
        $(document).ready(function () {
            $container.on('change', '#checkAll', function () {
                $container.find('.row-checkbox').prop('checked', $(this).prop('checked'));
            });
            $container.on('change', '.row-checkbox', function () {
                var all = $container.find('.row-checkbox').length;
                var checked = $container.find('.row-checkbox:checked').length;
                $container.find('#checkAll').prop('checked', all > 0 && all === checked);
            });

            // Delegate row clicks for inline detail view
            $container.on('click', '.ddh-row', function (e) {
                if ($(e.target).closest('a, button, select, input, .dropdown, .dropdown-menu').length) {
                    return;
                }

                var $row = $(this);
                var id = $row.data('id');
                if (!id) return;

                var $nextRow = $row.next();
                var isAlreadyExpanded = $nextRow.hasClass('ddh-detail-row') && $nextRow.data('parent-id') == id;

                // Close any currently open detail rows in this container
                $container.find('.ddh-detail-row').remove();
                $container.find('.ddh-row').removeClass('active-row');
                $container.find('.toggle-icon').removeClass('bi-caret-down-fill text-primary').addClass('bi-caret-right-fill text-muted');

                if (isAlreadyExpanded) {
                    return;
                }

                // Highlight active row
                $row.addClass('active-row');
                $row.find('.toggle-icon').removeClass('bi-caret-right-fill text-muted').addClass('bi-caret-down-fill text-primary');

                // Create placeholder detail row
                var $detailRow = $('<tr class="ddh-detail-row" data-parent-id="' + id + '">' +
                    '<td colspan="13" class="p-3" style="background-color: #fcfdfd; border-left: 4px solid #2998e4;">' +
                    '   <div class="text-center p-4 text-muted">' +
                    '       <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>' +
                    '       Đang tải chi tiết...' +
                    '   </div>' +
                    '</td>' +
                    '</tr>');

                $row.after($detailRow);

                // Load view content via AJAX
                $.ajax({
                    url: '@Url.Action("GetDetailInline", "DonDatHang")',
                    type: 'GET',
                    data: { id: id },
                    success: function (html) {
                        $detailRow.find('td').html(html);
                    },
                    error: function () {
                        $detailRow.find('td').html('<div class="text-danger text-center p-3"><i class="bi bi-exclamation-triangle-fill me-2"></i> Lỗi khi tải thông tin chi tiết.</div>');
                    }
                });
            });
        });
    })();

    function resetSearchDonDatHang() {
        var $form = $('#searchForm');
        $form[0].reset();
        $form.find('select').val('').trigger('change');
        loadDataDonDatHang('');
    }

    function loadDataDonDatHang(urlOrData) {
        var requestUrl = typeof urlOrData === 'string' && urlOrData.indexOf('/') !== -1 
                         ? urlOrData 
                         : '@Url.Action("GetList","DonDatHang")?' + urlOrData;
        
        // Scope specifically to the currently active tab or this view's container
        var $container = $('.tab-pane.active #table-container');
        if ($container.length === 0) $container = $('#table-container');

        $.ajax({
            url: requestUrl,
            type: 'GET',
            success: function(res) {
                $container.html(res);
            },
            error: function() {
                showToast('error', 'Có lỗi xảy ra khi tải dữ liệu.');
            }
        });
    }

    function deleteSelected() {
        var ids = [];
        $('.row-checkbox:checked').each(function () { ids.push($(this).val()); });
        if (ids.length === 0) { showToast('warning', 'Vui lòng chọn ít nhất một đơn hàng.'); return; }
        confirmBatchDelete('@Url.Action("Delete","DonDatHang")', ids,
            'Bạn có chắc chắn muốn xóa ' + ids.length + ' đơn hàng đã chọn không?');
    }

    function openStatusModal(id, currentStatus) {
        $('#statusOrderId').val(id);
        $('#statusNewStatus').val(currentStatus);
        $('#statusModal').modal('show');
    }

    function submitStatusChange() {
        var id = $('#statusOrderId').val();
        var newStatus = $('#statusNewStatus').val();
        $.ajax({
            url: '@Url.Action("UpdateStatus", "DonDatHang")',
            type: 'POST',
            data: { id: id, trangThaiMoi: newStatus },
            success: function (res) {
                if (res.success) {
                    showToast('success', res.message);
                    $('#statusModal').modal('hide');
                    loadDataDonDatHang($('#searchForm').serialize());
                } else {
                    showToast('error', res.message);
                }
            },
            error: function () {
                showToast('error', 'Lỗi khi cập nhật trạng thái.');
            }
        });
    }

    function exportExcelList() {
        var params = $('#searchForm').serialize();
        window.location.href = '@Url.Action("ExportExcelList", "DonDatHang")?' + params;
    }

    function exportExcelDH03() {
        var params = $('#searchForm').serialize();
        window.location.href = '@Url.Action("ExportExcelDH03", "DonDatHang")?' + params;
    }
</script>
}
