@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.DonDatHangViewModel>

@using SalesManagementSystem.Helpers



<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height:300px;">
            <table id="tblDonDatHangList" class="table table-custom table-bordered table-hover mb-0" style="width:100%; min-width:1350px;">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 35px;"></th>
                        <th class="text-center" style="width:40px;">
                            <input type="checkbox" class="form-check-input" id="checkAll" />
                        </th>
                        <th class="text-center" style="width:50px;"></th>
                        <th class="text-center" style="width:45px;">STT</th>
                        <th>Số đơn hàng</th>
                        <th class="text-center">Ngày lên đơn</th>
                        <th>Mã khách hàng</th>
                        <th>Tên khách hàng</th>
                        <th>Nhân sự phụ trách</th>
                        <th>Phương tiện</th>
                        <th>Thông tin xe</th>
                        <th class="d-none">SĐT tài xế</th>
                        <th>Người tạo</th>
                        <th class="text-center">Hạn giao</th>
                        <th class="text-end" style="min-width:120px;">Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr class="ddh-row" id="row_@item.ID" data-id="@item.ID" style="cursor: pointer;">
                                <td class="text-center align-middle">
                                    <i class="bi bi-caret-right-fill text-muted toggle-icon" style="font-size: 0.95rem;"></i>
                                </td>
                                <td class="text-center align-middle">
                                    <input type="checkbox" class="form-check-input row-checkbox" value="@item.ID" />
                                </td>
                                <td class="text-center align-middle" v>
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm"
                                                type="button" data-bs-toggle="dropdown" data-bs-boundary="window" style="padding:2px 6px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>
                                            <li><hr class="dropdown-divider"></li>
                                            @if (PermissionHelper.HasPermission("DonDatHang", LoaiPhanQuyen.Xem))
                                            {
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="@Url.Action("Edit","DonDatHang", new { id = item.ID, isView = true })">
                                                        <i class="bi bi-eye me-2 text-primary"></i> Xem chi tiết
                                                    </a>
                                                </li>
                                                if (item.TrangThaiDon == 1 || item.TrangThaiDon == 0 || item.TrangThaiDon == null)
                                                {
                                                    <li>
                                                        <a class="dropdown-item"
                                                           href="@Url.Action("Edit","DonDatHang", new { id = item.ID })">
                                                            <i class="bi bi-pencil me-2 text-warning"></i> Cập nhật
                                                        </a>
                                                    </li>
                                                }
                                                <li>
                                                    <a class="dropdown-item no-ajax" target="_blank"
                                                       href="@Url.Action("ExportExcel","DonDatHang", new { id = item.ID })">
                                                        <i class="bi bi-file-earmark-excel me-2 text-success"></i> Xuất phiếu
                                                    </a>
                                                </li>
                                            }
                                            @if (PermissionHelper.HasPermission("DonDatHang", LoaiPhanQuyen.Them))
                                            {
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="@Url.Action("Copy", "DonDatHang", new { id = item.ID })">
                                                        <i class="bi bi-files me-2 text-secondary"></i> Sao chép
                                                    </a>
                                                </li>
                                            }
                                            @if (PermissionHelper.HasPermission("DonDatHang", LoaiPhanQuyen.Xoa) && item.TrangThaiDon != 3)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger"
                                                            onclick="confirmDelete('@Url.Action("Delete","DonDatHang",new{id=item.ID})','Xóa đơn hàng @item.SoDonHang?')">
                                                        <i class="bi bi-trash-fill me-2 text-danger"></i> Xóa
                                                    </button>
                                                </li>
                                            }
                                            @if (PermissionHelper.HasPermission("DonDatHang", LoaiPhanQuyen.CapNhat))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item"
                                                            onclick="openStatusModal(@item.ID, @item.TrangThaiDon)">
                                                        <i class="bi bi-arrow-left-right me-2 text-secondary"></i> Chuyển trạng thái
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="align-middle fw-bold">
                                    @if (item.TrangThaiDon == 1 || item.TrangThaiDon == 0 || item.TrangThaiDon == null)
                                    {
                                        <a href="@Url.Action("Edit", "DonDatHang", new { id = item.ID })" class="text-decoration-none">@item.SoDonHang</a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Edit", "DonDatHang", new { id = item.ID, isView = true })" class="text-decoration-none">@item.SoDonHang</a>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @(item.NgayTaoDon.HasValue ? item.NgayTaoDon.Value.ToString("dd/MM/yyyy") : "")
                                </td>
                                <td class="align-middle">@item.MaKhachHang</td>
                                <td class="align-middle">@item.TenKhachHang</td>
                                <td class="align-middle">@item.TenNhanVien</td>
                                <td class="align-middle">@item.TenPhuongTien</td>
                                <td class="align-middle">@item.HoTenTaiXe</td>
                                <td class="align-middle d-none">@item.SoDienThoaiTaiXe</td>
                                <td class="align-middle">@item.TenNguoiTao</td>
                                <td class="text-center align-middle">
                                    @(item.ThoiHanGiaoHang.HasValue ? item.ThoiHanGiaoHang.Value.ToString("dd/MM/yyyy") : "")
                                </td>
                                <td class="text-end align-middle">
                                    @item.TongTien.ToString("N0")
                                </td>
                                <td class="text-center align-middle">
                                    @{
                                        string badgeClass = item.TrangThaiDon == 1 ? "bg-danger"
                                                          : item.TrangThaiDon == 2 ? "bg-warning text-dark"
                                                          : item.TrangThaiDon == 3 ? "bg-success"
                                                          : item.TrangThaiDon == 4 ? "bg-dark"
                                                          : item.TrangThaiDon == 5 ? "bg-primary"
                                                          : item.TrangThaiDon == 6 ? "bg-info text-white"
                                                          : item.TrangThaiDon == 7 ? "bg-success"
                                                          : item.TrangThaiDon == 8 ? "bg-warning text-dark"
                                                          : item.TrangThaiDon == 0 ? "bg-secondary"
                                                          : "bg-secondary";
                                    }
                                    <span class="badge @badgeClass">@item.TenTrangThai</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="16" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Chưa có đơn đặt hàng nào.
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    <tfoot>
                        <tr style="background:#f4f6f9; font-weight:bold;">
                            <td colspan="11" class="text-end">Tổng cộng:</td>
                            <td class="d-none"></td>
                            <td colspan="2"></td>
                            <td class="text-end" style="color: #1a5276; font-size: 1.1em;">@(Model.Items.Sum(x => x.TongTien).ToString("N0"))</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
    @Html.Partial("_Pagination", Model)
</div>

<style>
    #tblDonDatHangList th {
        position: relative;
        background-clip: padding-box;
    }
    #tblDonDatHangList th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblDonDatHangList th .resizer:hover, #tblDonDatHangList th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var table = document.getElementById('tblDonDatHangList');
        if (!table) return;
        
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            // Skip for icon columns, checkbox columns and action columns
            if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
            if(th.innerText.trim() === 'Thao tác') return;
            
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                
                e.preventDefault();
            });
        });
    })();
</script>

