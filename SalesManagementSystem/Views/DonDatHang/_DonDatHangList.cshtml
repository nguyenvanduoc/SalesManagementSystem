@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.DonDatHangViewModel>

@using SalesManagementSystem.Helpers

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height:300px;">
            <table class="table table-custom table-bordered table-hover mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width:40px;">
                            <input type="checkbox" class="form-check-input" id="checkAll" />
                        </th>
                        <th class="text-center" style="width:50px;"></th>
                        <th class="text-center" style="width:45px;">STT</th>
                        <th>Số đơn hàng</th>
                        <th class="text-center">Ngày lên đơn</th>
                        <th>Mã khách hàng</th>
                        <th>Tên khách hàng</th>
                        <th>Nhân sự phụ trách</th>
                        <th>Người tạo</th>
                        <th class="text-center">Hạn giao</th>
                        <th class="text-end" style="min-width:120px;">Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <input type="checkbox" class="form-check-input row-checkbox" value="@item.ID" />
                                </td>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm"
                                                type="button" data-bs-toggle="dropdown" style="padding:2px 6px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>
                                            <li><hr class="dropdown-divider"></li>
                                            @if (PermissionHelper.HasPermission("DonDatHang", LoaiPhanQuyen.Xem))
                                            {
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="@Url.Action("Edit","DonDatHang", new { id = item.ID, isView = true })">
                                                        <i class="bi bi-eye me-2 text-info"></i> Xem chi tiết
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="@Url.Action("Edit","DonDatHang", new { id = item.ID })">
                                                        <i class="bi bi-pencil me-2 text-warning"></i> Cập nhật
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item no-ajax" target="_blank"
                                                       href="@Url.Action("ExportExcel","DonDatHang", new { id = item.ID })">
                                                        <i class="bi bi-file-earmark-excel me-2 text-success"></i> Xuất phiếu
                                                    </a>
                                                </li>
                                            }
                                            @if (PermissionHelper.HasPermission("DonDatHang", LoaiPhanQuyen.Xoa) && item.TrangThaiDon != 3)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger"
                                                            onclick="confirmDelete('@Url.Action("Delete","DonDatHang",new{id=item.ID})','Xóa đơn hàng @item.SoDonHang?')">
                                                        <i class="bi bi-trash-fill me-2 text-danger"></i> Xóa
                                                    </button>
                                                </li>
                                            }
                                            @if (item.TrangThaiDon != 3 && item.TrangThaiDon != 4)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item"
                                                            onclick="openStatusModal(@item.ID, @item.TrangThaiDon)">
                                                        <i class="bi bi-arrow-left-right me-2 text-secondary"></i> Chuyển trạng thái
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="align-middle">@item.SoDonHang</td>
                                <td class="text-center align-middle">
                                    @(item.NgayTaoDon.HasValue ? item.NgayTaoDon.Value.ToString("dd/MM/yyyy") : "")
                                </td>
                                <td class="align-middle">@item.MaKhachHang</td>
                                <td class="align-middle">@item.TenKhachHang</td>
                                <td class="align-middle">@item.TenNhanVien</td>
                                <td class="align-middle">@item.TenNguoiTao</td>
                                <td class="text-center align-middle">
                                    @(item.ThoiHanGiaoHang.HasValue ? item.ThoiHanGiaoHang.Value.ToString("dd/MM/yyyy") : "")
                                </td>
                                <td class="text-end align-middle">
                                    @item.TongTien.ToString("N0")
                                </td>
                                <td class="text-center align-middle">
                                    @{
                                        string badgeClass = item.TrangThaiDon == 1 ? "bg-danger"
                                                          : item.TrangThaiDon == 2 ? "bg-warning text-dark"
                                                          : item.TrangThaiDon == 3 ? "bg-success"
                                                          : item.TrangThaiDon == 4 ? "bg-secondary"
                                                          : "bg-secondary";
                                    }
                                    <span class="badge @badgeClass">@item.TenTrangThai</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Chưa có đơn đặt hàng nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @Html.Partial("_Pagination", Model)
</div>
