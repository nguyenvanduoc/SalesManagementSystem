@model SalesManagementSystem.Models.Entities.PhongBan

@{
    Layout = null;
    ViewBag.Title = "Cập nhật phòng ban";
}

<div class="modal-header bg-light">
    <h5 class="modal-title fw-bold" style="color: #0b5b84;">
        <i class="bi bi-pencil-square me-2"></i> @ViewBag.Title
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

@using (Html.BeginForm("UpdatePhongBan", "PhongBan", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ID)
    
    <div class="modal-body p-4">
        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Mã phòng ban <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.MaPhongBan, new { @class = "form-control", required = "required", placeholder = "VD: PB001" })
                @Html.ValidationMessageFor(m => m.MaPhongBan, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Tên phòng ban <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.TenPhongBan, new { @class = "form-control", required = "required", placeholder = "VD: Phòng Kế Toán" })
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Số thứ tự</label>
                @Html.TextBoxFor(m => m.STT, new { @class = "form-control", type = "number", placeholder = "VD: 1" })
            </div>
        </div>
    </div>
    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn text-white px-4" style="background-color: #2998e4; border: none;">
            <i class="bi bi-save me-1"></i> Lưu thay đổi
        </button>
    </div>
}
