@model IEnumerable<SalesManagementSystem.Models.ViewModels.DonDieuChinhHistoryViewModel>

<div class="modal-header bg-light">
    <h5 class="modal-title fw-bold text-dark" style="font-size: 1.15rem;">
        <i class="bi bi-clock-history me-2 text-success"></i>Lịch sử điều chỉnh đơn hàng @ViewBag.SoDonHang
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4" style="max-height: 550px; overflow-y: auto;">
    @if (Model != null && Model.Any())
    {
        <div class="timeline">
            @foreach (var item in Model)
            {
                <div class="timeline-item mb-4 pb-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-primary fs-6">
                            <i class="bi bi-person-circle me-1 text-muted"></i>@item.TenNguoiTao
                        </span>
                        <span class="timeline-date fw-bold">
                            <i class="bi bi-calendar3 me-1"></i>@item.NgayDieuChinh.ToString("dd/MM/yyyy HH:mm:ss")
                        </span>
                    </div>
                    <div class="mb-2">
                        <span class="badge bg-danger p-1.5 mb-2" style="font-size: 0.8rem;">Số điều chỉnh: @item.SoDieuChinh</span>
                        @if (item.TrangThaiDon.HasValue)
                        {
                            string orderBadgeClass = item.TrangThaiDon == 1 ? "bg-danger"
                                               : item.TrangThaiDon == 2 ? "bg-warning text-dark"
                                               : item.TrangThaiDon == 3 ? "bg-success"
                                               : item.TrangThaiDon == 4 ? "bg-secondary"
                                               : "bg-secondary";
                            <span class="badge @orderBadgeClass p-1.5 mb-2 ms-1" style="font-size: 0.8rem;">Trạng thái đơn: @(item.TenTrangThai ?? "Không xác định")</span>
                        }
                        <div class="bg-light p-2.5 rounded border small mb-3">
                            <strong><i class="bi bi-chat-right-text me-1 text-secondary"></i>Lý do điều chỉnh:</strong> 
                            <span class="text-dark">@item.LyDoDieuChinh</span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0" style="font-size: 0.82rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã SP</th>
                                    <th>Tên sản phẩm</th>
                                    <th class="text-center" style="width: 110px;">Trạng thái</th>
                                    <th class="text-center" style="width: 50px;">ĐVT</th>
                                    <th class="text-center" style="width: 140px;">Số lượng</th>
                                    <th class="text-end" style="width: 160px;">Đơn giá</th>
                                    <th class="text-end" style="width: 180px;">Thành tiền sau thuế</th>
                                    <th>Ghi chú dòng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var det in item.ChiTiets)
                                {
                                    <tr>
                                        <td class="fw-semibold text-secondary">@det.MaSanPham</td>
                                        <td class="fw-semibold text-dark">@det.TenSanPham</td>
                                        <td class="text-center align-middle">
                                            @if (det.SoLuongCu == null || det.SoLuongCu == 0)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-plus-lg me-1"></i>Thêm mới</span>
                                            }
                                            else if (det.SoLuongMoi == null || det.SoLuongMoi == 0)
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-trash-fill me-1"></i>Xóa bỏ</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-pencil-fill me-1"></i>Thay đổi</span>
                                            }
                                        </td>
                                        <td class="text-center">@det.DVT</td>
                                        <td class="text-center">
                                            @if (det.SoLuongCu == null || det.SoLuongCu == 0)
                                            {
                                                <span class="text-success"><i class="bi bi-plus-lg me-1"></i>Thêm mới (@(Math.Round(det.SoLuongMoi ?? 0)))</span>
                                            }
                                            else if (det.SoLuongMoi == null || det.SoLuongMoi == 0)
                                            {
                                                <span class="text-danger"><i class="bi bi-trash-fill me-1"></i>Xóa bỏ (@(Math.Round(det.SoLuongCu ?? 0)))</span>
                                            }
                                            else
                                            {
                                                <span>@(Math.Round(det.SoLuongCu ?? 0)) <i class="bi bi-arrow-right mx-1 text-muted"></i> <strong class="@(det.SoLuongMoi > det.SoLuongCu ? "text-success" : "text-danger")">@(Math.Round(det.SoLuongMoi ?? 0))</strong></span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (det.DonGiaCu == null || det.DonGiaCu == 0)
                                            {
                                                <span>@((det.DonGiaMoi ?? 0).ToString("N0"))₫</span>
                                            }
                                            else
                                            {
                                                <span>@((det.DonGiaCu ?? 0).ToString("N0"))₫ <i class="bi bi-arrow-right mx-1 text-muted"></i> <strong>@((det.DonGiaMoi ?? 0).ToString("N0"))₫</strong></span>
                                            }
                                        </td>
                                        <td class="text-end fw-semibold">
                                            @if (det.ThanhTienCu == null || det.ThanhTienCu == 0)
                                            {
                                                <span class="text-success">+@((det.ThanhTienMoi ?? 0).ToString("N0"))₫</span>
                                            }
                                            else if (det.ThanhTienMoi == null || det.ThanhTienMoi == 0)
                                            {
                                                <span class="text-danger">-@((det.ThanhTienCu ?? 0).ToString("N0"))₫</span>
                                            }
                                            else
                                            {
                                                <span>@((det.ThanhTienCu ?? 0).ToString("N0"))₫ <i class="bi bi-arrow-right mx-1 text-muted"></i> <strong class="@(det.ThanhTienMoi > det.ThanhTienCu ? "text-success" : "text-danger")">@((det.ThanhTienMoi ?? 0).ToString("N0"))₫</strong></span>
                                            }
                                        </td>
                                        <td class="text-muted small">@det.GhiChu</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
            Chưa phát sinh lần điều chỉnh nào cho đơn hàng này.
        </div>
    }
</div>

<div class="modal-footer bg-light">
    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
</div>
