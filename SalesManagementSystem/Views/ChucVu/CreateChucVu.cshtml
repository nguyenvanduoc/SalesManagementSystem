@model SalesManagementSystem.Models.Entities.ChucVu

@{
    Layout = null;
    ViewBag.Title = "Thêm mới chức vụ";
}

<div class="modal-header bg-light">
    <h5 class="modal-title fw-bold" style="color: #0b5b84;">
        <i class="bi bi-plus-circle me-2"></i> @ViewBag.Title
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

@using (Html.BeginForm("CreateChucVu", "ChucVu", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="modal-body p-4">
        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Mã chức vụ <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.MaChucVu, new { @class = "form-control", required = "required", placeholder = "VD: CV001" })
                @Html.ValidationMessageFor(m => m.MaChucVu, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Tên chức vụ <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.TenChucVu, new { @class = "form-control", required = "required", placeholder = "VD: Giám đốc" })
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Số thứ tự</label>
                @Html.TextBoxFor(m => m.STT, new { @class = "form-control", type = "number", placeholder = "VD: 1" })
            </div>
        </div>
    </div>
    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn text-white px-4" style="background-color: #2998e4; border: none;">
            <i class="bi bi-save me-1"></i> Lưu thông tin
        </button>
    </div>
}
