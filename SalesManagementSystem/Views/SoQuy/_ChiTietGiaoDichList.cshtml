@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.GiaoDichChiTietViewModel>

<div class="card-body p-0">
    <div class="table-responsive" style="min-height: 300px; max-height: 450px;">
        <table class="table table-custom table-bordered table-hover mb-0" style="font-size: 0.85rem;">
            <thead>
                <tr>
                    <th width="40" class="text-center fw-bold">STT</th>
                    <th width="100" class="text-center fw-bold">Ngày giao dịch</th>
                    <th width="120" class="text-center fw-bold">Số chứng từ</th>
                    <th width="100" class="text-center fw-bold">Loại giao dịch</th>
                    <th class="fw-bold">Diễn giải</th>
                    <th width="120" class="text-end fw-bold">Thu</th>
                    <th width="120" class="text-end fw-bold">Chi</th>
                    <th width="130" class="text-end fw-bold">Số dư lũy kế</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center align-middle">@item.STT</td>
                            <td class="text-center align-middle">@item.NgayGiaoDich.ToString("dd/MM/yyyy")</td>
                            <td class="text-center align-middle fw-semibold text-primary">@item.SoChungTu</td>
                            <td class="text-center align-middle">
                                @if (item.LoaiChungTu == "THU" || item.LoaiChungTu == "PHIEU_THU")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Phiếu thu</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger">Phiếu chi</span>
                                }
                            </td>
                            <td class="align-middle text-wrap">@item.DienGiai</td>
                            <td class="text-end align-middle fw-semibold @(item.SoTienThu > 0 ? "text-success" : "text-muted")">
                                @(item.SoTienThu > 0 ? item.SoTienThu.ToString("N0") : "-")
                            </td>
                            <td class="text-end align-middle fw-semibold @(item.SoTienChi > 0 ? "text-danger" : "text-muted")">
                                @(item.SoTienChi > 0 ? item.SoTienChi.ToString("N0") : "-")
                            </td>
                            <td class="text-end align-middle fw-semibold" style="color: #0b5b84;">
                                @item.SoDuLuyKe.ToString("N0")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-journal-x fs-3 d-block mb-2 text-secondary"></i>
                            Không có giao dịch nào trong khoảng thời gian này
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal-pagination">
    @Html.Partial("_Pagination", Model)
</div>
