@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.TaiKhoanSummaryViewModel>

@{
    decimal tongDauKy = ViewBag.TongDauKy ?? 0M;
    decimal tongThu = ViewBag.TongThu ?? 0M;
    decimal tongChi = ViewBag.TongChi ?? 0M;
    decimal tongCuoiKy = ViewBag.TongCuoiKy ?? 0M;
}

<!-- Hidden fields for updating index dashboard counters in AJAX calls -->
<input type="hidden" id="table-tong-dau-ky" value="@tongDauKy" />
<input type="hidden" id="table-tong-thu" value="@tongThu" />
<input type="hidden" id="table-tong-chi" value="@tongChi" />
<input type="hidden" id="table-tong-cuoi-ky" value="@tongCuoiKy" />

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height:350px;">
            <table id="tblSoQuyList" class="table table-custom table-bordered table-hover mb-0" style="width:100%; min-width:1000px;">
                <thead>
                    <tr>
                        <th width="70" class="text-center fw-bold">Thao tác</th>
                        <th width="50"  class="text-center fw-bold">STT</th>
                        <th class="fw-bold">Tài khoản</th>
                        <th class="fw-bold">Ngân hàng</th>
                        <th width="130" class="fw-bold">Số tài khoản</th>
                        <th class="fw-bold">Chủ tài khoản</th>
                        <th width="140" class="text-end fw-bold">Số dư đầu kỳ</th>
                        <th width="130" class="text-end fw-bold">Thu trong kỳ</th>
                        <th width="130" class="text-end fw-bold">Chi trong kỳ</th>
                        <th width="140" class="text-end fw-bold">Số dư cuối kỳ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-link text-secondary dropdown-toggle dropdown-toggle-hide-arrow p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-grid-3x3-gap-fill" style="font-size: 1rem; color: #7f8c8d;"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow border-0" style="font-size: 0.85rem;">
                                            <li>
                                                <a class="dropdown-item py-2 view-detail-btn" href="#" data-id="@item.ID">
                                                    <i class="bi bi-eye text-primary me-2"></i> Xem chi tiết
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="align-middle">@item.TenTaiKhoan</td>
                                <td class="align-middle">@(string.IsNullOrEmpty(item.NganHang) ? "---" : item.NganHang)</td>
                                <td class="align-middle">@(string.IsNullOrEmpty(item.SoTaiKhoan) ? "---" : item.SoTaiKhoan)</td>
                                <td class="align-middle">@(string.IsNullOrEmpty(item.ChuTaiKhoan) ? "---" : item.ChuTaiKhoan)</td>
                                <td class="text-end align-middle fw-semibold text-primary">
                                    @item.SoDuDauKy.ToString("N0")
                                </td>
                                <td class="text-end align-middle fw-semibold text-success">
                                    @item.ThuTrongKy.ToString("N0")
                                </td>
                                <td class="text-end align-middle fw-semibold text-danger">
                                    @item.ChiTrongKy.ToString("N0")
                                </td>
                                <td class="text-end align-middle fw-semibold" style="color:#d35400;">
                                    @item.SoDuCuoiKy.ToString("N0")
                                </td>
                            </tr>
                        }

                        <!-- Dòng tổng cộng -->
                        <tr class="fw-bold" style="background:#f4f6f9;">
                            <td colspan="6" class="text-end align-middle">Tổng cộng:</td>
                            <td class="text-end align-middle text-primary">@tongDauKy.ToString("N0")</td>
                            <td class="text-end align-middle text-success">@tongThu.ToString("N0")</td>
                            <td class="text-end align-middle text-danger">@tongChi.ToString("N0")</td>
                            <td class="text-end align-middle" style="color:#d35400;">@tongCuoiKy.ToString("N0")</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                <i class="bi bi-journal-x fs-2 d-block mb-2 text-secondary"></i>
                                Không có dữ liệu tài khoản
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @Html.Partial("_Pagination", Model)
</div>

<style>
    #tblSoQuyList th {
        position: relative;
        background-clip: padding-box;
    }
    #tblSoQuyList th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblSoQuyList th .resizer:hover, #tblSoQuyList th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var table = document.getElementById('tblSoQuyList');
        if (!table) return;
        
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
            if(th.innerText.trim() === 'Thao tác' || th.innerText.trim() === 'STT') return;
            
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                
                e.preventDefault();
            });
        });
    })();
</script>
