@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.TaiKhoanSummaryViewModel>

@{
    ViewBag.Title = "Sổ Quỹ - Tài Khoản Thanh Toán";
    decimal tongDauKy = ViewBag.TongDauKy ?? 0M;
    decimal tongThu = ViewBag.TongThu ?? 0M;
    decimal tongChi = ViewBag.TongChi ?? 0M;
    decimal tongCuoiKy = ViewBag.TongCuoiKy ?? 0M;
}

<style>
    /* Style for Dashboard Cards */
    .stat-card-custom {
        background: #fff;
        border-radius: 10px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
        border: 1px solid #eaf0f6;
        transition: transform .2s, box-shadow .2s;
    }
    .stat-card-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }
    .stat-icon-custom {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }
    .stat-icon-custom.blue { background: #eaf4fb; color: #2e86c1; }
    .stat-icon-custom.green { background: #e8f8f5; color: #27ae60; }
    .stat-icon-custom.red { background: #fdedec; color: #e74c3c; }
    .stat-icon-custom.brown { background: #fef5e7; color: #d35400; }

    .stat-body-custom .label { font-size: .78rem; color: #7f8c8d; font-weight: 600; text-transform: uppercase; margin-bottom: 2px; }
    .stat-body-custom .value { font-size: 1.4rem; font-weight: 700; color: #2c3e50; line-height: 1.1; }
    .stat-body-custom .unit { font-size: .75rem; color: #95a5a6; font-weight: 500; margin-left: 3px; }

    /* Print styling */
    @@media print {
        .sidebar, .topbar, .tabs-wrapper, #searchForm, .no-print, .modal-footer, .custom-pagination, .btn, .breadcrumb-wrap {
            display: none !important;
        }
        .main-wrapper {
            margin-left: 0 !important;
            margin-top: 0 !important;
            padding: 0 !important;
        }
        .page-content {
            padding: 0 !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        table {
            width: 100% !important;
            border-collapse: collapse !important;
        }
        table th, table td {
            border: 1px solid #000 !important;
            padding: 6px !important;
        }
    }

    /* Fix Select2 height to match Bootstrap form-control-sm date inputs */
    .tab-pane .select2-container--default .select2-selection--single {
        height: 31px !important;
        border-color: #dee2e6 !important;
        padding-top: 1px !important;
    }
    .tab-pane .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 29px !important;
        font-size: 0.875rem !important;
        color: #212529 !important;
    }
    .tab-pane .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 29px !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <h4 class="mb-0 fw-bold text-uppercase" style="color:#0b5b84;font-size:1.25rem;">
        SỔ QUỸ - TÀI KHOẢN THANH TOÁN
    </h4>
    <div class="d-flex gap-2">
        <button type="button" class="btn text-white fw-bold px-3 d-flex align-items-center gap-1 btn-export-excel" style="background:#2ecc71;border:none;">
            <i class="bi bi-file-earmark-excel"></i> Xuất Excel (SQ01)
        </button>
        <button type="button" class="btn btn-outline-secondary fw-semibold px-3 d-flex align-items-center gap-1 btn-print-report" style="border-color:#d0d7de;color:#24292f;background-color:#fff;">
            <i class="bi bi-printer"></i> In báo cáo
        </button>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card shadow-sm mb-4 no-print">
    <div class="card-body">
        <form method="get" action="@Url.Action("GetList","SoQuy")" id="searchForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-muted small mb-1 fw-semibold">Từ ngày (*)</label>
                    <input type="date" class="form-control form-control-sm" name="tuNgay" id="tuNgay" value="@ViewBag.TuNgay" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small mb-1 fw-semibold">Đến ngày (*)</label>
                    <input type="date" class="form-control form-control-sm" name="denNgay" id="denNgay" value="@ViewBag.DenNgay" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small mb-1 fw-semibold">Tài khoản thanh toán</label>
                    <select class="form-select form-select-sm select2" name="idTaiKhoanThanhToan" id="idTaiKhoanThanhToan">
                        <option value="">-- Tất cả --</option>
                        @if (ViewBag.TaiKhoanList != null)
                        {
                            foreach (System.Web.Mvc.SelectListItem item in ViewBag.TaiKhoanList)
                            {
                                <option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn text-white" style="background:#2998e4">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <a class="btn text-white btn-reset" style="background:#f1c40f">
                        Làm mới
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Dashboard Cards -->
<div class="row g-3 mb-4" id="dashboard-cards">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-custom">
            <div class="stat-icon-custom blue"><i class="bi bi-bank"></i></div>
            <div class="stat-body-custom">
                <div class="label">Số dư đầu kỳ</div>
                <div class="value text-primary">@tongDauKy.ToString("N0")<span class="unit">VND</span></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-custom">
            <div class="stat-icon-custom green"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="stat-body-custom">
                <div class="label">Thu trong kỳ</div>
                <div class="value text-success">@tongThu.ToString("N0")<span class="unit">VND</span></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-custom">
            <div class="stat-icon-custom red"><i class="bi bi-graph-down-arrow"></i></div>
            <div class="stat-body-custom">
                <div class="label">Chi trong kỳ</div>
                <div class="value text-danger">@tongChi.ToString("N0")<span class="unit">VND</span></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-custom">
            <div class="stat-icon-custom brown"><i class="bi bi-credit-card-2-back"></i></div>
            <div class="stat-body-custom">
                <div class="label">Số dư cuối kỳ</div>
                <div class="value" style="color:#d35400;">@tongCuoiKy.ToString("N0")<span class="unit">VND</span></div>
            </div>
        </div>
    </div>
</div>

<!-- Grid dữ liệu -->
<div id="table-container">
    @Html.Partial("_SoQuyList", Model)
</div>

<!-- Modal Popup Xem chi tiết -->
<div class="modal fade" id="chiTietModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-scrollable" style="max-width: 95%; width: 95%;">
        <div class="modal-content shadow-lg border-0" id="chiTietModalContent">
            <!-- AJAX content will load here -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var $pane = $('script').last().closest('.tab-pane');
            if ($pane.length === 0) $pane = $('#searchForm').closest('.tab-pane');
            if ($pane.length === 0) $pane = $('body');

            // Reset filters to defaults and reload

            // Client side validation on search
            $pane.off('submit.soquy_search', '#searchForm');
            $pane.on('submit.soquy_search', '#searchForm', function (e) {
                var tu = $pane.find('#tuNgay').val();
                var den = $pane.find('#denNgay').val();
                if (!tu || !den) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    if (typeof showToast === 'function') {
                        showToast('warning', 'Vui lòng chọn khoảng thời gian tra cứu.');
                    }
                    return false;
                }
            });

            // Export Excel dynamic trigger
            $pane.off('click.soquy_excel', '.btn-export-excel');
            $pane.on('click.soquy_excel', '.btn-export-excel', function () {
                var tu = $pane.find('#tuNgay').val();
                var den = $pane.find('#denNgay').val();
                var acc = $pane.find('#idTaiKhoanThanhToan').val();
                if (!tu || !den) {
                    if (typeof showToast === 'function') {
                        showToast('warning', 'Vui lòng chọn khoảng thời gian tra cứu.');
                    }
                    return;
                }
                var url = '@Url.Action("ExportExcelTongHop", "SoQuy")' + '?tuNgay=' + tu + '&denNgay=' + den + '&idTaiKhoanThanhToan=' + acc;
                window.location.href = url;
            });

            // Print report trigger
            $pane.off('click.soquy_print', '.btn-print-report');
            $pane.on('click.soquy_print', '.btn-print-report', function () {
                var tu = $pane.find('#tuNgay').val();
                var den = $pane.find('#denNgay').val();
                if (!tu || !den) {
                    if (typeof showToast === 'function') {
                        showToast('warning', 'Vui lòng chọn khoảng thời gian tra cứu.');
                    }
                    return;
                }
                window.print();
            });

            // Modal detail action handler
            window.viewSoQuyDetail = function (accId, btn) {
                var $pane = $(btn).closest('.tab-pane');
                if ($pane.length === 0) $pane = $('#searchForm').closest('.tab-pane');
                if ($pane.length === 0) $pane = $('body');

                var tu = $pane.find('#tuNgay').val();
                var den = $pane.find('#denNgay').val();

                if (!tu || !den) {
                    if (typeof showToast === 'function') {
                        showToast('warning', 'Vui lòng chọn khoảng thời gian tra cứu.');
                    }
                    return;
                }

                // Show loading
                var modalEl = $pane.find('#chiTietModal')[0];
                if (!modalEl) modalEl = document.getElementById('chiTietModal');

                var $modalContent = $pane.find('#chiTietModalContent');
                if ($modalContent.length === 0) $modalContent = $('#chiTietModalContent');

                $modalContent.html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
                
                var myModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                myModal.show();

                // Fetch details
                $.ajax({
                    url: '/SoQuy/Details',
                    type: 'GET',
                    data: {
                        idTaiKhoanThanhToan: accId,
                        tuNgay: tu,
                        denNgay: den
                    },
                    success: function (html) {
                        $modalContent.html(html);
                    },
                    error: function (xhr) {
                        var msg = 'Lỗi tải chi tiết tài khoản';
                        if (xhr.status === 403) msg = 'Không có quyền truy cập';
                        $modalContent.html('<div class="modal-body p-4 text-center text-danger"><i class="bi bi-exclamation-triangle-fill fs-1"></i><p class="mt-2">' + msg + '</p><button class="btn btn-sm btn-secondary mt-3" data-bs-dismiss="modal">Đóng</button></div>');
                    }
                });
            };

            // Update stats when grid finishes loading via AJAX
            $(document).off('tabContentLoaded.soquy');
            $(document).on('tabContentLoaded.soquy', function (e, paneId) {
                var currentPane = $('#' + paneId);
                // Cập nhật lại số liệu dashboard khi search AJAX
                if (paneId.indexOf('tab-so-quy') > -1 || currentPane.find('#dashboard-cards').length > 0) {
                    var $list = currentPane.find('.table-custom tbody tr');
                    if ($list.length > 0 && !$list.first().find('td').hasClass('text-muted')) {
                        // Gọi lại endpoint lấy dashboard mới hoặc load từ DOM nếu có chứa thông tin
                        // Chúng ta sẽ lấy từ server (nhẹ hơn) hoặc render kèm ViewBag ở list và copy lên Index
                        var tongDauKy = currentPane.find('#table-tong-dau-ky').val();
                        var tongThu = currentPane.find('#table-tong-thu').val();
                        var tongChi = currentPane.find('#table-tong-chi').val();
                        var tongCuoiKy = currentPane.find('#table-tong-cuoi-ky').val();

                        if (tongDauKy !== undefined) {
                            $pane.find('#dashboard-cards .blue .value').html(formatNumber(tongDauKy) + '<span class="unit">VND</span>');
                            $pane.find('#dashboard-cards .green .value').html(formatNumber(tongThu) + '<span class="unit">VND</span>');
                            $pane.find('#dashboard-cards .red .value').html(formatNumber(tongChi) + '<span class="unit">VND</span>');
                            $pane.find('#dashboard-cards .brown .value').html(formatNumber(tongCuoiKy) + '<span class="unit">VND</span>');
                        }
                    }
                }
            });

            function formatNumber(num) {
                if (!num) return '0';
                return parseFloat(num).toLocaleString('vi-VN');
            }
        })();
    </script>
}
