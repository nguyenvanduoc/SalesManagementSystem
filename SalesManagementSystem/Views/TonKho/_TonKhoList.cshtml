@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.TonKhoListViewModel>

@{
    decimal tongTonDauKy = ViewBag.TongTonDauKy != null ? (decimal)ViewBag.TongTonDauKy : (Model.Items != null ? Model.Items.Sum(x => x.TonDauKy) : 0M);
    decimal tongTongNhap = ViewBag.TongTongNhap != null ? (decimal)ViewBag.TongTongNhap : (Model.Items != null ? Model.Items.Sum(x => x.TongNhap) : 0M);
    decimal tongTongXuat = ViewBag.TongTongXuat != null ? (decimal)ViewBag.TongTongXuat : (Model.Items != null ? Model.Items.Sum(x => x.TongXuat) : 0M);
    decimal tongTonKho = ViewBag.TongTonKho != null ? (decimal)ViewBag.TongTonKho : (Model.Items != null ? Model.Items.Sum(x => x.TonKho) : 0M);
    decimal tongGiaTriTon = ViewBag.TongGiaTriTon != null ? (decimal)ViewBag.TongGiaTriTon : (Model.Items != null ? Model.Items.Sum(x => x.GiaTriTon) : 0M);
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height:350px;">
            <table id="tblTonKho" class="table table-custom table-bordered table-hover mb-0">
                <thead>
                    <tr>
                        <th width="70" class="text-center fw-bold">Thao tác</th>
                        <th width="50" class="text-center fw-bold">STT</th>
                        <th class="fw-bold">Mã kho</th>
                        <th class="fw-bold">Tên kho</th>
                        <th class="fw-bold">Mã sản phẩm</th>
                        <th class="fw-bold">Tên sản phẩm</th>
                        <th class="fw-bold">ĐVT</th>
                        <th width="110" class="text-end fw-bold">Tồn đầu kỳ</th>
                        <th width="110" class="text-end fw-bold">Tổng nhập</th>
                        <th width="110" class="text-end fw-bold">Tổng xuất</th>
                        <th width="120" class="text-end fw-bold">Tồn hiện tại</th>
                        @if (ViewBag.IsNhanVienKho != true)
                        {
                            <th width="120" class="text-end fw-bold">Đơn giá tồn</th>
                            <th width="140" class="text-end fw-bold">Giá trị tồn</th>
                        }
                        <th class="fw-bold">Ngày nhập cuối</th>
                        <th class="fw-bold">Ngày xuất cuối</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 6px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow border-0" style="font-size: 0.85rem;">
                                            <li>
                                                <a class="dropdown-item py-2 btn-view-thekho" href="#" data-idkho="@item.IDKho" data-idsp="@item.IDSanPham">
                                                    <i class="bi bi-eye text-primary me-2"></i> Xem thẻ kho
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="align-middle">@item.MaKho</td>
                                <td class="align-middle">@item.TenKho</td>
                                <td class="align-middle">@item.MaSanPham</td>
                                <td class="align-middle">@item.TenSanPham</td>
                                <td class="align-middle">@item.DVT</td>
                                <td class="text-end align-middle fw-semibold">@item.TonDauKy.ToString("N0")</td>
                                <td class="text-end align-middle fw-semibold">@item.TongNhap.ToString("N0")</td>
                                <td class="text-end align-middle fw-semibold">@item.TongXuat.ToString("N0")</td>
                                <td class="text-end align-middle">
                                    @if (item.TonKho < 0)
                                    {
                                        <span class="text-danger fw-bold">@item.TonKho.ToString("N0")</span>
                                    }
                                    else if (item.TonKho <= 10)
                                    {
                                        <span class="text-warning fw-bold">@item.TonKho.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold">@item.TonKho.ToString("N0")</span>
                                    }
                                </td>
                                @if (ViewBag.IsNhanVienKho != true)
                                {
                                    <td class="text-end align-middle fw-semibold">@item.DonGiaTon.ToString("N0")</td>
                                    <td class="text-end align-middle fw-semibold text-primary">@item.GiaTriTon.ToString("N0")</td>
                                }
                                <td class="align-middle">@(item.NgayNhapCuoi.HasValue ? item.NgayNhapCuoi.Value.ToString("dd/MM/yyyy") : "")</td>
                                <td class="align-middle">@(item.NgayXuatCuoi.HasValue ? item.NgayXuatCuoi.Value.ToString("dd/MM/yyyy") : "")</td>
                            </tr>
                        }
                        
                        <!-- Dòng tổng cộng -->
                        <tr class="fw-bold" style="background:#f4f6f9;">
                            <td colspan="7" class="text-end align-middle">Tổng cộng:</td>
                            <td class="text-end align-middle text-dark">@tongTonDauKy.ToString("N0")</td>
                            <td class="text-end align-middle text-dark">@tongTongNhap.ToString("N0")</td>
                            <td class="text-end align-middle text-dark">@tongTongXuat.ToString("N0")</td>
                            <td class="text-end align-middle">
                                @if (tongTonKho < 0)
                                {
                                    <span class="text-danger fw-bold">@tongTonKho.ToString("N0")</span>
                                }
                                else if (tongTonKho <= 10)
                                {
                                    <span class="text-warning fw-bold">@tongTonKho.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="text-success fw-bold">@tongTonKho.ToString("N0")</span>
                                }
                            </td>
                            @if (ViewBag.IsNhanVienKho != true)
                            {
                                <td></td>
                                <td class="text-end align-middle text-primary">@tongGiaTriTon.ToString("N0")</td>
                            }
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(ViewBag.IsNhanVienKho == true ? 13 : 15)" class="text-center text-muted py-4">
                                <i class="bi bi-journal-x fs-2 d-block mb-2 text-secondary"></i>
                                Không có dữ liệu tồn kho
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @Html.Partial("_Pagination", Model)
</div>

<style>
    #tblTonKho th {
        position: relative;
        background-clip: padding-box;
    }
    #tblTonKho th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblTonKho th .resizer:hover, #tblTonKho th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var table = document.getElementById('tblTonKho');
        if (!table) return;
        
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            // Không áp dụng cho cột thao tác (cột đầu tiên không có chữ)
            if(th.innerText.trim() === 'Thao tác' && th.style.width === '70px') return;
            
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                
                e.preventDefault();
            });
        });
    })();
</script>
