@{
    ViewBag.Title = "Tồn kho";
    var uid = Guid.NewGuid().ToString("N");
}

<style>
    /* Style for Dashboard Cards */
    .stat-card-custom {
        background: #fff;
        border-radius: 10px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
        border: 1px solid #eaf0f6;
        transition: transform .2s, box-shadow .2s;
        margin-bottom: 15px;
    }
    .stat-card-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }
    .stat-icon-custom {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }
    .stat-icon-custom.blue { background: #eaf4fb; color: #2e86c1; }
    .stat-icon-custom.green { background: #e8f8f5; color: #27ae60; }
    .stat-icon-custom.red { background: #fdedec; color: #e74c3c; }
    .stat-icon-custom.brown { background: #fef5e7; color: #d35400; }
    .stat-icon-custom.orange { background: #fff5e6; color: #f39c12; }

    .stat-body-custom .label { font-size: .78rem; color: #7f8c8d; font-weight: 600; text-transform: uppercase; margin-bottom: 2px; }
    .stat-body-custom .value { font-size: 1.4rem; font-weight: 700; color: #2c3e50; line-height: 1.1; }
    .stat-body-custom .unit { font-size: .75rem; color: #95a5a6; font-weight: 500; margin-left: 3px; }

    /* Print styling */
    @@media print {
        .sidebar, .topbar, .tabs-wrapper, #searchForm, .no-print, .modal-footer, .custom-pagination, .btn, .breadcrumb-wrap {
            display: none !important;
        }
        .main-wrapper {
            margin-left: 0 !important;
            margin-top: 0 !important;
            padding: 0 !important;
        }
        .page-content {
            padding: 0 !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        table {
            width: 100% !important;
            border-collapse: collapse !important;
        }
        table th, table td {
            border: 1px solid #000 !important;
            padding: 6px !important;
        }
    }

    /* Style select2 to match form-control-sm height (31px) */
    #tonkho-@uid .select2-container--default .select2-selection--single {
        height: 31px !important;
        border: 1px solid #ced4da !important;
        border-radius: 0.25rem !important;
        display: flex !important;
        align-items: center !important;
    }
    #tonkho-@uid .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 29px !important;
        padding-left: 8px !important;
        color: #212529 !important;
        font-size: 0.875rem !important;
    }
    #tonkho-@uid .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 29px !important;
    }
    #tonkho-@uid .select2-container--default .select2-selection--single .select2-selection__clear {
        height: 29px !important;
        line-height: 29px !important;
    }
</style>

<div id="tonkho-@uid">
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">
            BÁO CÁO TỒN KHO
        </h4>
        <div class="d-flex gap-2">

            <button type="button" class="btn btn-outline-secondary fw-semibold px-3 d-flex align-items-center gap-1 btn-print-multi" style="border-color:#d0d7de;color:#24292f;background-color:#fff;">
                <i class="bi bi-printer"></i> In chi tiết (Thẻ kho)
            </button>
            <button type="button" class="btn text-white fw-bold px-3 d-flex align-items-center gap-1 btn-export" style="background:#2ecc71;border:none;">
                <i class="bi bi-file-earmark-excel"></i> Xuất Excel
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm mb-4 no-print">
                <div class="card-body">
                    <form id="searchForm" method="get" action="@Url.Action("GetList")" class="row align-items-end g-3">
                        <div class="col-md-2">
                            <label class="form-label text-muted small mb-1 fw-semibold">Thời gian</label>
                            <select class="form-select form-select-sm ddl-thoi-gian">
                                <option value="current_month">Đầu tháng đến hiện tại</option>
                                <option value="month_1">Tháng 1</option>
                                <option value="month_2">Tháng 2</option>
                                <option value="month_3">Tháng 3</option>
                                <option value="month_4">Tháng 4</option>
                                <option value="month_5">Tháng 5</option>
                                <option value="month_6">Tháng 6</option>
                                <option value="month_7">Tháng 7</option>
                                <option value="month_8">Tháng 8</option>
                                <option value="month_9">Tháng 9</option>
                                <option value="month_10">Tháng 10</option>
                                <option value="month_11">Tháng 11</option>
                                <option value="month_12">Tháng 12</option>
                                <option value="quarter_1">Quý 1</option>
                                <option value="quarter_2">Quý 2</option>
                                <option value="quarter_3">Quý 3</option>
                                <option value="quarter_4">Quý 4</option>
                            <option value="current_year">Từ đầu năm đến hiện tại</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted small mb-1 fw-semibold">Từ ngày (*)</label>
                            <input type="date" class="form-control form-control-sm" name="tuNgay" id="tuNgay" value="@ViewBag.TuNgay" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted small mb-1 fw-semibold">Đến ngày (*)</label>
                            <input type="date" class="form-control form-control-sm" name="denNgay" id="denNgay" value="@ViewBag.DenNgay" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted small mb-1 fw-semibold">Kho hàng</label>
                            <select class="form-select form-select-sm tk-kho select2" name="IDKho" id="idKho" style="width: 100%"></select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label text-muted small mb-1 fw-semibold">Sản phẩm</label>
                            <select class="form-select form-select-sm tk-sp select2" name="IDSanPham" id="idSanPham" style="width: 100%"></select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end mb-1">
                            <div class="form-check w-100">
                                <input class="form-check-input" type="checkbox" id="ChiConTon_@uid" name="ChiConTon" value="true">
                                <label for="ChiConTon_@uid" class="form-check-label small fw-semibold text-muted">Chỉ hiển thị SP còn tồn</label>
                            </div>
                        </div>
                        <div class="col-12 d-flex gap-2 justify-content-end mt-2">
                            <button type="button" class="btn text-white btn-search" style="background-color: #2998e4; border: none;">
                                <i class="bi bi-search"></i> Tìm kiếm
                            </button>
                            <button type="button" class="btn text-white btn-reset" style="background-color: #f1c40f; border: none;">
                                Làm mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Dashboard Cards -->
            <div class="row g-3 mb-4" id="dashboardContainer">
                <div class="col-12 col-sm-6 @(ViewBag.IsNhanVienKho == true ? "col-xl-3" : "col-xl-2")">
                    <div class="stat-card-custom">
                        <div class="stat-icon-custom blue"><i class="bi bi-box-seam"></i></div>
                        <div class="stat-body-custom">
                            <div class="label">Tổng số sản phẩm</div>
                            <div class="value text-primary"><span class="lblTongSP">0</span><span class="unit"> SP</span></div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 @(ViewBag.IsNhanVienKho == true ? "col-xl-3" : "col-xl-2")">
                    <div class="stat-card-custom">
                        <div class="stat-icon-custom green"><i class="bi bi-boxes"></i></div>
                        <div class="stat-body-custom">
                            <div class="label">Tổng số lượng tồn</div>
                            <div class="value text-success"><span class="lblTongTon">0</span></div>
                        </div>
                    </div>
                </div>
                @if (ViewBag.IsNhanVienKho != true)
                {
                    <div class="col-12 col-sm-12 col-xl-4">
                        <div class="stat-card-custom">
                            <div class="stat-icon-custom brown"><i class="bi bi-cash-stack"></i></div>
                            <div class="stat-body-custom">
                                <div class="label">Tổng giá trị tồn</div>
                                <div class="value" style="color:#d35400;"><span class="lblTongGiaTri">0</span><span class="unit"> VND</span></div>
                            </div>
                        </div>
                    </div>
                }
                <div class="col-12 col-sm-6 @(ViewBag.IsNhanVienKho == true ? "col-xl-3" : "col-xl-2")">
                    <div class="stat-card-custom">
                        <div class="stat-icon-custom red"><i class="bi bi-dash-circle"></i></div>
                        <div class="stat-body-custom">
                            <div class="label">Sản phẩm âm kho</div>
                            <div class="value text-danger"><span class="lblAmKho">0</span><span class="unit"> SP</span></div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 @(ViewBag.IsNhanVienKho == true ? "col-xl-3" : "col-xl-2")">
                    <div class="stat-card-custom">
                        <div class="stat-icon-custom orange"><i class="bi bi-exclamation-triangle"></i></div>
                        <div class="stat-body-custom">
                            <div class="label">Sắp hết hàng</div>
                            <div class="value" style="color:#f39c12;"><span class="lblSapHet">0</span><span class="unit"> SP</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid dữ liệu -->
            <div id="table-container">
            </div>
        </div>
    </div>

    <div id="modalContainer">
        <!-- Static Modal for Thẻ kho -->
        <div class="modal fade" id="theKhoModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-xl" role="document">
                <div class="modal-content" id="theKhoModalContent">
                    <!-- Content loaded via AJAX -->
                </div>
            </div>
        </div>
    </div>

    <script>
        (function() {
            var $container = $('#tonkho-@uid');
            var $form = $container.find('#searchForm');

            $form.on('submit', function (e) {
                e.preventDefault();
                e.stopPropagation();
                loadData();
            });

            function formatNumber(num) {
                if (num == null || num === '') return '0';
                return num.toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1,');
            }

            function loadData(urlOverride) {
                var tu = $container.find('[name="tuNgay"]').val();
                var den = $container.find('[name="denNgay"]').val();
                if (!tu || !den) {
                    if (typeof showToast === 'function') {
                        showToast('warning', 'Vui lòng chọn khoảng thời gian tra cứu.');
                    }
                    return;
                }

                var params = $form.serialize();

                $.get('/TonKho/GetDashboard', params, function (res) {
                    if (res.success && res.data) {
                        $container.find('.lblTongSP').text(formatNumber(res.data.TongSoSanPham));
                        $container.find('.lblTongTon').text(formatNumber(res.data.TongSoLuongTon));
                        $container.find('.lblTongGiaTri').text(formatNumber(res.data.TongGiaTriTon));
                        $container.find('.lblAmKho').text(formatNumber(res.data.SoSanPhamAmKho));
                        $container.find('.lblSapHet').text(formatNumber(res.data.SoSanPhamSapHetHang));
                    }
                });

                var url = urlOverride || ('/TonKho/GetList?' + params);
                $.get(url, function (html) {
                    $container.find('#table-container').html(html);
                });
            }

            // Xử lý phân trang
            $container.on('click', '.ajax-link', function (e) {
                e.preventDefault();
                var url = $(this).attr('href');
                if (url && url !== '#') {
                    loadData(url);
                }
            });
            
            $container.on('change', '.page-size-select', function() {
                var newSize = $(this).val();
                var params = $form.serialize();
                loadData('/TonKho/GetList?' + params + '&pageSize=' + newSize + '&page=1');
            });

            $(document).ready(function () {
                var $tkKho = $container.find('.tk-kho');
                var $tkSp = $container.find('.tk-sp');

                $tkKho.select2({
                    placeholder: 'Chọn kho hàng',
                    allowClear: true,
                    dropdownParent: $container,
                    width: '100%',
                    ajax: {
                        url: '/TonKho/SearchKhoHang',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { q: params.term }; },
                        processResults: function (data) { return { results: data }; }
                    }
                });

                $tkSp.select2({
                    placeholder: 'Chọn sản phẩm',
                    allowClear: true,
                    dropdownParent: $container,
                    width: '100%',
                    ajax: {
                        url: '/TonKho/SearchSanPham',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { q: params.term }; },
                        processResults: function (data) { return { results: data }; }
                    }
                });

                loadData();
            });

            $container.find('.btn-search').on('click', function() {
                loadData();
            });

            $container.find('.btn-reset').on('click', function() {
                var now = new Date();
                var y = now.getFullYear();
                var m = now.getMonth();
                var firstDay = new Date(y, m, 1);
                var lastDay = new Date(y, m + 1, 0);

                var pad = function(num) { return (num < 10 ? '0' : '') + num; };

                $container.find('[name="tuNgay"]').val(y + '-' + pad(firstDay.getMonth() + 1) + '-' + pad(firstDay.getDate()));
                $container.find('[name="denNgay"]').val(y + '-' + pad(lastDay.getMonth() + 1) + '-' + pad(lastDay.getDate()));

                $container.find('.tk-kho').val(null).trigger('change');
                $container.find('.tk-sp').val(null).trigger('change');
                $container.find('.ddl-thoi-gian').val('current_year');
                $container.find('input[type="checkbox"]').prop('checked', false);
                loadData();
            });

            $container.find('.btn-export').on('click', function() {
                var tu = $container.find('[name="tuNgay"]').val();
                var den = $container.find('[name="denNgay"]').val();
                if (!tu || !den) {
                    if (typeof showToast === 'function') {
                        showToast('warning', 'Vui lòng chọn khoảng thời gian tra cứu.');
                    }
                    return;
                }
                var params = $form.serialize();
                window.location.href = '/TonKho/ExportExcel?' + params;
            });

            $container.find('.btn-print').on('click', function() {
                var tu = $container.find('[name="tuNgay"]').val();
                var den = $container.find('[name="denNgay"]').val();
                if (!tu || !den) {
                    if (typeof showToast === 'function') {
                        showToast('warning', 'Vui lòng chọn khoảng thời gian tra cứu.');
                    }
                    return;
                }
                var params = $form.serialize();
                window.open('/TonKho/Print?' + params, '_blank');
            });

            $container.find('.btn-print-multi').on('click', function() {
                var tu = $container.find('[name="tuNgay"]').val();
                var den = $container.find('[name="denNgay"]').val();
                if (!tu || !den) {
                    if (typeof showToast === 'function') {
                        showToast('warning', 'Vui lòng chọn khoảng thời gian tra cứu.');
                    }
                    return;
                }
                var params = $form.serialize();
                window.open('/TonKho/PrintTheKhoMulti?' + params, '_blank');
            });

            $container.on('click', '.btn-view-thekho', function() {
                var idKho = $(this).data('idkho');
                var idSanPham = $(this).data('idsp');
                var tuNgay = $form.find('[name="tuNgay"]').val();
                var denNgay = $form.find('[name="denNgay"]').val();
                if (!tuNgay || !denNgay) {
                    if (typeof showToast === 'function') {
                        showToast('warning', 'Vui lòng chọn khoảng thời gian tra cứu.');
                    }
                    return;
                }

                // Show loading spinner instantly inside static modal
                var modalEl = document.getElementById('theKhoModal');
                var $modalContent = $container.find('#theKhoModalContent');
                $modalContent.html(
                    '<div class="modal-header bg-light">' +
                    '    <h5 class="modal-title fw-bold text-uppercase" style="color: #0b5b84;"><i class="fas fa-list-alt"></i> Chi tiết thẻ kho</h5>' +
                    '    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>' +
                    '</div>' +
                    '<div class="modal-body text-center py-5">' +
                    '    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>' +
                    '    <p class="text-muted mt-2">Đang tải dữ liệu thẻ kho, vui lòng đợi...</p>' +
                    '</div>'
                );

                var myModal = bootstrap.Modal.getInstance(modalEl);
                if (!myModal) {
                    myModal = new bootstrap.Modal(modalEl);
                }
                myModal.show();

                $.get('/TonKho/GetTheKho', { idKho: idKho, idSanPham: idSanPham, tuNgay: tuNgay, denNgay: denNgay }, function (html) {
                    var tempDiv = $('<div>').html(html);
                    var modalInnerContent = tempDiv.find('.modal-content').html();
                    $modalContent.html(modalInnerContent);

                    $modalContent.find('#tblTheKho').DataTable({
                        "language": { "url": "//cdn.datatables.net/plug-ins/1.10.20/i18n/Vietnamese.json" },
                        "paging": false,
                        "ordering": false,
                        "info": false,
                        "scrollY": "400px",
                        "scrollCollapse": true
                    });
                });
            });
        })();
    </script>
</div>
