@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.DonHangChungTuViewModel>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height: 350px;">
            <table id="tblChungTuBanHangList" class="table table-custom table-bordered table-hover align-middle mb-0" style="width:100%; min-width:1350px;">
                <thead>
                    <tr style="background:#f4f6f9; font-weight:bold;">
                        <th class="text-center" style="width: 35px;"></th>
                        <th class="text-center" style="width: 60px;">Thao tác</th>
                        <th class="text-center" style="width: 50px;">STT</th>
                        <th>Số đơn hàng</th>
                        <th class="text-center">Ngày lập đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Thông tin xe</th>
                        <th class="text-end">Tổng tiền hàng</th>
                        <th class="text-end">Phí bốc xếp</th>
                        <th class="text-end">Tổng thanh toán</th>
                        <th>Số chứng từ</th>
                        <th class="text-center">Ngày chứng từ</th>
                        <th class="text-center">Trạng thái chứng từ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr class="ctbh-row" data-id="@(item.IDChungTuBanHang ?? 0)" data-iddondathang="@item.IDDonDatHang" style="cursor: pointer;">
                                <td class="text-center align-middle">
                                    <i class="bi bi-caret-right-fill text-muted toggle-icon" style="font-size: 0.95rem;"></i>
                                </td>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 6px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>
                                            <li><hr class="dropdown-divider"></li>
                                            
                                            @if (item.IDChungTuBanHang.HasValue)
                                            {
                                                <li>
                                                    <a class="dropdown-item text-primary no-ajax" href="@Url.Action("ExportExcel", "ChungTuBanHang", new { id = item.IDChungTuBanHang })" target="_blank">
                                                        <i class="bi bi-file-earmark-excel me-2"></i> Xuất phiếu
                                                    </a>
                                                </li>
                                            }

                                            @if ((item.TrangThaiChungTu == 1 || item.TrangThaiChungTu == null || item.TrangThaiChungTu == 0) && SalesManagementSystem.Helpers.PermissionHelper.HasPermission("ChungTuBanHang", SalesManagementSystem.Helpers.LoaiPhanQuyen.TuyChon))
                                            {
                                                if (item.TrangThaiChungTu == 1)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item text-success" onclick="ghiSoChungTu(this, @item.IDChungTuBanHang)">
                                                            <i class="bi bi-check-circle me-2 text-success"></i> Ghi dữ liệu
                                                        </button>
                                                    </li>
                                                }
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger" onclick="huyChungTu(this, @(item.IDChungTuBanHang ?? 0), @item.IDDonDatHang)">
                                                        <i class="bi bi-x-circle me-2 text-danger"></i> Hủy
                                                    </button>
                                                </li>
                                            }
                                            @if (item.IDChungTuBanHang.HasValue && (item.TrangThaiChungTu == 2 || item.TrangThaiChungTu == 3) && SalesManagementSystem.Helpers.PermissionHelper.HasPermission("ChungTuBanHang", SalesManagementSystem.Helpers.LoaiPhanQuyen.TuyChon))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-warning" onclick="boGhiChungTu(this, @item.IDChungTuBanHang)">
                                                        <i class="bi bi-arrow-counterclockwise me-2 text-warning"></i> Bỏ ghi
                                                    </button>
                                                </li>
                                            }
                                                @if (!item.IDChungTuBanHang.HasValue)
                                                {
                                                    <li><span class="dropdown-item text-muted small">Không có thao tác</span></li>
                                                }
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="align-middle fw-bold">
                                    @if (item.IDChungTuBanHang.HasValue)
                                    {
                                        if (item.TrangThaiChungTu == 2 || item.TrangThaiChungTu == 3)
                                        {
                                            <a href="@Url.Action("Detail", "ChungTuBanHang", new { id = item.IDChungTuBanHang })" class="text-decoration-none">@item.SoDonHang</a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Edit", "ChungTuBanHang", new { id = item.IDChungTuBanHang })" class="text-decoration-none">@item.SoDonHang</a>
                                        }
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Create", "ChungTuBanHang", new { idDonDatHang = item.IDDonDatHang })" class="text-decoration-none text-success" title="Lập chứng từ bán hàng">@item.SoDonHang <i class="bi bi-plus-circle"></i></a>
                                    }
                                </td>
                                <td class="text-center align-middle">@(item.NgayTaoDon?.ToString("dd/MM/yyyy"))</td>
                                <td class="align-middle">@item.TenKhachHang</td>
                                <td class="align-middle">@item.HoTenTaiXe</td>
                                <td class="text-end align-middle text-dark">@(item.ThanhTienHang > 0 ? item.ThanhTienHang.ToString("N0") : "0")</td>
                                <td class="text-end align-middle text-dark">@(item.PhiBocXep > 0 ? item.PhiBocXep.ToString("N0") : "0")</td>
                                <td class="text-end align-middle text-dark">@(item.TongTien > 0 ? item.TongTien.ToString("N0") : "0")</td>
                                <td class="align-middle">@item.SoChungTu</td>
                                <td class="text-center align-middle">@(item.NgayChungTu?.ToString("dd/MM/yyyy"))</td>
                                <td class="text-center align-middle">
                                    @if (item.TrangThaiChungTu == 1)
                                    {
                                        <span class="badge bg-warning text-dark">Đề nghị ghi</span>
                                    }
                                    else if (item.TrangThaiChungTu == 2)
                                    {
                                        <span class="badge bg-success">Đã ghi</span>
                                    }
                                    else if (item.TrangThaiChungTu == 3)
                                    {
                                        <span class="badge bg-danger">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Chưa lập</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không có dữ liệu
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    <tfoot>
                        <tr style="background:#f4f6f9; font-weight:bold;">
                            <td colspan="7" class="text-end">Tổng cộng:</td>
                            <td class="text-end" style="color: #1a5276; font-size: 1.1em;">@(Model.Items.Sum(x => x.ThanhTienHang).ToString("N0"))</td>
                            <td class="text-end" style="color: #1a5276; font-size: 1.1em;">@(Model.Items.Sum(x => x.PhiBocXep).ToString("N0"))</td>
                            <td class="text-end" style="color: #1a5276; font-size: 1.1em;">@(Model.Items.Sum(x => x.TongTien).ToString("N0"))</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
    
    @Html.Partial("_Pagination", Model)
</div>

<style>
    #tblChungTuBanHangList th {
        position: relative;
        background-clip: padding-box;
    }
    #tblChungTuBanHangList th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblChungTuBanHangList th .resizer:hover, #tblChungTuBanHangList th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var table = document.getElementById('tblChungTuBanHangList');
        if (!table) return;
        
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            // Skip for icon columns, checkbox columns and action columns
            if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
            if(th.innerText.trim() === 'Thao tác') return;
            
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                
                e.preventDefault();
            });
        });
    })();
</script>
