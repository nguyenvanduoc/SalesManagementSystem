@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.DonHangChungTuViewModel>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height: 350px;">
            <table class="table table-custom table-bordered table-hover align-middle mb-0">
                <thead>
                    <tr style="background:#f4f6f9; font-weight:bold;">
                        <th class="text-center" style="width: 60px;">Thao tác</th>
                        <th class="text-center" style="width: 50px;">STT</th>
                        <th>Số đơn hàng</th>
                        <th class="text-center">Ngày lập đơn hàng</th>
                        <th>Khách hàng</th>
                        <th class="text-end">Tổng tiền đơn hàng</th>
                        <th>Số chứng từ</th>
                        <th class="text-center">Ngày chứng từ</th>
                        <th class="text-center">Trạng thái chứng từ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 6px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>
                                            <li><hr class="dropdown-divider"></li>
                                            
                                            @if (item.IDChungTuBanHang.HasValue)
                                            {
                                                <li>
                                                    <a class="dropdown-item text-primary no-ajax" href="@Url.Action("ExportExcel", "ChungTuBanHang", new { id = item.IDChungTuBanHang })" target="_blank">
                                                        <i class="bi bi-file-earmark-excel me-2"></i> Xuất phiếu
                                                    </a>
                                                </li>
                                            }

                                            @if ((item.TrangThaiChungTu == 1 || item.TrangThaiChungTu == null || item.TrangThaiChungTu == 0) && SalesManagementSystem.Helpers.PermissionHelper.HasPermission("ChungTuBanHang", SalesManagementSystem.Helpers.LoaiPhanQuyen.TuyChon))
                                            {
                                                if (item.TrangThaiChungTu == 1)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item text-success" onclick="ghiSoChungTu(this, @item.IDChungTuBanHang)">
                                                            <i class="bi bi-check-circle me-2 text-success"></i> Ghi dữ liệu
                                                        </button>
                                                    </li>
                                                }
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger" onclick="huyChungTu(this, @(item.IDChungTuBanHang ?? 0), @item.IDDonDatHang)">
                                                        <i class="bi bi-x-circle me-2 text-danger"></i> Hủy
                                                    </button>
                                                </li>
                                            }
                                                @if (!item.IDChungTuBanHang.HasValue)
                                                {
                                                    <li><span class="dropdown-item text-muted small">Không có thao tác</span></li>
                                                }
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="align-middle fw-bold">
                                    @if (item.IDChungTuBanHang.HasValue)
                                    {
                                        if (item.TrangThaiChungTu == 2 || item.TrangThaiChungTu == 3)
                                        {
                                            <a href="@Url.Action("Detail", "ChungTuBanHang", new { id = item.IDChungTuBanHang })" class="text-decoration-none">@item.SoDonHang</a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Edit", "ChungTuBanHang", new { id = item.IDChungTuBanHang })" class="text-decoration-none">@item.SoDonHang</a>
                                        }
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Create", "ChungTuBanHang", new { idDonDatHang = item.IDDonDatHang })" class="text-decoration-none text-success" title="Lập chứng từ bán hàng">@item.SoDonHang <i class="bi bi-plus-circle"></i></a>
                                    }
                                </td>
                                <td class="text-center align-middle">@(item.NgayTaoDon?.ToString("dd/MM/yyyy"))</td>
                                <td class="align-middle">@item.TenKhachHang</td>
                                <td class="text-end align-middle fw-bold text-primary">@(item.TongTien.ToString("N0"))</td>
                                <td class="align-middle">@item.SoChungTu</td>
                                <td class="text-center align-middle">@(item.NgayChungTu?.ToString("dd/MM/yyyy"))</td>
                                <td class="text-center align-middle">
                                    @if (item.TrangThaiChungTu == 1)
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size: 0.8rem; padding: 5px 8px;">Đề nghị ghi</span>
                                    }
                                    else if (item.TrangThaiChungTu == 2)
                                    {
                                        <span class="badge bg-success" style="font-size: 0.8rem; padding: 5px 8px;">Đã ghi sổ</span>
                                    }
                                    else if (item.TrangThaiChungTu == 3)
                                    {
                                        <span class="badge bg-danger" style="font-size: 0.8rem; padding: 5px 8px;">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" style="font-size: 0.8rem; padding: 5px 8px;">Chưa lập</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không có dữ liệu
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @Html.Partial("_Pagination", Model)
</div>
