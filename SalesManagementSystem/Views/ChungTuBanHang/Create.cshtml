@model SalesManagementSystem.Models.ViewModels.ChungTuBanHangViewModel
@using System.Linq
@{
    ViewBag.Title = ViewBag.IsEdit == true ? "Xem/Chỉnh sửa chứng từ bán hàng" : "Lập chứng từ bán hàng";
}

<style>
    .don-header-card { background:#fff; border:1px solid #dce4ec; border-radius:6px; padding:16px; margin-bottom:12px; box-shadow:0 1px 4px rgba(0,0,0,.06); }
    .don-section-title { font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:#7f8c8d; margin-bottom:10px; }
    .tong-tien-box { background:linear-gradient(135deg,#1a5276,#2980b9); border-radius:8px; padding:16px 20px; color:#fff; text-align:right; }
    .tong-tien-box .label { font-size:.8rem; opacity:.85; margin-bottom:4px; }
    .tong-tien-box .amount { font-size:1.8rem; font-weight:800; letter-spacing:.5px; }
    .grid-detail thead th { background:#f4f6f9; font-size:.8rem; font-weight:700; color:#2c3e50; vertical-align:middle; white-space:nowrap; text-align:left !important; }
    .grid-detail tbody td { vertical-align:middle; padding:5px 6px; }
    .grid-detail input.form-control, .grid-detail select.form-select { font-size:.85rem; padding:3px 7px; height:30px; }
    .readonly-cell { background:#f8f9fa; font-size:.85rem; color:#495057; }
    .form-toolbar { background:#f8f9fa; border:1px solid #dce4ec; border-radius:6px; padding:10px 16px; margin-bottom:12px; display:flex; gap:8px; align-items:center; }
</style>

<!-- Toolbar -->
<div class="form-toolbar">
    <a href="@Url.Action("Index","ChungTuBanHang")" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
    
    @if (Model.TrangThai == 0 || Model.TrangThai == 1)
    {
        <button type="button" class="btn btn-sm text-white" style="background-color:#17a2b8;border:none;" onclick="ChungTuBanHang.save(false)">
            <i class="bi bi-save me-1"></i> Lưu dữ liệu
        </button>
        <button type="button" class="btn btn-sm text-white" style="background-color:#28a745;border:none;" onclick="ChungTuBanHang.save(true)">
            <i class="bi bi-check-circle me-1"></i> Lưu và ghi
        </button>
    }
    @if (Model.ID > 0)
    {
        <a href="@Url.Action("ExportExcel", "ChungTuBanHang", new { id = Model.ID })" class="btn btn-sm text-white ms-2 no-ajax" style="background-color: #20c997; border: none;" target="_blank">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất phiếu
        </a>
    }

    <span class="text-muted small ms-auto">
        <i class="bi bi-info-circle me-1"></i>@ViewBag.Title
    </span>
</div>

<form id="frmSaveCTBH">
    @Html.HiddenFor(m => m.ID)
    @Html.HiddenFor(m => m.SoChungTu)
    @Html.HiddenFor(m => m.IDDonDatHang)
    @Html.HiddenFor(m => m.IDKhachHang)

    <div class="row g-3">
        <!-- Nội dung chính -->
        <div class="col-md-12">

            <!-- Card: Khách hàng -->
            <div class="don-header-card">
                <div class="don-section-title"><i class="bi bi-person-fill me-1"></i>Thông tin khách hàng</div>
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label text-muted fw-semibold small">Mã khách hàng</label>
                        <input type="text" class="form-control readonly-cell" value="@Model.MaKhachHang" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted fw-semibold small">Khách hàng</label>
                        <input type="text" class="form-control readonly-cell" value="@Model.TenKhachHang" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted fw-semibold small">Mã số thuế</label>
                        <input type="text" class="form-control readonly-cell" value="@Model.MaSoThue" readonly />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label text-muted fw-semibold small">Địa chỉ</label>
                        <input type="text" class="form-control readonly-cell" value="@Model.DiaChi" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-semibold small">Số điện thoại</label>
                        <input type="text" class="form-control readonly-cell" value="@Model.SoDienThoai" readonly />
                    </div>
                </div>
            </div>

            <!-- Card: Thông tin đơn đặt hàng -->
            <div class="don-header-card">
                <div class="don-section-title"><i class="bi bi-file-earmark-text me-1"></i>Thông tin đơn đặt hàng</div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-semibold small">Số đơn hàng</label>
                        <input type="text" class="form-control readonly-cell" value="@Model.SoDonHang" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-semibold small">Ngày tạo đơn</label>
                        @Html.TextBoxFor(m => m.NgayTaoDon, "{0:yyyy-MM-dd}", new { @class = "form-control readonly-cell", type = "date", @readonly = "readonly" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-semibold small">Hạn giao hàng</label>
                        @Html.TextBoxFor(m => m.ThoiHanGiaoHang, "{0:yyyy-MM-dd}", new { @class = "form-control readonly-cell", type = "date", @readonly = "readonly" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-semibold small">Nhân viên phụ trách</label>
                        @Html.DropDownListFor(m => m.IDNhanVien, (SelectList)ViewBag.NhanVienList, "-- Không có --", new { @class = "form-select readonly-cell", disabled = "disabled" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted fw-semibold small">Trạng thái đơn</label>
                        @Html.DropDownListFor(m => m.TrangThaiDon, (SelectList)ViewBag.TrangThaiList, "-- Không có --", new { @class = "form-select readonly-cell", disabled = "disabled" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted fw-semibold small">Phương tiện</label>
                        @Html.DropDownListFor(m => m.IDPhuongTien, (SelectList)ViewBag.PhuongTienList, "-- Không có --", new { @class = "form-select readonly-cell", disabled = "disabled" })
                    </div>
                    <div class="col-md-2 d-none">
                        <label class="form-label text-muted fw-semibold small">SĐT Tài xế</label>
                        <input type="text" class="form-control readonly-cell" value="@Model.SoDienThoaiTaiXe" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted fw-semibold small">Thông tin xe</label>
                        <input type="text" class="form-control readonly-cell" value="@Model.HoTenTaiXe" readonly />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label text-muted fw-semibold small">Ghi chú</label>
                        @Html.TextAreaFor(m => m.GhiChuDonHang, new { @class = "form-control readonly-cell", rows = 1, @readonly = "readonly" })
                    </div>
                </div>
            </div>

            <!-- Card: Thông tin chứng từ -->
            <div class="don-header-card">
                <div class="don-section-title"><i class="bi bi-info-circle-fill me-1"></i>Thông tin chứng từ bán hàng</div>
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label text-muted fw-semibold small">Ngày chứng từ</label>
                        @Html.TextBoxFor(m => m.NgayChungTu, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted fw-semibold small">Kho xuất</label>
                        <div class="input-group">
                            <input type="hidden" name="IDKho" id="CTBH_IDKho" value="@(Model.IDKho > 0 ? Model.IDKho.ToString() : "")" />
                            <input type="text" class="form-control bg-white" id="CTBH_TenKhoHang" value="@Model.TenKhoHang" readonly placeholder="-- Chọn kho --" />
                            <button class="btn btn-outline-secondary" type="button" id="CTBH_btnShowKhoTonKho"><i class="bi bi-search"></i> Chọn kho</button>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label text-muted fw-semibold small">Tài khoản thanh toán</label>
                        <select class="form-select" name="IDTaiKhoanThanhToan" id="CTBH_IDTaiKhoanThanhToan">
                            <option value="">-- Chọn tài khoản --</option>
                            @foreach (var tk in ViewBag.TaiKhoanThanhToanList)
                            {
                                <option value="@tk.ID" @(Model.IDTaiKhoanThanhToan == tk.ID ? "selected" : "")>@tk.SoTaiKhoan - @tk.TenTaiKhoan</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Card: Chi tiết sản phẩm -->
            <div class="don-header-card">
                <div class="don-section-title mb-2"><i class="bi bi-table me-1"></i>Chi tiết sản phẩm</div>
                <div class="table-responsive">
                    <table class="table table-bordered table-custom grid-detail mb-0" id="tblChiTiet">
                        <thead>
                            <tr>
                                <th style="width:40px;" class="text-center">STT</th>
                                <th>Sản phẩm</th>
                                <th style="width:70px;" class="text-center">ĐVT</th>
                                <th style="width:100px;" class="text-end">Số lượng</th>
                                <th style="width:110px;" class="text-end">Đơn giá</th>
                                <th style="width:110px;" class="text-end">ĐG bốc xếp</th>
                                <th style="width:120px;" class="text-end">TT bốc xếp</th>
                                <th style="width:120px;" class="text-end">Thành tiền</th>
                                <th style="width:90px;" class="text-center d-none">Thuế GTGT %</th>
                                <th style="width:120px;" class="text-end d-none">Tiền thuế</th>
                                <th style="width:130px;" class="text-end">Tổng tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for(int i = 0; i < Model.ChiTiets.Count; i++)
                            {
                                <tr>
                                    <td class="text-center">
                                        @Model.ChiTiets[i].STT
                                        <input type="hidden" name="ChiTiets[@i].STT" value="@Model.ChiTiets[i].STT" />
                                        <input type="hidden" name="ChiTiets[@i].IDSanPham" value="@Model.ChiTiets[i].IDSanPham" />
                                    </td>
                                    <td>@Model.ChiTiets[i].MaSanPham - @Model.ChiTiets[i].TenSanPham</td>
                                    <td class="text-center">@Model.ChiTiets[i].DVT</td>
                                    <td class="text-end">
                                        @Model.ChiTiets[i].SoLuong.ToString("N0")
                                        <input type="hidden" name="ChiTiets[@i].SoLuong" value="@Model.ChiTiets[i].SoLuong" />
                                    </td>
                                    <td class="text-end">
                                        @Model.ChiTiets[i].DonGia.ToString("N0")
                                        <input type="hidden" name="ChiTiets[@i].DonGia" value="@Model.ChiTiets[i].DonGia" />
                                    </td>
                                    <td class="text-end">
                                        @(Model.ChiTiets[i].DonGiaBocXep.HasValue ? Model.ChiTiets[i].DonGiaBocXep.Value.ToString("N0") : "0")
                                        <input type="hidden" name="ChiTiets[@i].DonGiaBocXep" value="@Model.ChiTiets[i].DonGiaBocXep" />
                                    </td>
                                    <td class="text-end">
                                        @(Model.ChiTiets[i].ThanhTienBocXep.HasValue ? Model.ChiTiets[i].ThanhTienBocXep.Value.ToString("N0") : "0")
                                        <input type="hidden" name="ChiTiets[@i].ThanhTienBocXep" value="@Model.ChiTiets[i].ThanhTienBocXep" />
                                    </td>
                                    <td class="text-end">
                                        @Model.ChiTiets[i].ThanhTien.ToString("N0")
                                        <input type="hidden" name="ChiTiets[@i].ThanhTien" value="@Model.ChiTiets[i].ThanhTien" />
                                        <input type="hidden" name="ChiTiets[@i].ThanhTienHang" value="@Model.ChiTiets[i].ThanhTienHang" />
                                    </td>
                                    <td class="text-center d-none">
                                        @Model.ChiTiets[i].ThueGTGT
                                        <input type="hidden" name="ChiTiets[@i].ThueGTGT" value="@Model.ChiTiets[i].ThueGTGT" />
                                    </td>
                                    <td class="text-end d-none">
                                        @Model.ChiTiets[i].TienThue.ToString("N0")
                                        <input type="hidden" name="ChiTiets[@i].TienThue" value="@Model.ChiTiets[i].TienThue" />
                                    </td>
                                    <td class="text-end fw-bold">
                                        @Model.ChiTiets[i].TongSauThue.ToString("N0")
                                        <input type="hidden" name="ChiTiets[@i].TongSauThue" value="@Model.ChiTiets[i].TongSauThue" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tổng tiền -->
            <div class="don-header-card p-2 px-3 d-flex flex-wrap justify-content-between align-items-center fw-bold mb-0">
                <div class="d-flex align-items-center gap-3">
                    <div>
                        <span class="text-muted small me-1">Tổng số lượng:</span>
                        <span class="fs-6 text-dark" id="dispTongSoLuong">@(Model.ChiTiets != null ? Model.ChiTiets.Sum(c => c.SoLuong).ToString("N0") : "0")</span>
                    </div>
                    <div>
                        <span class="text-muted small me-1">Cộng tiền hàng:</span>
                        <span class="fs-6 text-dark" id="dispTongTienHang">@(Model.ChiTiets != null ? Model.ChiTiets.Sum(c => c.ThanhTien).ToString("N0") : "0")</span>
                        <input type="hidden" id="TongTienHang" name="TongTienHang" value="@Model.TongTienHang" />
                    </div>
                    <div class="d-none">
                        <span class="text-muted small me-1">Tiền thuế GTGT:</span>
                        <span class="fs-6 text-dark">@Model.TongTienThue.ToString("N0")</span>
                        <input type="hidden" name="TongTienThue" value="@Model.TongTienThue" />
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="text-muted small me-2">Phí bốc xếp:</span>
                        <input type="text" id="PhiBocXepDisplay" class="form-control form-control-sm text-end readonly-cell fw-bold" style="width: 100px;" value="@Model.PhiBocXep.ToString("N0")" readonly />
                        <input type="hidden" id="PhiBocXep" name="PhiBocXep" value="@Model.PhiBocXep" />
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted text-uppercase">Tổng thanh toán:</span>
                    <span class="fs-4 text-danger fw-bolder">@Model.TongCong.ToString("N0")</span>
                    <span class="text-danger fw-bolder">VNĐ</span>
                    <input type="hidden" name="TongCong" value="@Model.TongCong" />
                </div>
            </div>

        </div>
    </div>
</form>

<!-- Modal Kiểm tra tồn kho -->
<div class="modal fade" id="modalTonKho" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg" style="border: none;">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-uppercase" style="color:#0b5b84;">CHỌN KHO XUẤT (KIỂM TRA TỒN)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-bordered mb-0" id="CTBH_tableTonKho">
                        <thead style="background:#f4f6f9; font-weight:bold; position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th>Tên kho hàng</th>
                                <th class="text-center" style="width:130px;">Tình trạng</th>
                                <th>Chi tiết tồn kho (Tồn / Cần xuất)</th>
                                <th class="text-center" style="width:100px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Nội dung render qua JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary text-white" style="background:#6c757d; border:none;" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/chung-tu-ban-hang.js?v=3.4"></script>
    <script>
        $(function () {
            ChungTuBanHang.init();
        });
    </script>
}
