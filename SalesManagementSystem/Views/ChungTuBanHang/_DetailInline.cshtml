@model SalesManagementSystem.Models.ViewModels.ChungTuBanHangViewModel

<div class="table-responsive bg-white shadow-sm" style="border-radius: 4px; overflow: hidden; border: 1px solid #dee2e6;">
    <table class="table table-custom table-bordered table-hover align-middle mb-0">
        <thead>
            <tr>
                <th class="text-center" style="width:40px;">STT</th>
                <th class="text-start">Mã SP</th>
                <th class="text-start">Tên sản phẩm</th>
                <th class="text-center" style="width:70px;">ĐVT</th>
                <th class="text-end" style="width:90px;">Số lượng</th>
                <th class="text-end" style="width:110px;">Đơn giá</th>
                <th class="text-end" style="width:120px;">Thành tiền</th>
                <th class="text-end" style="width:120px;">Tiền thuế</th>
                <th class="text-end" style="width:120px;">Tổng cộng</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ChiTiets != null && Model.ChiTiets.Any())
            {
                int stt = 1;
                foreach (var item in Model.ChiTiets)
                {
                    <tr>
                        <td class="text-center">@(stt++)</td>
                        <td>@item.MaSanPham</td>
                        <td>@item.TenSanPham</td>
                        <td class="text-center">@item.DVT</td>
                        <td class="text-end">@(item.SoLuong > 0 ? item.SoLuong.ToString("N0") : "0")</td>
                        <td class="text-end">@(item.DonGia > 0 ? item.DonGia.ToString("N0") : "0")</td>
                        <td class="text-end">@(item.ThanhTien > 0 ? item.ThanhTien.ToString("N0") : "0")</td>
                        <td class="text-end">@(item.TienThue > 0 ? item.TienThue.ToString("N0") : "0")</td>
                        <td class="text-end">@(item.TongSauThue > 0 ? item.TongSauThue.ToString("N0") : "0")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">Không có dữ liệu chi tiết hàng hóa</td>
                </tr>
            }
        </tbody>
        @if (Model.ChiTiets != null && Model.ChiTiets.Any())
        {
            <tfoot style="background-color: #f8f9fa;">
                <tr class="fw-bold">
                    <td colspan="4" class="text-end">Cộng tiền hàng</td>
                    <td class="text-end">@(Model.ChiTiets.Sum(x => x.SoLuong).ToString("N0"))</td>
                    <td></td>
                    <td class="text-end">@(Model.TongTienHang > 0 ? Model.TongTienHang.ToString("N0") : Model.ChiTiets.Sum(x => x.ThanhTien).ToString("N0"))</td>
                    <td class="text-end">@(Model.TongTienThue > 0 ? Model.TongTienThue.ToString("N0") : Model.ChiTiets.Sum(x => x.TienThue).ToString("N0"))</td>
                    <td class="text-end">@(Model.ChiTiets.Sum(x => x.TongSauThue).ToString("N0"))</td>
                </tr>
                @if (Model.PhiBocXep > 0)
                {
                <tr class="fw-bold">
                    <td colspan="8" class="text-end">Phí bốc xếp</td>
                    <td class="text-end text-danger">@(Model.PhiBocXep.ToString("N0"))</td>
                </tr>
                }
                <tr class="fw-bold text-success" style="font-size: 1.1em;">
                    <td colspan="8" class="text-end">Tổng thanh toán</td>
                    <td class="text-end">@(Model.TongCong > 0 ? Model.TongCong.ToString("N0") : (Model.ChiTiets.Sum(x => x.TongSauThue) - Model.PhiBocXep).ToString("N0"))</td>
                </tr>
            </tfoot>
        }
    </table>
</div>
