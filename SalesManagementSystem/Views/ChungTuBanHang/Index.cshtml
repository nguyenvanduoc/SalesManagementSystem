@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.DonHangChungTuViewModel>
@{
    ViewBag.Title = "Chứng Từ Bán Hàng";
    var uid = Guid.NewGuid().ToString("N");
}

<style>
    .ctbh-row.active-row td {
        background-color: #e3f2fd !important;
    }
    .ctbh-detail-row > td {
        box-shadow: inset 0 3px 6px -3px rgba(0,0,0,0.1), inset 0 -3px 6px -3px rgba(0,0,0,0.1);
    }
</style>

<div id="ctbh-@uid">
    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
        <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">
            <i class="bi bi-receipt me-2"></i>@ViewBag.Title
        </h4>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success btn-export-excel shadow-sm" style="background-color: #27ae60; border-color: #27ae60;">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
            </button>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <form id="searchForm" action="@Url.Action("GetList")" method="get">
                <div class="row g-2 align-items-end">
                    
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Thời gian</label>
                        <select class="form-select form-select-sm ddl-thoi-gian no-select2">
                                <option value="current_month">Đầu tháng đến hiện tại</option>
                            <option value="month_1">Tháng 1</option>
                            <option value="month_2">Tháng 2</option>
                            <option value="month_3">Tháng 3</option>
                            <option value="month_4">Tháng 4</option>
                            <option value="month_5">Tháng 5</option>
                            <option value="month_6">Tháng 6</option>
                            <option value="month_7">Tháng 7</option>
                            <option value="month_8">Tháng 8</option>
                            <option value="month_9">Tháng 9</option>
                            <option value="month_10">Tháng 10</option>
                            <option value="month_11">Tháng 11</option>
                            <option value="month_12">Tháng 12</option>
                            <option value="quarter_1">Quý 1</option>
                            <option value="quarter_2">Quý 2</option>
                            <option value="quarter_3">Quý 3</option>
                            <option value="quarter_4">Quý 4</option>
                            <option value="current_year">Từ đầu năm đến hiện tại</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Từ ngày</label>
                        <input type="date" name="tuNgay" class="form-control form-control-sm" value="@ViewBag.TuNgay" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Đến ngày</label>
                        <input type="date" name="denNgay" class="form-control form-control-sm" value="@ViewBag.DenNgay" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Số đơn hàng / Chứng từ</label>
                        <input type="text" name="soDonHang" class="form-control form-control-sm" placeholder="Nhập số đơn hàng hoặc số chứng từ..." value="@ViewBag.SoDonHang" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Khách hàng</label>
                        @Html.DropDownList("idKhachHang", (SelectList)ViewBag.KhachHangs, "-- Tất cả --", new { @class = "form-select form-select-sm" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Sản phẩm</label>
                        @Html.DropDownList("idSanPham", (SelectList)ViewBag.SanPhams, "-- Tất cả --", new { @class = "form-select form-select-sm ddlSanPham" })
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Trạng thái</label>
                        <select name="trangThai" class="form-select form-select-sm">
                            <option value="">-- Tất cả --</option>
                            <option value="4" @(ViewBag.TrangThai == 4 ? "selected" : "")>Lưu nháp</option>
                            <option value="1" @(ViewBag.TrangThai == 1 ? "selected" : "")>Đề nghị ghi</option>
                            <option value="2" @(ViewBag.TrangThai == 2 ? "selected" : "")>Đã ghi</option>
                            <option value="3" @(ViewBag.TrangThai == 3 ? "selected" : "")>Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Phương tiện</label>
                        @Html.DropDownList("idPhuongTien", (SelectList)ViewBag.PhuongTiens, "-- Tất cả --", new { @class = "form-select form-select-sm" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Thông tin xe</label>
                        <input type="text" name="hoTenTaiXe" class="form-control form-control-sm" placeholder="Tìm thông tin xe, tài xế..." value="@ViewBag.HoTenTaiXe" />
                    </div>
                    <div class="col-12 d-flex gap-2 mt-3 justify-content-end">
                        <button type="submit" class="btn btn-sm text-white px-3" style="background-color: #2998e4; border: none;">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-sm text-white px-3" style="background-color: #f1c40f; border: none;">
                            Làm mới
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="table-container">
        @Html.Partial("_ChungTuBanHangList", Model)
    </div>

    <div id="modalContainer"></div>
</div>

    <div class="modal fade" id="huyChungTuModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-dark">Lý do hủy chứng từ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="huy_idChungTu" />
                    <input type="hidden" id="huy_idDonHang" />
                    <div class="mb-3">
                        <label class="form-label text-muted small">Vui lòng nhập lý do hủy:</label>
                        <textarea class="form-control" id="huy_lyDo" rows="3" placeholder="Nhập lý do hủy..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-danger" onclick="xacNhanHuy()">Xác nhận hủy</button>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script src="~/Scripts/chung-tu-ban-hang.js?v=5.0"></script>
    <script>

        // Global scoped functions for action buttons (stateless)
        function getCtbhContainer(btn) {
            return $(btn).closest('[id^="ctbh-"]');
        }

        window.ghiSoChungTu = function(btn, id) {
            var $form = getCtbhContainer(btn).find('#searchForm');
            showConfirm('Bạn có chắc muốn ghi dữ liệu chứng từ này? Hành động này sẽ tự động sinh phiếu xuất kho và bút toán kế toán Doanh Thu và không thể hoàn tác.', function() {
                $.post('@Url.Action("GhiSo")', { id: id }, function (res) {
                    if (res.success) {
                        if (typeof showToast === 'function') showToast('success', 'Ghi dữ liệu thành công!');
                        $form.trigger('submit');
                    } else {
                        if (typeof showToast === 'function') showToast('error', res.message);
                    }
                });
            });
        };

        window.boGhiChungTu = function(btn, id) {
            var $form = getCtbhContainer(btn).find('#searchForm');
            showConfirm('Bạn có chắc muốn bỏ ghi dữ liệu chứng từ này? Trạng thái sẽ chuyển về Lưu nháp và các giao dịch kho sẽ được hoàn trả.', function() {
                $.post('@Url.Action("BoGhi")', { id: id }, function (res) {
                    if (res.success) {
                        if (typeof showToast === 'function') showToast('success', 'Bỏ ghi thành công!');
                        $form.trigger('submit');
                    } else {
                        if (typeof showToast === 'function') showToast('error', res.message);
                    }
                });
            });
        };


        $(document).ready(function() {
            var $container = $('#ctbh-@uid');
            
            // Delegate row clicks for inline detail view
            $container.on('click', '.ctbh-row', function (e) {
                if ($(e.target).closest('a, button, select, input, .dropdown, .dropdown-menu').length) {
                    return;
                }

                var $row = $(this);
                var id = $row.data('id');
                var idDonDatHang = $row.data('iddondathang');
                var rowKey = (id && id > 0) ? id : "don_" + idDonDatHang;

                var $nextRow = $row.next();
                var isAlreadyExpanded = $nextRow.hasClass('ctbh-detail-row') && $nextRow.data('parent-id') == rowKey;

                // Close any currently open detail rows in this container
                $container.find('.ctbh-detail-row').remove();
                $container.find('.ctbh-row').removeClass('active-row');
                $container.find('.toggle-icon').removeClass('bi-caret-down-fill text-primary').addClass('bi-caret-right-fill text-muted');

                if (isAlreadyExpanded) {
                    return;
                }

                // Highlight active row
                $row.addClass('active-row');
                $row.find('.toggle-icon').removeClass('bi-caret-right-fill text-muted').addClass('bi-caret-down-fill text-primary');

                // Create placeholder detail row
                var $detailRow = $('<tr class="ctbh-detail-row" data-parent-id="' + rowKey + '">' +
                    '<td colspan="16" class="p-3" style="background-color: #fcfdfd; border-left: 4px solid #2998e4;">' +
                    '   <div class="text-center p-4 text-muted">' +
                    '       <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>' +
                    '       Đang tải chi tiết...' +
                    '   </div>' +
                    '</td>' +
                    '</tr>');

                $row.after($detailRow);

                // Load view content via AJAX
                $.ajax({
                    url: '@Url.Action("GetDetailInline", "ChungTuBanHang")',
                    type: 'GET',
                    global: false,
                    data: { id: id, idDonDatHang: idDonDatHang },
                    success: function (html) {
                        $detailRow.find('td').html(html);
                    },
                    error: function () {
                        $detailRow.find('td').html('<div class="text-danger text-center p-3"><i class="bi bi-exclamation-triangle-fill me-2"></i> Lỗi khi tải thông tin chi tiết.</div>');
                    }
                });
            });

            $container.find('.btn-export-excel').on('click', function() {
                var params = $container.find('#searchForm').serialize();
                window.location.href = '@Url.Action("ExportExcelList", "ChungTuBanHang")?' + params;
            });

            // Tự động load dữ liệu khi mở màn hình
            setTimeout(function() {
                var form = document.querySelector('#ctbh-@uid #searchForm');
                if (form) {
                    // Kích hoạt sự kiện submit native để tab-manager.js có thể bắt được
                    var event = new Event('submit', { bubbles: true, cancelable: true });
                    form.dispatchEvent(event);
                }
            }, 100);
        });

        window.huyChungTu = function(btn, id, idDonDatHang) {
            window.currentCtbhContainer = getCtbhContainer(btn);
            $('#huy_idChungTu').val(id);
            $('#huy_idDonHang').val(idDonDatHang);
            $('#huy_lyDo').val('');
            $('#huyChungTuModal').modal('show');
        };

        window.xacNhanHuy = function() {
            var id = $('#huy_idChungTu').val();
            var idDonDatHang = $('#huy_idDonHang').val();
            var lyDo = $('#huy_lyDo').val();
            if (!lyDo.trim()) {
                if (typeof showToast === 'function') showToast('warning', 'Vui lòng nhập lý do hủy!');
                return;
            }
            $.post('@Url.Action("Huy")', { id: id, idDonDatHang: idDonDatHang, lyDo: lyDo }, function (res) {
                if (res.success) {
                    $('#huyChungTuModal').modal('hide');
                    if (typeof showToast === 'function') showToast('success', 'Hủy thành công!');
                    if (window.currentCtbhContainer) {
                        var $form = window.currentCtbhContainer.find('#searchForm');
                        $form.trigger('submit');
                    }
                } else {
                    if (typeof showToast === 'function') showToast('error', res.message);
                }
            });
        };
    </script>
}
