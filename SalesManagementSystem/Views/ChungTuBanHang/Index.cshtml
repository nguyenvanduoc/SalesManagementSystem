@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.DonHangChungTuViewModel>
@{
    ViewBag.Title = "Chứng Từ Bán Hàng";
    var uid = Guid.NewGuid().ToString("N");
}

<div id="ctbh-@uid">
    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
        <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">
            @ViewBag.Title
        </h4>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <form id="searchForm" action="@Url.Action("GetList")" method="get">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Từ ngày</label>
                        <input type="date" name="tuNgay" class="form-control form-control-sm" value="@ViewBag.TuNgay" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Đến ngày</label>
                        <input type="date" name="denNgay" class="form-control form-control-sm" value="@ViewBag.DenNgay" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Số đơn hàng</label>
                        <input type="text" name="soDonHang" class="form-control form-control-sm" placeholder="Nhập số đơn hàng..." value="@ViewBag.SoDonHang" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Khách hàng</label>
                        @Html.DropDownList("idKhachHang", (SelectList)ViewBag.KhachHangs, "-- Tất cả --", new { @class = "form-select form-select-sm" })
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Trạng thái</label>
                        <select name="trangThai" class="form-select form-select-sm">
                            <option value="">-- Tất cả --</option>
                            <option value="1" @(ViewBag.TrangThai == 1 ? "selected" : "")>Đề nghị ghi</option>
                            <option value="2" @(ViewBag.TrangThai == 2 ? "selected" : "")>Đã ghi sổ</option>
                            <option value="3" @(ViewBag.TrangThai == 3 ? "selected" : "")>Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2 mt-3 justify-content-end">
                        <button type="submit" class="btn btn-sm text-white px-3" style="background-color: #2998e4; border: none;">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-sm text-white px-3" style="background-color: #f1c40f; border: none;">
                            Làm mới
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="table-container">
        @Html.Partial("_ChungTuBanHangList", Model)
    </div>

    <div id="modalContainer"></div>
</div>

@section Scripts {
    <script src="~/Scripts/chung-tu-ban-hang.js?v=3.0"></script>
    <script>

        // Global scoped functions for action buttons (stateless)
        function getCtbhContainer(btn) {
            return $(btn).closest('[id^="ctbh-"]');
        }

        window.ghiSoChungTu = function(btn, id) {
            var $form = getCtbhContainer(btn).find('#searchForm');
            showConfirm('Bạn có chắc muốn ghi dữ liệu chứng từ này? Hành động này sẽ tự động sinh phiếu xuất kho và bút toán kế toán Doanh Thu và không thể hoàn tác.', function() {
                $.post('@Url.Action("GhiSo")', { id: id }, function (res) {
                    if (res.success) {
                        if (typeof showToast === 'function') showToast('success', 'Ghi dữ liệu thành công!');
                        $form.trigger('submit');
                    } else {
                        if (typeof showToast === 'function') showToast('error', res.message);
                    }
                });
            });
        };


        $(document).ready(function() {
            // Tự động load dữ liệu khi mở màn hình
            setTimeout(function() {
                var form = document.querySelector('#ctbh-@uid #searchForm');
                if (form) {
                    // Kích hoạt sự kiện submit native để tab-manager.js có thể bắt được
                    var event = new Event('submit', { bubbles: true, cancelable: true });
                    form.dispatchEvent(event);
                }
            }, 100);
        });

        window.huyChungTu = function(btn, id) {
            var $form = getCtbhContainer(btn).find('#searchForm');
            var lyDo = prompt("Nhập lý do hủy:");
            if (lyDo != null) {
                if (!lyDo.trim()) {
                    if (typeof showToast === 'function') showToast('warning', 'Vui lòng nhập lý do hủy!');
                    return;
                }
                $.post('@Url.Action("Huy")', { id: id, lyDo: lyDo }, function (res) {
                    if (res.success) {
                        if (typeof showToast === 'function') showToast('success', 'Hủy thành công!');
                        $form.trigger('submit');
                    } else {
                        if (typeof showToast === 'function') showToast('error', res.message);
                    }
                });
            }
        };
    </script>
}
