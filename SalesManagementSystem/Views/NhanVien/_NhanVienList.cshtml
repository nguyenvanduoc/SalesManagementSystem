@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.Entities.NhanVien>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height: 350px;">
            <table class="table table-custom table-bordered table-hover mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 40px;"><input type="checkbox" class="form-check-input" id="checkAll"></th>
                        <th class="text-center" style="width: 50px;"></th>
                        <th class="text-center" style="width: 50px;"></th>
                        <th>Mã NV</th>
                        <th>Họ đệm</th>
                        <th>Tên NV</th>
                        <th>Ngày sinh</th>
                        <th>Giới tính</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <input type="checkbox" class="form-check-input row-checkbox" value="@item.ID">
                                </td>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 6px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>
                                            <li><hr class="dropdown-divider"></li>
                                         
                                            @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("NhanVien", SalesManagementSystem.Helpers.LoaiPhanQuyen.CapNhat))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item" onclick="openFormModal('@Url.Action("Update", "NhanVien", new { id = item.ID })')">
                                                        <i class="bi bi-pencil-square me-2 text-primary"></i> Chỉnh sửa
                                                    </button>
                                                </li>
                                            }
                                            @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("NhanVien", SalesManagementSystem.Helpers.LoaiPhanQuyen.Xoa))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger" onclick="confirmDelete('@Url.Action("Delete", "NhanVien", new { id = item.ID })')">
                                                        <i class="bi bi-trash-fill me-2 text-danger"></i> Xóa
                                                    </button>
                                                </li>
                                            }
                                         
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="align-middle text-center">@item.MaNhanVien</td>
                                <td class="align-middle">@item.HoDem</td>
                                <td class="align-middle">@item.TenNhanVien</td>
                                <td class="align-middle text-center">@(item.NgaySinh.HasValue ? item.NgaySinh.Value.ToString("dd/MM/yyyy") : "")</td>
                                <td class="align-middle text-center">@(item.GioiTinh.HasValue ? (item.GioiTinh.Value ? "Nam" : "Nữ") : "")</td>
                                <td class="align-middle text-center">@item.SoDienThoai</td>
                                <td class="align-middle">@item.Email</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">Chưa có dữ liệu nhân viên.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @Html.Partial("_Pagination", Model)
</div>
