@model SalesManagementSystem.Models.ViewModels.HaoHutHangHoaViewModel
@{
    Layout = null;
    var isBanHang = Model.LoaiHaoHut == 1;
}
<div class="modal fade" id="modalDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background-color: #0b5b84;">
                <h5 class="modal-title fw-bold text-uppercase"><i class="bi bi-info-circle me-2"></i> Chi tiết hao hụt: @Model.SoChungTu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="row g-3 mb-3 p-3 bg-white rounded shadow-sm">
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Ngày hao hụt</label>
                        <div class="fw-bold">@Model.NgayHaoHut.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Loại hao hụt</label>
                        <div class="fw-bold text-primary">@(isBanHang ? "Hao hụt bán hàng" : "Hao hụt tồn kho")</div>
                    </div>
                    <div class="col-md-3 @(isBanHang ? "d-none" : "")">
                        <label class="form-label text-muted small mb-1">Kho</label>
                        <div class="fw-bold">@Model.TenKho</div>
                    </div>
                    <div class="col-md-6 @(isBanHang ? "" : "d-none")">
                        <label class="form-label text-muted small mb-1">Đơn hàng</label>
                        <div class="fw-bold">@Model.SoDonHang - @Model.TenKhachHang</div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label text-muted small mb-1">Lý do</label>
                        <div>@Model.LyDo</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.GhiChu))
                    {
                        <div class="col-md-12">
                            <label class="form-label text-muted small mb-1">Ghi chú</label>
                            <div class="fst-italic text-muted">@Model.GhiChu</div>
                        </div>
                    }
                </div>

                <div class="p-3 bg-white rounded shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-secondary mb-0"><i class="bi bi-list-ul me-1"></i> CHI TIẾT SẢN PHẨM</h6>
                    </div>
                    <div class="table-responsive" style="max-height: 300px;">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Mã SP</th>
                                    <th>Tên SP</th>
                                    <th class="text-end text-success">SL hiện tại</th>
                                    <th class="text-end text-danger">SL hao hụt</th>
                                    <th class="text-end text-danger">Đơn giá hao hụt</th>
                                    <th class="text-end text-danger fw-bold">Tiền hao hụt</th>
                                    @if(isBanHang){
                                        <th class="text-end">Đơn giá bán</th>
                                        <th class="text-end text-warning">Doanh thu giảm</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Details)
                                {
                                    <tr>
                                        <td>@item.MaSanPham</td>
                                        <td>@item.TenSanPham</td>
                                        <td class="text-end text-success fw-bold">@item.SLHienTai.ToString("N0")</td>
                                        <td class="text-end text-danger fw-bold">@item.SoLuongHaoHut.ToString("N0")</td>
                                        <td class="text-end">@item.DonGiaHaoHut.ToString("N0")</td>
                                        <td class="text-end text-danger fw-bold">@item.TienHaoHut.ToString("N0")</td>
                                        @if(isBanHang){
                                            <td class="text-end">@((item.DonGiaBan ?? 0).ToString("N0"))</td>
                                            <td class="text-end text-warning fw-bold">@((item.DoanhThuGiam ?? 0).ToString("N0"))</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="3" class="text-end">TỔNG CỘNG:</td>
                                    <td class="text-end text-danger">@(Model.TongSoLuong?.ToString("N0") ?? "0")</td>
                                    <td></td>
                                    <td class="text-end text-danger">@(Model.TongTienHaoHut?.ToString("N0") ?? "0")</td>
                                    @if(isBanHang){
                                        <td></td>
                                        <td class="text-end text-warning">@(Model.Details.Sum(x => x.DoanhThuGiam ?? 0).ToString("N0"))</td>
                                    }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white d-flex justify-content-between">
                <div>
                    @if (Model.TrangThai == 1)
                    {
                        <span class="badge bg-secondary fs-6"><i class="bi bi-pencil-square me-1"></i> Lưu nháp</span>
                    }
                    else if (Model.TrangThai == 2)
                    {
                        <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i> Đã ghi nhận</span>
                    }
                    else if (Model.TrangThai == 3)
                    {
                        <span class="badge bg-danger fs-6"><i class="bi bi-slash-circle me-1"></i> Đã hủy</span>
                    }
                </div>
                <div>
                    @if (Model.TrangThai == 1)
                    {
                        <button type="button" class="btn btn-success me-2" onclick="ghiNhan(@Model.ID)"><i class="bi bi-check-circle me-1"></i> Ghi nhận</button>
                        <button type="button" class="btn btn-danger me-2" onclick="xoa(@Model.ID)"><i class="bi bi-trash me-1"></i> Xóa</button>
                    }
                    else if (Model.TrangThai == 2)
                    {
                        <button type="button" class="btn btn-warning me-2" onclick="huy(@Model.ID)"><i class="bi bi-arrow-counterclockwise me-1"></i> Hủy ghi nhận</button>
                    }
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i> Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function ghiNhan(id) {
        showConfirm('Bạn có chắc chắn muốn ghi nhận phiếu hao hụt này? Hệ thống sẽ trừ tồn kho hoặc cập nhật lại giá trị đơn hàng.', function() {
            $.post('@Url.Action("GhiNhan", "KHO_HaoHut")', { id: id }, function (res) {
                if (res.success) {
                    showToast('success', res.message);
                    $('#modalDetail').modal('hide');
                    loadData();
                } else {
                    showToast('error', res.message);
                }
            });
        });
    }

    function huy(id) {
        showConfirm('Bạn có chắc chắn muốn HỦY phiếu hao hụt này? Hệ thống sẽ hoàn lại số lượng tồn kho / đơn hàng.', function() {
            $.post('@Url.Action("Huy", "KHO_HaoHut")', { id: id }, function (res) {
                if (res.success) {
                    showToast('success', res.message);
                    $('#modalDetail').modal('hide');
                    loadData();
                } else {
                    showToast('error', res.message);
                }
            });
        });
    }
    
    function xoa(id) {
        showConfirm('Bạn có chắc chắn muốn XÓA phiếu hao hụt nháp này?', function() {
            $.post('@Url.Action("Delete", "KHO_HaoHut")', { id: id }, function (res) {
                if (res.success) {
                    showToast('success', res.message);
                    $('#modalDetail').modal('hide');
                    loadData();
                } else {
                    showToast('error', res.message);
                }
            });
        });
    }
</script>
