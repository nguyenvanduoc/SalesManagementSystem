@{
    ViewBag.Title = "Quản lý hao hụt hàng hóa";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<style>
    #tblHaoHut th {
        position: relative;
        background-clip: padding-box;
    }
    #tblHaoHut th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblHaoHut th .resizer:hover, #tblHaoHut th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">
        <i class="bi bi-boxes me-2"></i> @ViewBag.Title
    </h4>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" style="background-color:#3498db;border-color:#3498db;" onclick="openCreateModal()">
            <i class="bi bi-plus-lg fw-bold"></i> Thêm mới
        </button>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form id="frmFilter" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label text-muted small mb-1">Thời gian</label>
                <select class="form-select form-select-sm ddl-thoi-gian">
                    <option value="current_month">Đầu tháng đến hiện tại</option>
                    <option value="month_1">Tháng 1</option>
                    <option value="month_2">Tháng 2</option>
                    <option value="month_3">Tháng 3</option>
                    <option value="month_4">Tháng 4</option>
                    <option value="month_5">Tháng 5</option>
                    <option value="month_6">Tháng 6</option>
                    <option value="month_7">Tháng 7</option>
                    <option value="month_8">Tháng 8</option>
                    <option value="month_9">Tháng 9</option>
                    <option value="month_10">Tháng 10</option>
                    <option value="month_11">Tháng 11</option>
                    <option value="month_12">Tháng 12</option>
                    <option value="quarter_1">Quý 1</option>
                    <option value="quarter_2">Quý 2</option>
                    <option value="quarter_3">Quý 3</option>
                    <option value="quarter_4">Quý 4</option>
                    <option value="current_year">Từ đầu năm đến hiện tại</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small mb-1">Từ ngày</label>
                <input type="date" class="form-control form-control-sm" id="TuNgay" name="TuNgay" value="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small mb-1">Đến ngày</label>
                <input type="date" class="form-control form-control-sm" id="DenNgay" name="DenNgay" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small mb-1">Loại hao hụt</label>
                <select class="form-select form-select-sm" id="LoaiHaoHut" name="LoaiHaoHut">
                    <option value="0">Tất cả</option>
                    <option value="1">Hao hụt bán hàng</option>
                    <option value="2">Hao hụt tồn kho</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small mb-1">Kho</label>
                <select class="form-select form-select-sm select2" id="IDKho" name="IDKho">
                    <option value="0">Tất cả</option>
                    @if (ViewBag.KhoHangs != null)
                    {
                        foreach (var item in ViewBag.KhoHangs)
                        {
                            <option value="@item.ID">@item.TenKhoHang</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small mb-1">Số chứng từ</label>
                <input type="text" class="form-control form-control-sm" id="SoChungTu" name="SoChungTu" placeholder="Nhập số CT..." />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small mb-1">Sản phẩm</label>
                <select class="form-select form-select-sm select2" id="IDSanPham" name="IDSanPham">
                    <option value="0">Tất cả</option>
                    @if (ViewBag.SanPhams != null)
                    {
                        foreach (var item in ViewBag.SanPhams)
                        {
                            <option value="@item.ID">@item.TenSanPham</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small mb-1">Trạng thái</label>
                <select class="form-select form-select-sm" id="TrangThai" name="TrangThai">
                    <option value="0">Tất cả</option>
                    <option value="1">Lưu nháp</option>
                    <option value="2">Đã ghi nhận</option>
                    <option value="3">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button type="button" class="btn btn-sm text-white px-3"
                        style="background-color:#2998e4;border:none;" onclick="loadData()">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>
                <button type="button" onclick="resetFilter()" class="btn btn-sm text-white px-3 btn-reset"
                        style="background-color:#f1c40f;border:none;">
                    Làm mới
                </button>
            </div>
        </form>
    </div>
</div>

<div id="listContainer">
    <!-- Dữ liệu sẽ được load qua AJAX vào đây -->
</div>

<!-- Modal container -->
<div id="modalContainer"></div>

@section Scripts {
    <script>
        var currentPage = 1;
        var pageSize = 20;

        $(document).ready(function () {
            $('.select2').select2({ theme: 'bootstrap-5' });

            loadData();
        });

        function loadData(page) {
            if (page) currentPage = page;
            var pageSize = $('#PageSize').length > 0 ? $('#PageSize').val() : 20;

            var $tbody = $('#tblHaoHut tbody');
            if ($tbody.length > 0) {
                $tbody.html('<tr><td colspan="11" class="text-center p-5"><div class="spinner-border text-primary me-2" role="status"></div><span class="text-muted">Đang tải dữ liệu...</span></td></tr>');
            }

            var tuNgay = $('#TuNgay').val();
            var denNgay = $('#DenNgay').val();
            
            if (denNgay && !denNgay.includes(':')) {
                denNgay = denNgay + ' 23:59:59';
            }

            var filter = {
                TuNgay: tuNgay,
                DenNgay: denNgay,
                LoaiHaoHut: $('#LoaiHaoHut').val(),
                IDKho: $('#IDKho').val(),
                IDSanPham: $('#IDSanPham').val(),
                SoChungTu: $('#SoChungTu').val(),
                TrangThai: $('#TrangThai').val(),
                Skip: (currentPage - 1) * pageSize,
                Take: pageSize
            };

            showLoading();
            $.ajax({
                url: '@Url.Action("GetList", "KHO_HaoHut")',
                type: 'POST',
                data: filter,
                success: function (res) {
                    if (res.success) {
                        renderGrid(res.data, res.total);
                    } else {
                        showToast('error', res.message);
                    }
                },
                complete: function () {
                    hideLoading();
                }
            });
        }

        function renderGrid(data, total) {
            var html = '<div class="card shadow-sm border-0"><div class="card-body p-0"><div class="table-responsive"><table id="tblHaoHut" class="table table-custom table-bordered table-hover mb-0 align-middle" style="width:100%; min-width:1000px;">';
            html += '<thead class="table-light"><tr>';
            html += '<th class="text-center" style="width:100px;">Thao tác</th>';
            html += '<th class="text-center" style="width:50px;">STT</th>';
            html += '<th>Số chứng từ</th>';
            html += '<th>Ngày hao hụt</th>';
            html += '<th>Loại hao hụt</th>';
            html += '<th>Kho</th>';
            html += '<th>Khách hàng</th>';
            html += '<th>Đơn hàng</th>';
            html += '<th class="text-end">Tổng SL</th>';
            html += '<th class="text-end">Tổng tiền</th>';
            html += '<th class="text-center">Trạng thái</th>';
            html += '</tr></thead><tbody>';

            if (data && data.length > 0) {
                $.each(data, function (i, item) {
                    html += '<tr>';
                    html += '<td class="text-center align-middle">';
                    html += '<div class="dropdown dropdown-hover d-inline-block">';
                    html += '  <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" data-bs-boundary="window" style="padding:2px 6px;">';
                    html += '    <i class="bi bi-grid-3x3-gap-fill text-dark"></i>';
                    html += '  </button>';
                    html += '  <ul class="dropdown-menu shadow">';
                    html += '    <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>';
                    html += '    <li><hr class="dropdown-divider"></li>';
                    
                    // 1. Xem chi tiết
                    html += '    <li><a class="dropdown-item" href="javascript:void(0)" onclick="openDetail(' + item.ID + ')"><i class="bi bi-eye me-2 text-primary"></i> Xem chi tiết</a></li>';
                    
                    // 2. Cập nhật (Nháp)
                    if (item.TrangThai == 1) {
                        html += '    <li><a class="dropdown-item" href="javascript:void(0)" onclick="openEdit(' + item.ID + ')"><i class="bi bi-pencil me-2 text-warning"></i> Cập nhật</a></li>';
                    }
                    
                    // 3. Xóa (Nháp)
                    if (item.TrangThai == 1) {
                        html += '    <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteHaoHut(' + item.ID + ')"><i class="bi bi-trash me-2 text-danger"></i> Xóa</a></li>';
                    }
                    
                    // 4. Hủy ghi nhận (Đã ghi nhận)
                    if (item.TrangThai == 2) {
                        html += '    <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="cancelHaoHut(' + item.ID + ')"><i class="bi bi-x-circle me-2 text-danger"></i> Hủy ghi nhận</a></li>';
                    }
                    
                    html += '  </ul>';
                    html += '</div>';
                    html += '</td>';
                    html += '<td class="text-center">' + ((currentPage - 1) * pageSize + i + 1) + '</td>';
                    html += '<td><span class="fw-bold text-primary">' + item.SoChungTu + '</span></td>';
                    html += '<td>' + formatJsonDate(item.NgayHaoHut) + '</td>';
                    html += '<td>' + (item.LoaiHaoHut == 1 ? '<span class="badge bg-info text-dark">Hao hụt bán hàng</span>' : '<span class="badge bg-warning text-dark">Hao hụt tồn kho</span>') + '</td>';
                    html += '<td>' + (item.TenKho || '') + '</td>';
                    html += '<td>' + (item.TenKhachHang || '') + '</td>';
                    html += '<td>' + (item.SoDonHang || '') + '</td>';
                    html += '<td class="text-end fw-bold">' + formatNumber(item.TongSoLuong) + '</td>';
                    html += '<td class="text-end fw-bold text-danger">' + formatNumber(item.TongTienHaoHut) + '</td>';
                    
                    var tt = '';
                    if (item.TrangThai == 1) tt = '<span class="badge bg-secondary">Lưu nháp</span>';
                    else if (item.TrangThai == 2) tt = '<span class="badge bg-success">Đã ghi nhận</span>';
                    else if (item.TrangThai == 3) tt = '<span class="badge bg-danger">Đã hủy</span>';
                    
                    html += '<td class="text-center">' + tt + '</td>';
                    html += '</tr>';
                });
            } else {
                html += '<tr><td colspan="11" class="text-center text-muted py-4">Không tìm thấy dữ liệu</td></tr>';
            }
            html += '</tbody></table></div></div></div>';
            
            var paginationHtml = renderPagination(total, currentPage, pageSize);
            $('#listContainer').html(html + '<div class="mt-3">' + paginationHtml + '</div>');
            initTableResizer('tblHaoHut');
        }

        function renderPagination(total, page, pageSize) {
            if (total <= pageSize) return '';
            var totalPages = Math.ceil(total / pageSize);
            var html = '<nav><ul class="pagination justify-content-end mb-0">';
            
            // Prev
            if (page > 1) {
                html += '<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="loadData(' + (page - 1) + ')">Trước</a></li>';
            } else {
                html += '<li class="page-item disabled"><span class="page-link">Trước</span></li>';
            }
            
            // Pages
            for (var i = 1; i <= totalPages; i++) {
                if (i == page) {
                    html += '<li class="page-item active"><span class="page-link">' + i + '</span></li>';
                } else {
                    html += '<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="loadData(' + i + ')">' + i + '</a></li>';
                }
            }
            
            // Next
            if (page < totalPages) {
                html += '<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="loadData(' + (page + 1) + ')">Sau</a></li>';
            } else {
                html += '<li class="page-item disabled"><span class="page-link">Sau</span></li>';
            }
            
            html += '</ul></nav>';
            return html;
        }

        function formatJsonDate(jsonDate) {
            if (!jsonDate) return "";
            if (typeof jsonDate === 'string' && jsonDate.includes('T')) {
                var parts = jsonDate.split('T')[0].split('-');
                return parts[2] + '/' + parts[1] + '/' + parts[0];
            }
            if (typeof jsonDate === 'string' && jsonDate.startsWith('/Date')) {
                var dateString = jsonDate.substr(6);
                var currentTime = new Date(parseInt(dateString));
                var month = (currentTime.getMonth() + 1).toString().padStart(2, '0');
                var day = currentTime.getDate().toString().padStart(2, '0');
                var year = currentTime.getFullYear();
                return day + "/" + month + "/" + year;
            }
            var d = new Date(jsonDate);
            if (!isNaN(d.getTime())) {
                var month = (d.getMonth() + 1).toString().padStart(2, '0');
                var day = d.getDate().toString().padStart(2, '0');
                var year = d.getFullYear();
                return day + "/" + month + "/" + year;
            }
            return jsonDate;
        }

        function formatNumber(num) {
            if (num == null) return '0';
            return num.toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1,');
        }

        function resetFilter() {
            var date = new Date();
            var firstDay = new Date(date.getFullYear(), date.getMonth(), 1);
            
            var y = date.getFullYear();
            var m = (date.getMonth() + 1).toString().padStart(2, '0');
            var d = date.getDate().toString().padStart(2, '0');
            
            var fy = firstDay.getFullYear();
            var fm = (firstDay.getMonth() + 1).toString().padStart(2, '0');
            var fd = firstDay.getDate().toString().padStart(2, '0');

            var s = `${fy}-${fm}-${fd}`;
            var e = `${y}-${m}-${d}`;

            // Reset Flatpickr
            var tuNgay = $('#TuNgay')[0];
            var denNgay = $('#DenNgay')[0];
            if (tuNgay && tuNgay._flatpickr) tuNgay._flatpickr.setDate(s);
            else $('#TuNgay').val(s);

            if (denNgay && denNgay._flatpickr) denNgay._flatpickr.setDate(e);
            else $('#DenNgay').val(e);

            // Reset dropdowns
            $('.ddl-thoi-gian').val('current_month');
            $('#LoaiHaoHut').val('0');
            $('#IDKho').val('0').trigger('change');
            $('#IDSanPham').val('0').trigger('change');
            $('#SoChungTu').val('');
            $('#TrangThai').val('0');
            loadData(1);
        }

        var isOpeningModal = false;

        function disposeOldModal(modalId) {
            var oldModalEl = document.getElementById(modalId);
            if (oldModalEl) {
                var oldModal = bootstrap.Modal.getInstance(oldModalEl);
                if (oldModal) oldModal.dispose();
            }
        }

        function openCreateModal() {
            if (isOpeningModal) return;
            isOpeningModal = true;
            disposeOldModal('modalCreate');
            $.get('@Url.Action("_Create", "KHO_HaoHut")', function (html) {
                $('#modalContainer').html(html);
                var modal = new bootstrap.Modal(document.getElementById('modalCreate'));
                modal.show();
                isOpeningModal = false;
            }).fail(function() {
                isOpeningModal = false;
                showToast('error', 'Lỗi khi tải form thêm mới');
            });
        }

        function openEdit(id) {
            if (isOpeningModal) return;
            isOpeningModal = true;
            disposeOldModal('modalEdit');
            $.get('@Url.Action("_Edit", "KHO_HaoHut")?id=' + id, function (html) {
                $('#modalContainer').html(html);
                var modal = new bootstrap.Modal(document.getElementById('modalEdit'));
                modal.show();
                isOpeningModal = false;
            }).fail(function() {
                isOpeningModal = false;
                showToast('error', 'Lỗi khi tải form cập nhật');
            });
        }

        function openDetail(id) {
            if (isOpeningModal) return;
            isOpeningModal = true;
            disposeOldModal('modalDetail');
            $.get('@Url.Action("_Detail", "KHO_HaoHut")?id=' + id, function (html) {
                $('#modalContainer').html(html);
                var modal = new bootstrap.Modal(document.getElementById('modalDetail'));
                modal.show();
                isOpeningModal = false;
            }).fail(function() {
                isOpeningModal = false;
                showToast('error', 'Lỗi khi tải form chi tiết');
            });
        }

        function deleteHaoHut(id) {
            showConfirm('Bạn có chắc chắn muốn xóa phiếu hao hụt này? Dữ liệu sẽ bị xóa hoàn toàn.', function() {
                $.post('@Url.Action("Delete", "KHO_HaoHut")', { id: id }, function (res) {
                    if (res.success) {
                        showToast('success', 'Xóa thành công!');
                        loadData();
                    } else {
                        showToast('error', res.message);
                    }
                });
            });
        }

        function cancelHaoHut(id) {
            showConfirm('Bạn có chắc chắn muốn hủy ghi nhận phiếu này? Dữ liệu tồn kho sẽ được khôi phục.', function() {
                $.post('@Url.Action("Huy", "KHO_HaoHut")', { id: id }, function (res) {
                    if (res.success) {
                        showToast('success', 'Hủy thành công!');
                        loadData();
                    } else {
                        showToast('error', res.message);
                    }
                });
            });
        }

        function initTableResizer(tableId) {
            var table = document.getElementById(tableId);
            if (!table) return;
            
            var ths = table.querySelectorAll('th');
            ths.forEach(function(th) {
                if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
                if(th.innerText.trim() === 'Thao tác' || th.innerText.trim() === 'STT') return;
                if(th.querySelector('.resizer')) return;

                var resizer = document.createElement('div');
                resizer.classList.add('resizer');
                th.appendChild(resizer);

                var startX, startWidth;
                
                resizer.addEventListener('mousedown', function(e) {
                    startX = e.pageX;
                    startWidth = th.offsetWidth;
                    resizer.classList.add('resizing');

                    var doDrag = function(e) {
                        var newWidth = startWidth + (e.pageX - startX);
                        if(newWidth > 30) {
                            th.style.width = newWidth + 'px';
                            th.style.minWidth = newWidth + 'px';
                            th.style.maxWidth = newWidth + 'px';
                        }
                    };

                    var stopDrag = function(e) {
                        resizer.classList.remove('resizing');
                        document.removeEventListener('mousemove', doDrag);
                        document.removeEventListener('mouseup', stopDrag);
                    };

                    document.addEventListener('mousemove', doDrag);
                    document.addEventListener('mouseup', stopDrag);
                    
                    e.preventDefault();
                });
            });
        }
    </script>
}
