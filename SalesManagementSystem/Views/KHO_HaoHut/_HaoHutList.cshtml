@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.HaoHutHangHoaViewModel>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tblHaoHut" class="table table-custom table-bordered table-hover mb-0 align-middle" style="width:100%; min-width:1000px;">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:100px;">Thao tác</th>
                        <th class="text-center" style="width:50px;">STT</th>
                        <th>Số chứng từ</th>
                        <th>Ngày hao hụt</th>
                        <th>Loại hao hụt</th>
                        <th>Kho</th>
                        <th>Khách hàng</th>
                        <th>Đơn hàng</th>
                        <th class="text-end">Tổng SL</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover d-inline-block">
                                      <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" data-bs-boundary="window" style="padding:2px 6px;">
                                        <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                      </button>
                                      <ul class="dropdown-menu shadow">
                                        <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="openDetail(@item.ID)"><i class="bi bi-eye me-2 text-primary"></i> Xem chi tiết</a></li>
                                        @if (item.TrangThai == 1)
                                        {
                                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="openEdit(@item.ID)"><i class="bi bi-pencil me-2 text-warning"></i> Cập nhật</a></li>
                                            <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteHaoHut(@item.ID)"><i class="bi bi-trash me-2 text-danger"></i> Xóa</a></li>
                                        }
                                        @if (item.TrangThai == 2)
                                        {
                                            <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="cancelHaoHut(@item.ID)"><i class="bi bi-x-circle me-2 text-danger"></i> Hủy ghi nhận</a></li>
                                        }
                                      </ul>
                                    </div>
                                </td>
                                <td class="text-center">@(stt++)</td>
                                <td><span class="fw-bold text-primary">@item.SoChungTu</span></td>
                                <td>@(item.NgayHaoHut != null ? item.NgayHaoHut.ToString("dd/MM/yyyy") : "")</td>
                                <td>
                                    @if (item.LoaiHaoHut == 1)
                                    {
                                        <span class="badge bg-info text-dark">Hao hụt bán hàng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Hao hụt tồn kho</span>
                                    }
                                </td>
                                <td>@item.TenKho</td>
                                <td>@item.TenKhachHang</td>
                                <td>@item.SoDonHang</td>
                                <td class="text-end fw-bold">@(item.TongSoLuong != null ? item.TongSoLuong.Value.ToString("N0") : "0")</td>
                                <td class="text-end fw-bold text-danger">@(item.TongTienHaoHut != null ? item.TongTienHaoHut.Value.ToString("N0") : "0")</td>
                                <td class="text-center">
                                    @if (item.TrangThai == 1)
                                    {
                                        <span class="badge bg-secondary">Lưu nháp</span>
                                    }
                                    else if (item.TrangThai == 2)
                                    {
                                        <span class="badge bg-success">Đã ghi nhận</span>
                                    }
                                    else if (item.TrangThai == 3)
                                    {
                                        <span class="badge bg-danger">Đã hủy</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="11" class="text-center p-5 text-muted"><i class="bi bi-inbox fs-2 d-block mb-2"></i> Không tìm thấy dữ liệu</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @Html.Partial("_Pagination", Model)
</div>

<script>
    initTableResizer('tblHaoHut');
</script>
