@model IEnumerable<dynamic>
@{
    var uid = Guid.NewGuid().ToString("N");
    decimal sumTongTien = 0;
    decimal sumDaThanhToan = 0;
    decimal sumConLai = 0;
}
<div class="table-responsive">
    <table id="tblBaoCaoCongNoVanChuyen_@uid" class="table table-bordered table-hover table-custom" style="width: 100%; min-width: 1000px; white-space: nowrap;">
        <thead>
            <tr style="background-color: #f4f6f9; color: #333;">
                <th class="text-center" style="width: 50px;">STT</th>
                <th class="text-center">Số phiếu nhập</th>
                <th class="text-center">Ngày nhập</th>
                <th class="text-center">Phương tiện</th>
                <th class="text-center">Số phiếu chi</th>
                <th class="text-end">Tổng tiền vận chuyển</th>
                <th class="text-end">Đã thanh toán</th>
                <th class="text-end">Còn lại</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center" style="width: 65px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int currentPage = ViewBag.CurrentPage != null ? ViewBag.CurrentPage : 1;
                int pageSize = ViewBag.PageSize != null ? ViewBag.PageSize : 20;
                int stt = (currentPage - 1) * pageSize + 1;

                foreach (var item in Model)
                {
                    decimal currentTongTien = Convert.ToDecimal(item.TongTienVanChuyen);
                    decimal currentDaThanhToan = Convert.ToDecimal(item.DaThanhToanVanChuyen);
                    
                    sumTongTien += currentTongTien;
                    sumDaThanhToan += currentDaThanhToan;
                    sumConLai += Convert.ToDecimal(item.ConLaiVanChuyen);
                    
                    int trangThaiThanhToan = 0;
                    if (currentDaThanhToan >= currentTongTien && currentTongTien > 0)
                    {
                        trangThaiThanhToan = 2;
                    }
                    else if (currentDaThanhToan > 0)
                    {
                        trangThaiThanhToan = 1;
                    }

                    string badgeClass = trangThaiThanhToan == 0 ? "bg-danger" : (trangThaiThanhToan == 1 ? "bg-warning text-dark" : "bg-success");
                    string badgeText = trangThaiThanhToan == 0 ? "Chưa thanh toán" : (trangThaiThanhToan == 1 ? "Thanh toán một phần" : "Đã thanh toán đủ");

                    <tr>
                        <td class="text-center">@(stt++)</td>
                        <td class="text-center"><span class="badge bg-primary">@item.SoPhieuNhap</span></td>
                        <td class="text-center">@(((DateTime)item.NgayNhap).ToString("dd/MM/yyyy"))</td>
                        <td class="text-center">@item.TenPhuongTien</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.SoPhieuChiList))
                            {
                                foreach (var pc in ((string)item.SoPhieuChiList).Split(new[] { ", " }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-success me-1">@pc</span>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="text-end">@(Convert.ToDecimal(item.TongTienVanChuyen).ToString("N0"))</td>
                        <td class="text-end">@(Convert.ToDecimal(item.DaThanhToanVanChuyen).ToString("N0"))</td>
                        <td class="text-end text-danger fw-bold">@(Convert.ToDecimal(item.ConLaiVanChuyen).ToString("N0"))</td>
                        <td class="text-center">
                            <span class="badge @badgeClass rounded-pill fw-normal px-2 py-1">@badgeText</span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 btn-xem-chitiet"
                                    style="font-size: 0.75rem;"
                                    data-id="@item.IDPhieuNhap"
                                    data-loai="1"
                                    title="Xem chi tiết">
                                <i class="bi bi-eye"></i> Xem
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">Không tìm thấy dữ liệu báo cáo</td>
                </tr>
            }
        </tbody>
        @if (Model != null && Model.Any())
        {
            <tfoot>
                <tr style="background-color: #f4f6f9; font-weight: bold;">
                    <td colspan="5" class="text-end">TỔNG CỘNG TRANG:</td>
                    <td class="text-end">@sumTongTien.ToString("N0")</td>
                    <td class="text-end">@sumDaThanhToan.ToString("N0")</td>
                    <td class="text-end text-danger">@sumConLai.ToString("N0")</td>
                    <td></td>
                    <td></td>
                </tr>
            </tfoot>
        }
    </table>
</div>

@if (ViewBag.TotalRecords != null && ViewBag.TotalRecords > 0)
{
    int currentPage = ViewBag.CurrentPage;
    int pageSize = ViewBag.PageSize;
    int total = ViewBag.TotalRecords;
    int totalPages = (int)Math.Ceiling((double)total / pageSize);
    if (totalPages < 1) { totalPages = 1; }
    
    var prevDisabled = currentPage <= 1 ? "disabled" : "";
    var nextDisabled = currentPage >= totalPages ? "disabled" : "";

    <div class="card-footer custom-pagination d-flex flex-wrap align-items-center justify-content-between mt-3" style="padding: 12px 16px; background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 0.25rem;">
        <div class="d-flex align-items-center gap-3">
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0 pagination-custom">
                    <li class="page-item @prevDisabled">
                        <a class="page-link" href="#" data-page="1"><i class="bi bi-skip-start-fill"></i></a>
                    </li>
                    <li class="page-item @prevDisabled">
                        <a class="page-link" href="#" data-page="@(currentPage - 1)"><i class="bi bi-caret-left-fill"></i></a>
                    </li>
                    
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || Math.Abs(i - currentPage) <= 2)
                        {
                            var activeClass = i == currentPage ? "active" : "";
                            <li class="page-item @activeClass">
                                <a class="page-link" href="#" data-page="@i">@i</a>
                            </li>
                        }
                        else if (i == currentPage - 3 || i == currentPage + 3)
                        {
                            <li class="page-item disabled"><a class="page-link" href="#">...</a></li>
                        }
                    }

                    <li class="page-item @nextDisabled">
                        <a class="page-link" href="#" data-page="@(currentPage + 1)"><i class="bi bi-caret-right-fill"></i></a>
                    </li>
                    <li class="page-item @nextDisabled">
                        <a class="page-link" href="#" data-page="@totalPages"><i class="bi bi-skip-end-fill"></i></a>
                    </li>
                </ul>
            </nav>
            
            <div class="d-flex align-items-center">
                <select class="form-select form-select-sm page-size-select" style="width: 70px; cursor: pointer;">
                    <option value="10" @(pageSize == 10 ? "selected" : "")>10</option>
                    <option value="20" @(pageSize == 20 ? "selected" : "")>20</option>
                    <option value="50" @(pageSize == 50 ? "selected" : "")>50</option>
                    <option value="100" @(pageSize == 100 ? "selected" : "")>100</option>
                </select>
                <span class="ms-2 text-muted" style="font-size: 0.85rem;">mẫu tin/trang</span>
            </div>
        </div>
        <div class="text-muted" style="font-size: 0.85rem;">
            @{
                int start = total > 0 ? (currentPage - 1) * pageSize + 1 : 0;
                int end = Math.Min(currentPage * pageSize, total);
            }
            @start - @end của @total
        </div>
    </div>
}

<style>
    /* Tuỳ chỉnh table theo yêu cầu */
    #tblBaoCaoCongNoVanChuyen_@(uid).table-custom thead th {
        vertical-align: middle;
        background-color: #f4f6f9;
        font-weight: bold;
    }
    #tblBaoCaoCongNoVanChuyen_@(uid).table-custom tbody tr:nth-child(even) {
        background-color: #dbe6ef !important;
    }
    #tblBaoCaoCongNoVanChuyen_@(uid).table-custom tbody tr:hover {
        background-color: #c9d9e8 !important;
    }
    /* Pagination styles */
    .pagination-custom .page-item.active .page-link {
        background-color: #0b5b84;
        border-color: #0b5b84;
        color: white;
    }
    .pagination-custom .page-link {
        color: #0b5b84;
        cursor: pointer;
    }
    /* Resizer styles */
    #tblBaoCaoCongNoVanChuyen_@(uid) th {
        position: relative;
        background-clip: padding-box;
    }
    #tblBaoCaoCongNoVanChuyen_@(uid) th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblBaoCaoCongNoVanChuyen_@(uid) th .resizer:hover, #tblBaoCaoCongNoVanChuyen_@(uid) th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>

<script>
    (function() {
        var table = document.getElementById('tblBaoCaoCongNoVanChuyen_@uid');
        if (!table) return;

        // Resizer Logic
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
            if(th.innerText.trim() === 'Thao tác' || th.innerText.trim() === 'STT') return;
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');
                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };
                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };
                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                e.preventDefault();
            });
        });
    })();
</script>
