@{
    Layout = null;
    int loaiDong = ViewBag.LoaiDong != null ? (int)ViewBag.LoaiDong : 0;
}

<div class="modal fade" id="detailsModalNCC" tabindex="-1" aria-labelledby="detailsModalNCCLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">

            @* ====== PHIẾU NHẬP KHO VẬN CHUYỂN ====== *@
            @if (loaiDong == 1)
            {
                string soChungTu    = ViewBag.PN_SoChungTu ?? "";
                string tenNCC       = ViewBag.PN_TenNCC ?? "";
                string tenPhuongTien = ViewBag.PN_TenPhuongTien ?? "";
                DateTime? ngayNhap  = ViewBag.PN_NgayNhap as DateTime?;
                decimal tienVC      = ViewBag.PN_TienVanChuyen != null ? (decimal)ViewBag.PN_TienVanChuyen : 0m;
                string ghiChu       = ViewBag.PN_GhiChu ?? "";
                decimal tongVanChuyen = ViewBag.TongVanChuyen != null ? (decimal)ViewBag.TongVanChuyen : 0m;

                <div class="modal-header" style="background: linear-gradient(135deg, #0b5b84, #1a8cc1); color: white; border-bottom: none; padding: 18px 24px;">
                    <div>
                        <h5 class="modal-title fw-bold mb-1" id="detailsModalNCCLabel">
                            <i class="bi bi-box-arrow-in-down me-2"></i>Chi tiết Chi Phí Vận Chuyển Phiếu Nhập
                        </h5>
                        <div style="font-size: 0.85rem; opacity: 0.9;">
                            <span class="badge bg-light text-primary me-2 px-3 py-1" style="font-size:0.85rem;">@soChungTu</span>
                            @if (ngayNhap.HasValue)
                            {
                                <span class="me-3"><i class="bi bi-calendar3 me-1"></i>@ngayNhap.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (!string.IsNullOrEmpty(ViewBag.PN_NguoiTao))
                            {
                                <span><i class="bi bi-person me-1"></i>Người nhập: @ViewBag.PN_NguoiTao</span>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-0">
                    <!-- Info header -->
                    <div class="px-4 py-3" style="background: #f0f7ff; border-bottom: 1px solid #dbe9f5;">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;background:#e8f4fd;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-building text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted" style="font-size:0.75rem;">Nhà cung cấp</div>
                                        <div class="fw-semibold" style="font-size:0.9rem;">@tenNCC</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;background:#e8f4fd;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-truck text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted" style="font-size:0.75rem;">Phương tiện vận chuyển</div>
                                        <div class="fw-semibold" style="font-size:0.9rem;">@(string.IsNullOrEmpty(tenPhuongTien) ? "-" : tenPhuongTien)</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;background:#e8f4fd;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-calendar-event text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted" style="font-size:0.75rem;">Ngày nhập</div>
                                        <div class="fw-semibold" style="font-size:0.9rem;">
                                            @(ngayNhap.HasValue ? ngayNhap.Value.ToString("dd/MM/yyyy") : "-")
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;background:#fff3cd;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-sticky text-warning"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted" style="font-size:0.75rem;">Ghi chú</div>
                                        <div class="fw-semibold" style="font-size:0.9rem;">@(string.IsNullOrEmpty(ghiChu) ? "-" : ghiChu)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chi tiết sản phẩm -->
                    <div class="px-4 pt-3 pb-1">
                        <div class="fw-semibold text-primary mb-2" style="font-size:0.9rem;">
                            <i class="bi bi-list-ul me-1"></i>Chi tiết chi phí vận chuyển sản phẩm nhập
                        </div>
                    </div>
                    <div class="table-responsive px-4 pb-3">
                        <table class="table table-bordered table-hover" style="font-size:0.875rem;white-space:nowrap;">
                            <thead style="background:#f4f6f9;color:#333;">
                                <tr>
                                    <th class="text-center" style="width:45px;">STT</th>
                                    <th class="text-center">Mã SP</th>
                                    <th>Tên sản phẩm</th>
                                    <th class="text-center">ĐVT</th>
                                    <th class="text-end">Số lượng</th>
                                    <th class="text-end">VC/đơn vị</th>
                                    <th class="text-end">Tiền vận chuyển</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var chiTiets = ViewBag.ChiTiets as List<SalesManagementSystem.Models.ViewModels.PhieuNhapChiTietDetailViewModel>;
                                    int idx = 0;
                                    if (chiTiets != null)
                                    {
                                        foreach (var ct in chiTiets)
                                        {
                                            idx++;
                                            <tr>
                                                <td class="text-center">@idx</td>
                                                <td class="text-center"><span class="badge bg-secondary">@ct.MaSanPham</span></td>
                                                <td>@ct.TenSanPham</td>
                                                <td class="text-center">@ct.DVT</td>
                                                <td class="text-end">@ct.SoLuong.ToString("N0")</td>
                                                <td class="text-end">@(ct.DonGiaVanChuyen > 0 ? ct.DonGiaVanChuyen.ToString("N0") : "-")</td>
                                                <td class="text-end text-info">@(ct.TienVanChuyen > 0 ? ct.TienVanChuyen.ToString("N0") : "-")</td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                            <tfoot style="background:#f4f6f9;font-weight:bold;">
                                <tr>
                                    <td colspan="6" class="text-end">TỔNG CỘNG:</td>
                                    <td class="text-end text-info">@(tongVanChuyen > 0 ? tongVanChuyen.ToString("N0") : (tienVC > 0 ? tienVC.ToString("N0") : "-"))</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Summary cards -->
                    <div class="px-4 pb-4 d-flex justify-content-center">
                        <div style="width: 350px;">
                            <div class="rounded-3 p-3 text-center" style="background:#e8f8f5;border:1px solid #a9dfd0;">
                                <div class="text-muted small mb-1">Tổng tiền vận chuyển</div>
                                <div class="fw-bold text-success" style="font-size:1.4rem;">@(tongVanChuyen > 0 ? tongVanChuyen.ToString("N0") : (tienVC > 0 ? tienVC.ToString("N0") : "-"))</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ====== PHIẾU CHI THANH TOÁN ====== *@
            else if (loaiDong == 2)
            {
                string soPhieuChi     = ViewBag.PC_SoPhieuChi ?? "";
                string tenNCC         = ViewBag.PC_TenNCC ?? "";
                DateTime? ngayChi     = ViewBag.PC_NgayChi as DateTime?;
                decimal soTienChi     = ViewBag.PC_SoTienChi != null ? (decimal)ViewBag.PC_SoTienChi : 0m;
                string dienGiai       = ViewBag.PC_DienGiai ?? "";
                string hinhThuc       = ViewBag.PC_HinhThuc ?? "";
                string tenTaiKhoan    = ViewBag.PC_TenTaiKhoan ?? "";
                string nganHang       = ViewBag.PC_NganHang ?? "";
                string soChungTuNhap  = ViewBag.PC_SoChungTuNhap ?? "";

                <div class="modal-header" style="background: linear-gradient(135deg, #27ae60, #1abc9c); color: white; border-bottom: none; padding: 18px 24px;">
                    <div>
                        <h5 class="modal-title fw-bold mb-1" id="detailsModalNCCLabel">
                            <i class="bi bi-cash-coin me-2"></i>Chi tiết Phiếu Thanh Toán
                        </h5>
                        <div style="font-size: 0.85rem; opacity: 0.9;">
                            <span class="badge bg-light text-success me-2 px-3 py-1" style="font-size:0.85rem;">@soPhieuChi</span>
                            @if (ngayChi.HasValue)
                            {
                                <span class="me-3"><i class="bi bi-calendar3 me-1"></i>@ngayChi.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (!string.IsNullOrEmpty(ViewBag.PC_NguoiTao))
                            {
                                <span><i class="bi bi-person me-1"></i>Người lập: @ViewBag.PC_NguoiTao</span>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-4 p-2">
                        <div class="col-md-6">
                            <div class="card h-100 shadow-none border" style="border-radius:8px;">
                                <div class="card-header bg-light fw-bold py-2" style="font-size:0.85rem;">Thông tin thanh toán</div>
                                <div class="card-body py-2">
                                    <table class="table table-sm table-borderless mb-0" style="font-size:0.85rem;">
                                        <tr>
                                            <td class="text-muted" style="width:140px;">Nhà cung cấp / Đối tượng:</td>
                                            <td class="fw-semibold">@tenNCC</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Ngày thanh toán:</td>
                                            <td>@(ngayChi.HasValue ? ngayChi.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Hình thức thanh toán:</td>
                                            <td class="fw-semibold text-success">@hinhThuc</td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(tenTaiKhoan))
                                        {
                                            <tr>
                                                <td class="text-muted">Tài khoản:</td>
                                                <td>@tenTaiKhoan @(string.IsNullOrEmpty(nganHang) ? "" : $"({nganHang})")</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td class="text-muted">Số chứng từ gốc:</td>
                                            <td><span class="badge bg-light text-dark border">@soChungTuNhap</span></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card h-100 shadow-none border" style="border-radius:8px;">
                                <div class="card-header bg-light fw-bold py-2" style="font-size:0.85rem;">Chi tiết số tiền</div>
                                <div class="card-body d-flex flex-column justify-content-center align-items-center py-2">
                                    <div class="text-muted small mb-1">Số tiền đã chi</div>
                                    <div class="fw-bold text-success" style="font-size:2rem;">@soTienChi.ToString("N0")</div>
                                    @if (!string.IsNullOrEmpty(dienGiai))
                                    {
                                        <div class="mt-2 text-center text-muted small px-3">
                                            <i class="bi bi-info-circle me-1"></i>@dienGiai
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="modal-footer" style="background:#f8f9fa; border-top: 1px solid #dee2e6; padding: 12px 24px;">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Đóng
                </button>
            </div>

        </div>
    </div>
</div>
