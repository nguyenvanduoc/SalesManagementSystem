@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.AclLoginSessionViewModel>

<div class="table-responsive">
    <table id="tblLoginSessionList" class="table table-custom table-bordered table-hover align-middle" style="width:100%; min-width:1000px;">
        <thead>
            <tr>
                <th class="text-center" width="50">STT</th>
                <th>Tài khoản</th>
                <th>Họ tên</th>
                <th class="text-center">Thời gian Login</th>
                <th class="text-center">Thời gian Logout</th>
                <th class="text-center">Thời lượng</th>
                <th>Địa chỉ IP</th>
                <th>Trình duyệt</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items != null && Model.Items.Any())
            {
                int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">@stt</td>
                        <td><span class="fw-bold">@item.TenDangNhap</span></td>
                        <td>@item.HoTen</td>
                        <td class="text-center text-success">@item.ThoiGianLogin.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td class="text-center text-danger">@(item.ThoiGianLogout.HasValue ? item.ThoiGianLogout.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-")</td>
                        <td class="text-center">
                            @if (!item.ThoiGianLogout.HasValue)
                            {
                                bool isReallyActive = true;
                                if (item.LastActiveTime.HasValue)
                                {
                                    var timeSinceLastActive = DateTime.Now - item.LastActiveTime.Value;
                                    if (timeSinceLastActive.TotalMinutes > 5)
                                    {
                                        isReallyActive = false;
                                    }
                                }
                                else
                                {
                                    // Không có ping nào, xem như đang hoạt động hoặc dùng login time (ít hơn 5 phút trước)
                                    var timeSinceLogin = DateTime.Now - item.ThoiGianLogin;
                                    if (timeSinceLogin.TotalMinutes > 5)
                                    {
                                        isReallyActive = false;
                                    }
                                }

                                if (isReallyActive)
                                {
                                    <span class="badge bg-success">Đang trực tuyến</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark" title="Hết tương tác / Treo máy">Treo máy (Away)</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.ThoiLuong</span>
                            }
                        </td>
                        <td>@item.IP</td>
                        <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.TrinhDuyet">@item.TrinhDuyet</td>
                        <td class="text-center">
                            @if (item.IsDangHoatDong)
                            {
                                <button type="button" class="btn btn-sm btn-danger btn-kick" data-id="@item.ID" title="Kích người dùng này">
                                    <i class="fas fa-sign-out-alt"></i> Kích
                                </button>
                            }
                        </td>
                    </tr>
                    stt++;
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-4">Không có dữ liệu lịch sử đăng nhập.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@Html.Partial("_Pagination", Model)

<style>
    #tblLoginSessionList th {
        position: relative;
        background-clip: padding-box;
    }
    #tblLoginSessionList th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblLoginSessionList th .resizer:hover, #tblLoginSessionList th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var table = document.getElementById('tblLoginSessionList');
        if (!table) return;
        
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            // Skip for icon columns, checkbox columns and action columns
            if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
            if(th.innerText.trim() === 'Thao tác' || th.innerText.trim() === 'STT') return;
            
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                
                e.preventDefault();
            });
        });
    })();
</script>
