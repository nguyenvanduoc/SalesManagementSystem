@model SalesManagementSystem.Models.ViewModels.PhieuXuatKhoViewModel
@{
    ViewBag.Title = "Tạo Phiếu Xuất Kho";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom">
                <h4 class="card-title">Tạo Phiếu Xuất Kho từ Đơn Đặt Hàng: @Model.SoDonHang</h4>
            </div>
            <div class="card-body">
                 <form id="frmSavePX">
                    @Html.HiddenFor(m => m.IDDonDatHang)
                    @Html.HiddenFor(m => m.SoChungTu)
                    
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label>Số chứng từ</label>
                            <input type="text" class="form-control" value="@Model.SoChungTu" readonly />
                        </div>
                        <div class="col-md-3">
                            <label>Ngày xuất</label>
                            @Html.TextBoxFor(m => m.NgayXuat, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        </div>
                        <div class="col-md-3">
                            <label>Khách hàng</label>
                            <input type="text" class="form-control" value="@Model.TenKhachHang" readonly />
                        </div>
                        <div class="col-md-3">
                            <label>Kho xuất</label>
                            @Html.DropDownListFor(m => m.IDKho, (SelectList)ViewBag.KhoList, "-- Chọn kho --", new { @class = "form-control", id = "IDKho" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label>Ghi chú xuất kho</label>
                            @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = 2 })
                        </div>
                    </div>

                    <div class="table-responsive mb-3">
                        <table class="table table-bordered">
                            <thead class="thead-light">
                                <tr>
                                    <th>STT</th>
                                    <th>Sản phẩm</th>
                                    <th>ĐVT</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for(int i = 0; i < Model.ChiTiets.Count; i++)
                                {
                                    <tr>
                                        <td>@Model.ChiTiets[i].STT
                                            <input type="hidden" name="ChiTiets[@i].STT" value="@Model.ChiTiets[i].STT" />
                                            <input type="hidden" name="ChiTiets[@i].IDSanPham" value="@Model.ChiTiets[i].IDSanPham" />
                                        </td>
                                        <td>@Model.ChiTiets[i].MaSanPham - @Model.ChiTiets[i].TenSanPham</td>
                                        <td>@Model.ChiTiets[i].DVT</td>
                                        <td>
                                            @Model.ChiTiets[i].SoLuong.ToString("N0")
                                            <input type="hidden" name="ChiTiets[@i].SoLuong" value="@Model.ChiTiets[i].SoLuong" />
                                        </td>
                                        <td>
                                            @Model.ChiTiets[i].DonGia.ToString("N0")
                                            <input type="hidden" name="ChiTiets[@i].DonGia" value="@Model.ChiTiets[i].DonGia" />
                                        </td>
                                        <td>
                                            @Model.ChiTiets[i].ThanhTien.ToString("N0")
                                            <input type="hidden" name="ChiTiets[@i].ThanhTien" value="@Model.ChiTiets[i].ThanhTien" />
                                            
                                            <input type="hidden" name="ChiTiets[@i].ThueGTGT" value="@Model.ChiTiets[i].ThueGTGT" />
                                            <input type="hidden" name="ChiTiets[@i].TienThue" value="@Model.ChiTiets[i].TienThue" />
                                            <input type="hidden" name="ChiTiets[@i].TongSauThue" value="@Model.ChiTiets[i].TongSauThue" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="5" class="text-right">Tổng tiền hàng:</th>
                                    <th>@Model.TongTienHang.ToString("N0")
                                        <input type="hidden" name="TongTienHang" value="@Model.TongTienHang" />
                                        <input type="hidden" name="TongTienThue" value="@Model.TongTienThue" />
                                        <input type="hidden" name="TongCong" value="@Model.TongCong" />
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="row">
                        <div class="col-12 text-right">
                            <button type="button" class="btn btn-primary" onclick="PhieuXuatKho.save()"><i class="fas fa-save"></i> Lưu Đề nghị ghi</button>
                            <a href="/PhieuXuatKho/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/phieu-xuat-kho.js"></script>
}
