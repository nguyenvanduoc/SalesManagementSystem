@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.PhieuXuatKhoListViewModel>
@{
    ViewBag.Title = "Phiếu Xuất Kho";
    var uid = Guid.NewGuid().ToString("N");
}

<div id="pxk-@uid">
    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
        <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">
            @ViewBag.Title
        </h4>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <form id="searchForm" action="@Url.Action("GetList")" method="get">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Từ ngày</label>
                        <input type="date" name="tuNgay" class="form-control form-control-sm" value="@ViewBag.TuNgay" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Đến ngày</label>
                        <input type="date" name="denNgay" class="form-control form-control-sm" value="@ViewBag.DenNgay" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Số phiếu xuất</label>
                        <input type="text" name="soChungTu" class="form-control form-control-sm" placeholder="Nhập số phiếu xuất..." value="@ViewBag.SoChungTu" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small mb-1">Kho hàng</label>
                        @Html.DropDownList("idKho", (SelectList)ViewBag.Khos, "-- Tất cả --", new { @class = "form-select form-select-sm" })
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small mb-1">Trạng thái</label>
                        <select name="trangThai" class="form-select form-select-sm">
                            <option value="">-- Tất cả --</option>
                            <option value="1" @(ViewBag.TrangThai == 1 ? "selected" : "")>Đề nghị ghi</option>
                            <option value="2" @(ViewBag.TrangThai == 2 ? "selected" : "")>Đã ghi</option>
                            <option value="3" @(ViewBag.TrangThai == 3 ? "selected" : "")>Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2 mt-3 justify-content-end">
                        <button type="submit" class="btn btn-sm text-white px-3" style="background-color: #2998e4; border: none;">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                        <button type="button" class="btn btn-sm text-white px-3 btn-reset" style="background-color: #f1c40f; border: none;">
                            Làm mới
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="table-container">
        @Html.Partial("_PhieuXuatKhoList", Model)
    </div>
</div>

<div id="modalContainer"></div>

@section Scripts {
    <script src="~/Scripts/phieu-xuat-kho.js"></script>
    <script>
        (function() {
            var $container = $('#pxk-@uid');
            var $form = $container.find('#searchForm');

            $(document).ready(function() {
                $form.on('submit', function (e) {
                    e.preventDefault();
                    var params = $(this).serialize();
                    var url = '@Url.Action("GetList")?' + params;
                    $.ajax({
                        url: url,
                        type: 'GET',
                        success: function (res) {
                            $container.find('#table-container').html(res);
                        },
                        error: function () {
                            if (typeof showToast === 'function') {
                                showToast('error', 'Lỗi khi tải dữ liệu.');
                            }
                        }
                    });
                });

                // Delegate row clicks for inline detail view
                $container.on('click', '.pxk-row', function (e) {
                    if ($(e.target).closest('a, button, select, input, .dropdown, .dropdown-menu').length) {
                        return;
                    }

                    var $row = $(this);
                    var id = $row.data('id');
                    if (!id) return;

                    var $nextRow = $row.next();
                    var isAlreadyExpanded = $nextRow.hasClass('pxk-detail-row') && $nextRow.data('parent-id') == id;

                    // Close any currently open detail rows in this container
                    $container.find('.pxk-detail-row').remove();
                    $container.find('.pxk-row').removeClass('active-row');
                    $container.find('.toggle-icon').removeClass('bi-caret-down-fill text-primary').addClass('bi-caret-right-fill text-muted');

                    if (isAlreadyExpanded) {
                        return;
                    }

                    // Highlight active row
                    $row.addClass('active-row');
                    $row.find('.toggle-icon').removeClass('bi-caret-right-fill text-muted').addClass('bi-caret-down-fill text-primary');

                    // Create placeholder detail row
                    var $detailRow = $('<tr class="pxk-detail-row" data-parent-id="' + id + '">' +
                        '<td colspan="11" class="p-3" style="background-color: #fcfdfd; border-left: 4px solid #2998e4;">' +
                        '   <div class="text-center p-4 text-muted">' +
                        '       <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>' +
                        '       Đang tải chi tiết...' +
                        '   </div>' +
                        '</td>' +
                        '</tr>');

                    $row.after($detailRow);

                    // Load content
                    $.ajax({
                        url: '@Url.Action("GetDetailInline", "PhieuXuatKho")',
                        type: 'GET',
                        data: { id: id },
                        success: function (res) {
                            $detailRow.find('td').html('<div class="detail-container p-2" style="display:none;">' + res + '</div>');
                            $detailRow.find('.detail-container').slideDown(250);
                        },
                        error: function () {
                            $detailRow.find('td').html('<div class="p-3 text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Lỗi khi tải thông tin chi tiết</div>');
                        }
                    });
                });
            });

            $container.find('.btn-reset').on('click', function() {
                $form[0].reset();
                $form.trigger('submit');
            });
        })();

    </script>
}
