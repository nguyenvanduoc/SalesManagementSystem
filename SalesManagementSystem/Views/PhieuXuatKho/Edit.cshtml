@model SalesManagementSystem.Models.ViewModels.PhieuXuatKhoViewModel
@using System.Linq
@{
    ViewBag.Title = Model.ID == 0 ? "Thêm mới Phiếu xuất kho" : "Cập nhật Phiếu xuất kho";
    var isView = ViewBag.IsView != null ? (bool)ViewBag.IsView : Model.IsReadOnly;
    string chiTietsJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChiTiets ?? new List<SalesManagementSystem.Models.ViewModels.PhieuXuatKhoChiTietViewModel>());
}

<style>
    .don-header-card { background:#fff; border:1px solid #dce4ec; border-radius:6px; padding:16px; margin-bottom:12px; box-shadow:0 1px 4px rgba(0,0,0,.06); }
    .don-section-title { font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:#7f8c8d; margin-bottom:10px; }
    .grid-detail thead th { background:#f4f6f9; font-size:.8rem; font-weight:700; color:#2c3e50; vertical-align:middle; white-space:nowrap; text-align:center !important; }
    .grid-detail tbody td { vertical-align:middle; padding:5px 6px; }
    .grid-detail input.form-control, .grid-detail select.form-select { font-size:.85rem; padding:3px 7px; height:30px; }
    .btn-add-row { background:#2ecc71; color:#fff; border:none; border-radius:4px; padding:5px 14px; font-size:.85rem; }
    .btn-add-row:hover { background:#27ae60; color:#fff; }
    .readonly-cell { background:#f8f9fa; font-size:.85rem; color:#495057; border: 1px solid #ced4da; }
    .form-toolbar { background:#f8f9fa; border:1px solid #dce4ec; border-radius:6px; padding:10px 16px; margin-bottom:12px; display:flex; gap:8px; align-items:center; }
    .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #ced4da; border-radius: 0.375rem; }
    .select2-container--default .select2-selection--single .select2-selection__rendered { font-size: .85rem; color: #495057; line-height: 36px; padding-left: 12px; }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
</style>

@{ string containerId = "pxk_edit_" + Guid.NewGuid().ToString("N"); }

<div id="@containerId">
@if (ViewBag.IsInlineDetail != true)
{
    <!-- Toolbar -->
    <div class="form-toolbar mt-3">
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        @if (!isView)
        {
            <button type="button" id="btnSaveDraft" class="btn btn-sm btn-secondary me-1 shadow-sm">
                <i class="bi bi-file-earmark-text me-1"></i> Lưu nháp
            </button>
            <button type="button" id="btnSavePhieu" class="btn btn-sm text-white shadow-sm" style="background-color:#2998e4;border:none;">
                <i class="bi bi-save me-1"></i> Lưu phiếu xuất (Ghi sổ)
            </button>
        }
        <span class="text-muted small ms-auto fw-bold">
            <i class="bi bi-box-arrow-up-right me-1"></i> @(isView ? "XEM CHI TIẾT PHIẾU XUẤT KHO" : ViewBag.Title)
        </span>
    </div>
}

<form id="frmPhieuXuatKho" autocomplete="off">
    <input type="hidden" id="ID" value="@Model.ID" />
    <input type="hidden" id="hdIDKho" value="@Model.IDKho" />
    <input type="hidden" id="hdIDKhachHang" value="@(Model.IDKhachHang ?? 0)" />
    <input type="hidden" id="hdIDNhaCungCap" value="@(Model.IDNhaCungCap ?? 0)" />
    <input type="hidden" id="hdIDPhuongTien" value="@(Model.IDPhuongTien ?? 0)" />
    
    <div class="row g-3">
        <!-- Nội dung chính -->
        <div class="col-md-12">

            @if (ViewBag.IsInlineDetail != true)
            {
                <!-- Card: Thông tin đối tác & Kho -->
                <div class="don-header-card">
                    <div class="don-section-title"><i class="bi bi-building me-1"></i>Thông tin đối tác & Kho xuất</div>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-semibold small">Kho xuất <span class="text-danger">*</span></label>
                            <select id="IDKho_@containerId" class="sel-IDKho form-control no-select2" style="width:100%;" @(isView ? "disabled" : "")>
                                @if (Model.IDKho > 0)
                                {
                                    <option value="@Model.IDKho" selected>@Model.TenKhoHang</option>
                                }
                                else
                                {
                                    <option value=""></option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-semibold small">Khách hàng</label>
                            <select id="IDKhachHang_@containerId" class="sel-IDKhachHang form-control no-select2" style="width:100%;" @(isView ? "disabled" : "")>
                                @if (Model.IDKhachHang.HasValue && Model.IDKhachHang.Value > 0)
                                {
                                    <option value="@Model.IDKhachHang.Value" selected>@Model.TenKhachHang</option>
                                }
                                else
                                {
                                    <option value=""></option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-semibold small">Nhà cung cấp</label>
                            <select id="IDNhaCungCap_@containerId" class="sel-IDNhaCungCap form-control no-select2" style="width:100%;" @(isView ? "disabled" : "")>
                                @if (Model.IDNhaCungCap.HasValue && Model.IDNhaCungCap.Value > 0)
                                {
                                    <option value="@Model.IDNhaCungCap.Value" selected>@Model.TenNhaCungCap</option>
                                }
                                else
                                {
                                    <option value=""></option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Người nhận</label>
                            <input type="text" id="TenNguoiNhan" class="form-control form-control-sm" value="@Model.TenNguoiNhan" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">SĐT người nhận</label>
                            <input type="text" id="SoDienThoaiNguoiNhan" class="form-control form-control-sm" value="@Model.SoDienThoaiNguoiNhan" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Người giao hàng</label>
                            <input type="text" id="TenNguoiGiao" class="form-control form-control-sm" value="@Model.TenNguoiGiao" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">SĐT người giao</label>
                            <input type="text" id="SoDienThoaiNguoiGiao" class="form-control form-control-sm" value="@Model.SoDienThoaiNguoiGiao" @(isView ? "disabled" : "") />
                        </div>
                    </div>
                </div>

                <!-- Card: Thông tin vận chuyển -->
                <div class="don-header-card">
                    <div class="don-section-title"><i class="bi bi-truck me-1"></i>Thông tin vận chuyển</div>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Phương tiện</label>
                            <select id="IDPhuongTien_@containerId" class="sel-IDPhuongTien form-control no-select2" style="width:100%;" @(isView ? "disabled" : "")>
                                @if (Model.IDPhuongTien.HasValue && Model.IDPhuongTien.Value > 0)
                                {
                                    <option value="@Model.IDPhuongTien.Value" selected>@Model.TenPhuongTien</option>
                                }
                                else
                                {
                                    <option value=""></option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Ngày giao hàng</label>
                            <input type="date" id="NgayGiaoHang" class="form-control form-control-sm" value="@(Model.NgayGiaoHang?.ToString("yyyy-MM-dd"))" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Tài xế</label>
                            <input type="text" id="HoTenTaiXe" class="form-control form-control-sm" value="@Model.HoTenTaiXe" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">SĐT Tài xế</label>
                            <input type="text" id="SoDienThoaiTaiXe" class="form-control form-control-sm" value="@Model.SoDienThoaiTaiXe" @(isView ? "disabled" : "") />
                        </div>
                    </div>
                </div>

                <!-- Card: Thông tin chứng từ -->
                <div class="don-header-card">
                    <div class="don-section-title"><i class="bi bi-file-earmark-text me-1"></i>Thông tin chứng từ</div>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Số chứng từ <span class="text-danger">*</span></label>
                            <input type="text" id="SoChungTu" class="form-control form-control-sm readonly-cell fw-bold text-primary" value="@Model.SoChungTu" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Ngày xuất <span class="text-danger">*</span></label>
                            <input type="date" id="NgayXuat" class="form-control form-control-sm" value="@Model.NgayXuat.ToString("yyyy-MM-dd")" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Số hóa đơn</label>
                            <input type="text" id="SoHoaDon" class="form-control form-control-sm" value="@Model.SoHoaDon" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted fw-semibold small">Ngày hóa đơn</label>
                            <input type="date" id="NgayHoaDon" class="form-control form-control-sm" value="@(Model.NgayHoaDon?.ToString("yyyy-MM-dd"))" @(isView ? "disabled" : "") />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-muted fw-semibold small">Ghi chú</label>
                            <textarea id="GhiChu" class="form-control form-control-sm" rows="1" @(isView ? "disabled" : "") placeholder="Nhập ghi chú...">@Model.GhiChu</textarea>
                        </div>
                    </div>
                </div>
            }

            <!-- Card: Grid chi tiết sản phẩm -->
            <div class="@(ViewBag.IsInlineDetail == true ? "" : "don-header-card mb-0")">
                @if (ViewBag.IsInlineDetail != true)
                {
                    <div class="d-flex align-items-center mb-2 gap-2">
                        <div class="don-section-title mb-0"><i class="bi bi-table me-1"></i>Chi tiết hàng hóa xuất kho</div>
                        @if (!isView)
                        {
                            <button type="button" class="btn-add-row ms-auto shadow-sm" id="PXK_btnAddRow">
                                <i class="bi bi-plus-lg me-1"></i> Thêm mặt hàng
                            </button>
                        }
                    </div>
                }
                <div class="table-responsive">
                    <table class="table @(ViewBag.IsInlineDetail == true ? "table-hover align-middle table-borderless" : "table-bordered table-custom") grid-detail mb-0" id="PXK_tblChiTiet" style="min-width:900px;">
                        <thead>
                            <tr>
                                <th style="width:40px;">STT</th>
                                <th style="min-width:240px;" class="text-start">Sản phẩm</th>
                                <th style="width:70px;">ĐVT</th>
                                <th style="width:100px;">Số lượng</th>
                                <th style="width:120px;">Đơn giá</th>
                                <th style="width:120px;">Ngày sản xuất</th>
                                <th style="width:120px;">Hạn sử dụng</th>
                                <th style="width:130px;">Thành tiền</th>
                                <th style="width:70px;" class="d-none">Thuế %</th>
                                <th style="width:110px;" class="d-none">Tiền thuế</th>
                                <th style="width:130px;">Tổng cộng</th>
                                <th style="min-width:140px;">Ghi chú</th>
                                @if (!isView) { <th style="width:40px;"></th> }
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Rendered by JS -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Card: Tổng tiền -->
            <div class="@(ViewBag.IsInlineDetail == true ? "py-3 px-2 border-top mt-1" : "don-header-card mt-3 mb-0")">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small me-2">Trạng thái:</span>
                        @if (Model.TrangThai == 1) { <span class="badge bg-secondary" id="badgeTrangThai">Đề nghị ghi</span> }
                        else if (Model.TrangThai == 2) { <span class="badge bg-success" id="badgeTrangThai">Đã ghi</span> }
                        else if (Model.TrangThai == 3) { <span class="badge bg-danger" id="badgeTrangThai">Đã hủy</span> }
                        else { <span class="badge bg-secondary" id="badgeTrangThai">Thêm mới</span> }
                    </div>
                    
                    <div class="d-flex align-items-center gap-3">
                        <div>
                            <span class="text-muted small me-1">Tổng số lượng:</span>
                            <span class="fs-6 text-dark fw-bold" id="dispTongSoLuong">@(Model.ChiTiets != null ? Model.ChiTiets.Sum(c => c.SoLuong).ToString("N0") : "0")</span>
                        </div>
                        <div>
                            <span class="text-muted small me-1">Cộng tiền hàng:</span>
                            <span class="fs-6 text-dark fw-bold" id="dispTongTienHang">0</span>
                        </div>
                        <div class="d-none">
                            <span class="text-muted small me-1">Tiền thuế GTGT:</span>
                            <span class="fs-6 text-dark fw-bold" id="dispTongTienThue">0</span>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted text-uppercase fw-bold">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold" style="color:#1a5276;" id="dispTongCong">0</span>
                        <span class="text-muted small">VNĐ</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>
</div>

<script src="@Url.Content("~/Scripts/phieu-xuat-kho.js?v=4.0")"></script>
<script>
    $(document).ready(function () {
        var $form = $('#frmPhieuXuatKho').last();
        var $pane = $form.closest('.tab-pane');
        if ($pane.length === 0) $pane = $(document);

        PhieuXuatKho.init({
            searchKhoUrl: '@Url.Action("SearchKhoHang")',
            searchKhachHangUrl: '@Url.Action("SearchKhachHang")',
            searchNccUrl: '@Url.Action("SearchNhaCungCap")',
            searchSpUrl: '@Url.Action("SearchSanPham")',
            searchPhuongTienUrl: '@Url.Action("SearchPhuongTien")',
            chiTietsJson: @Html.Raw(chiTietsJson),
            selectedKhoId: @(Model.IDKho > 0 ? Model.IDKho.ToString() : "null"),
            selectedKhoText: '@Html.Raw(Model.TenKhoHang)',
            selectedKhachHangId: @(Model.IDKhachHang.HasValue && Model.IDKhachHang.Value > 0 ? Model.IDKhachHang.Value.ToString() : "null"),
            selectedKhachHangText: '@Html.Raw(Model.TenKhachHang)',
            selectedNccId: @(Model.IDNhaCungCap.HasValue && Model.IDNhaCungCap.Value > 0 ? Model.IDNhaCungCap.Value.ToString() : "null"),
            selectedNccText: '@Html.Raw(Model.TenNhaCungCap)',
            selectedPhuongTienId: @(Model.IDPhuongTien.HasValue && Model.IDPhuongTien.Value > 0 ? Model.IDPhuongTien.Value.ToString() : "null"),
            selectedPhuongTienText: '@Html.Raw(Model.TenPhuongTien)',
            isReadOnly: @(isView.ToString().ToLower())
        });

        $pane.find('#btnSaveDraft').off('click').on('click', function () {
            var data = PhieuXuatKho.validateAndSerialize($form);
            if (!data) return;
            data.TrangThai = 1; // Lưu nháp / Đề nghị ghi

            showConfirm("Bạn có chắc chắn muốn lưu nháp phiếu xuất này?", function() {
                $.ajax({
                    url: '@Url.Action("Save")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        if (res.success) {
                            showToast('success', res.message);
                            if (data.ID == 0 && res.id) {
                                $form.find('#ID').val(res.id);
                                $form.find('#SoChungTu').val(res.soChungTu);
                                $form.find('#badgeTrangThai').text('Đề nghị ghi');
                            } else {
                                $form.find('#badgeTrangThai').text('Đề nghị ghi');
                            }
                        } else {
                            showToast('error', res.message);
                        }
                    },
                    error: function () { showToast('error', 'Đã xảy ra lỗi hệ thống'); }
                });
            });
        });

        $pane.find('#btnSavePhieu').off('click').on('click', function () {
            var data = PhieuXuatKho.validateAndSerialize($form);
            if (!data) return;
            data.TrangThai = 2; // Lưu và ghi sổ (trừ kho)

            showConfirm("Bạn có chắc chắn muốn lưu và ghi sổ phiếu xuất này? Kho xuất sẽ được trừ tồn kho.", function() {
                $.ajax({
                    url: '@Url.Action("Save")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        if (res.success) {
                            showToast('success', res.message);
                            if (data.ID == 0 && res.id) {
                                $form.find('#ID').val(res.id);
                                $form.find('#SoChungTu').val(res.soChungTu);
                            }
                            $form.find('#badgeTrangThai').removeClass('bg-secondary bg-danger').addClass('bg-success').text('Đã ghi');
                            $form.find('#btnSavePhieu, #btnSaveDraft, .btn-remove-row, #PXK_btnAddRow').hide();
                            $form.find('.sel-sanpham, .txt-soluong, .txt-dongia, .txt-thue, .txt-ghichu').prop('disabled', true);
                            $form.find('select, input, textarea').prop('disabled', true);
                        } else {
                            showToast('error', res.message);
                        }
                    },
                    error: function () { showToast('error', 'Đã xảy ra lỗi hệ thống khi lưu phiếu xuất.'); }
                });
            });
        });
    });
</script>
