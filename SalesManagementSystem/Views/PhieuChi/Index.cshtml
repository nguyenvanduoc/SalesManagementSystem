@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.PhieuChiListViewModel>

@{
    ViewBag.Title = "Phiếu Chi";
    var dashboard = ViewBag.Dashboard as SalesManagementSystem.Models.ViewModels.PhieuChiDashboardViewModel;
    if (dashboard == null)
    {
        dashboard = new SalesManagementSystem.Models.ViewModels.PhieuChiDashboardViewModel
        {
            TongChiText = "0 đ",
            TongChiTrend = "0% so với tháng trước",
            TongChiTrendClass = "stable",
            QuyTienMatText = "0 đ",
            QuyTienMatStatus = "",
            DuNganHangText = "0 đ",
            DuNganHangCount = 0,
            CongNoNccText = "0 đ",
            CongNoNccLabel = ""
        };
    }
}

<style>
    /* Stat Cards CSS */
    .stat-card {
        background: #fff;
        border-radius: 10px;
        padding: 12px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 10px rgba(0,0,0,.03);
        border: 1px solid #eef2f5;
        transition: transform .2s, box-shadow .2s;
        height: 85px;
    }
    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,.06);
    }
    .stat-body {
        flex-grow: 1;
    }
    .stat-body .label {
        font-size: 0.7rem;
        color: #8c98a5;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }
    .stat-body .value {
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.1;
        color: #1e293b;
    }
    .stat-body .trend {
        font-size: 0.68rem;
        margin-top: 2px;
        display: inline-block;
        font-weight: 500;
    }
    .stat-icon-wrap {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .stat-icon-wrap i {
        font-size: 1.1rem !important;
    }
    
    /* Color modifiers */
    .bg-light-red { background-color: #fdf2f2; color: #ef5350; }
    .bg-light-blue { background-color: #f0f7ff; color: #2563eb; }
    .bg-light-teal { background-color: #f0fdf4; color: #0d9488; }
    .bg-light-orange { background-color: #fffbeb; color: #d97706; }

    .trend.up { color: #10b981; }
    .trend.down { color: #ef4444; }
    .trend.stable { color: #64748b; }
</style>

<!-- Header UI theo chuẩn Premium -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold text-uppercase" style="color:#0b5b84;font-size:1.25rem;">
            PHIẾU CHI
        </h4>
    </div>
    <div class="d-flex gap-2">
        @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("PhieuChi", SalesManagementSystem.Helpers.LoaiPhanQuyen.Them))
        {
            <button type="button" class="btn text-white fw-bold px-3 d-flex align-items-center gap-1" style="background-color:#0b5b84;border:none;"
                    onclick="openFormModal('@Url.Action("Create","PhieuChi")')">
                <i class="bi bi-plus-lg fw-bold"></i> Thêm mới
            </button>
        }
        <button type="button" class="btn text-white fw-bold px-3 d-flex align-items-center gap-1 btn-export-excel" style="background:#2ecc71;border:none;">
            <i class="bi bi-file-earmark-excel"></i> Xuất Excel
        </button>
    </div>
</div>


<!-- Bộ lọc tìm kiếm -->
<div class="card shadow-sm mb-4">
    <div class="col-md-12">
        <form id="searchForm" action="@Url.Action("GetList", "PhieuChi")" method="get" class="bg-white p-3 rounded shadow-sm mb-3">
            <div class="row gx-2 gy-2 align-items-end">
                
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Thời gian</label>
                    <select class="form-select form-select-sm ddl-thoi-gian">
                                <option value="current_month">Đầu tháng đến hiện tại</option>
                        <option value="month_1">Tháng 1</option>
                        <option value="month_2">Tháng 2</option>
                        <option value="month_3">Tháng 3</option>
                        <option value="month_4">Tháng 4</option>
                        <option value="month_5">Tháng 5</option>
                        <option value="month_6">Tháng 6</option>
                        <option value="month_7">Tháng 7</option>
                        <option value="month_8">Tháng 8</option>
                        <option value="month_9">Tháng 9</option>
                        <option value="month_10">Tháng 10</option>
                        <option value="month_11">Tháng 11</option>
                        <option value="month_12">Tháng 12</option>
                        <option value="quarter_1">Quý 1</option>
                        <option value="quarter_2">Quý 2</option>
                        <option value="quarter_3">Quý 3</option>
                        <option value="quarter_4">Quý 4</option>
                            <option value="current_year">Từ đầu năm đến hiện tại</option>
                    </select>
                </div>
                <div class="col-md col-sm-6">
                    <label class="form-label text-muted small mb-1 fw-semibold">Từ ngày</label>
                    <input type="date" class="form-control form-control-sm" name="tuNgay" value="@ViewBag.TuNgay" />
                </div>
                <div class="col-md col-sm-6">
                    <label class="form-label text-muted small mb-1 fw-semibold">Đến ngày</label>
                    <input type="date" class="form-control form-control-sm" name="denNgay" value="@ViewBag.DenNgay" />
                </div>
                <div class="col-md col-sm-6">
                    <label class="form-label text-muted small mb-1 fw-semibold">Số phiếu</label>
                    <input type="text" class="form-control form-control-sm" name="soPhieuChi" value="@ViewBag.SoPhieuChi" placeholder="Nhập số phiếu..." />
                </div>
                <div class="col-md col-sm-6">
                    <label class="form-label text-muted small mb-1 fw-semibold">Người nhận</label>
                    <input type="text" class="form-control form-control-sm" name="nguoiNhanTien" value="@ViewBag.NguoiNhanTien" placeholder="Họ tên..." />
                </div>
                <div class="col-md col-sm-6">
                    <label class="form-label text-muted small mb-1 fw-semibold">Khoản mục chi</label>
                    <select class="form-select form-select-sm" name="idKhoanMucChi">
                        <option value="">Tất cả</option>
                        @if (ViewBag.KhoanMucList != null)
                        {
                            foreach (SelectListItem item in ViewBag.KhoanMucList)
                            {
                                <option value="@item.Value" @(item.Value == (ViewBag.IDKhoanMucChi != null ? ViewBag.IDKhoanMucChi.ToString() : "") ? "selected" : "")>@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md col-sm-6">
                    <label class="form-label text-muted small mb-1 fw-semibold">Tài khoản chi</label>
                    <select class="form-select form-select-sm" name="idTaiKhoanThanhToan">
                        <option value="">Tất cả</option>
                        @if (ViewBag.TaiKhoanList != null)
                        {
                            foreach (SelectListItem item in ViewBag.TaiKhoanList)
                            {
                                <option value="@item.Value" @(item.Value == (ViewBag.IDTaiKhoanThanhToan != null ? ViewBag.IDTaiKhoanThanhToan.ToString() : "") ? "selected" : "")>@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-sm text-white px-3 d-flex align-items-center gap-1" style="background-color:#2998e4;border:none;height:31px;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <a class="btn btn-sm text-white btn-reset" style="background:#f1c40f;height:31px;line-height:1.5;display:inline-flex;align-items:center;">
                        Làm mới
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Grid dữ liệu -->
<div id="table-container">
    @Html.Partial("_PhieuChiList", Model)
</div>

@section Scripts {
    <script>
        (function () {
            var $pane = $('.tab-pane.active');
            if ($pane.length === 0) $pane = $(document);

            $pane.off('click.phieuchi_export', '.btn-export-excel');
            $pane.on('click.phieuchi_export', '.btn-export-excel', function () {
                var params = $pane.find('#searchForm').serialize();
                window.location.href = '@Url.Action("ExportExcel","PhieuChi")?' + params;
            });

            var $form = $pane.find('#searchForm');
            
            $pane.off('click.phieuchi_reset', '.btn-reset');
            $pane.on('click.phieuchi_reset', '.btn-reset', function() {
                $form[0].reset();
                $form.find('select').not('.ddl-thoi-gian').val('').trigger('change');
                $form.find('.ddl-thoi-gian').val('current_year').trigger('change');
                $form.trigger('submit');
            });

            // Handle row click to expand details
            $pane.off('click.pc-expand', '.pc-row');
            $pane.on('click.pc-expand', '.pc-row', function (e) {
                // Ignore clicks on buttons/links/dropdowns inside the row
                if ($(e.target).closest('button, a, .dropdown').length > 0) return;

                var $row = $(this);
                var id = $row.data('id');
                if (!id) return;

                var $nextRow = $row.next();
                var isAlreadyExpanded = $nextRow.hasClass('pc-detail-row') && $nextRow.data('parent-id') == id;

                // Close any currently open detail rows
                $pane.find('.pc-detail-row').remove();
                $pane.find('.pc-row').removeClass('table-active');
                $pane.find('.toggle-icon').removeClass('bi-caret-down-fill text-primary').addClass('bi-caret-right-fill text-muted');

                if (isAlreadyExpanded) {
                    return;
                }

                $row.addClass('table-active');
                $row.find('.toggle-icon').removeClass('bi-caret-right-fill text-muted').addClass('bi-caret-down-fill text-primary');

                // Add loading row
                var loadingHtml = `
                    <tr class="pc-detail-row" data-parent-id="${id}">
                        <td colspan="16" class="p-0 border-0">
                            <div class="text-center p-3 text-muted">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Đang tải chi tiết...
                            </div>
                        </td>
                    </tr>
                `;
                $row.after(loadingHtml);

                var url = '@Url.Action("GetDetailInline", "PhieuChi")/' + id;
                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (res) {
                        var html = `
                            <tr class="pc-detail-row" data-parent-id="${id}">
                                <td colspan="16" class="p-0 border-0 shadow-inner">
                                    <div class="detail-container p-2" style="background-color: #f8f9fa;">
                                        ${res}
                                    </div>
                                </td>
                            </tr>
                        `;
                        $row.next('.pc-detail-row').replaceWith(html);
                    },
                    error: function () {
                        $row.next('.pc-detail-row').find('td').html('<div class="text-center p-3 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Lỗi khi tải chi tiết.</div>');
                    }
                });
            });
        })();
    </script>
}
