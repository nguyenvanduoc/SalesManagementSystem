@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.PhieuChiListViewModel>

@{
    var dashboard = ViewBag.Dashboard as SalesManagementSystem.Models.ViewModels.PhieuChiDashboardViewModel;
}
@if (dashboard != null)
{
    <div id="dashboard-data-bridge" style="display:none;"
         data-tong-chi="@dashboard.TongChiText"
         data-tong-chi-trend="@dashboard.TongChiTrend"
         data-tong-chi-trend-class="@dashboard.TongChiTrendClass"
         data-quy-tien-mat="@dashboard.QuyTienMatText"
         data-du-ngan-hang="@dashboard.DuNganHangText"
         data-ngan-hang-count="@dashboard.DuNganHangCount.ToString("D2")"
         data-cong-no-ncc="@dashboard.CongNoNccText"
         data-cong-no-ncc-label="@dashboard.CongNoNccLabel"></div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height:350px;">
            <table id="tblPhieuChiList" class="table table-custom table-bordered table-hover mb-0" style="width:100%; min-width:1350px;">
                <thead>
                    <tr>
                        <th width="40"></th>
                        <th width="80" class="text-center fw-bold">Thao tác</th>
                        <th width="40"  class="text-center fw-bold">STT</th>
                        <th width="130" class="text-center fw-bold">Số phiếu chi</th>
                        <th width="100" class="text-center fw-bold">Ngày chi</th>
                        <th class="fw-bold">Khoản mục chi</th>
                        <th class="fw-bold">Tài khoản TT</th>
                        <th class="fw-bold">Nhà cung cấp</th>
                        <th class="fw-bold">Người nhận</th>
                        <th width="130" class="text-end fw-bold">Số tiền chi</th>
                        <th width="130" class="text-end fw-bold text-success">Số tiền phân bổ</th>
                        <th width="110" class="text-center fw-bold">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        bool canSua     = SalesManagementSystem.Helpers.PermissionHelper.HasPermission("PhieuChi", SalesManagementSystem.Helpers.LoaiPhanQuyen.CapNhat);
                        bool canTuyChon = SalesManagementSystem.Helpers.PermissionHelper.HasPermission("PhieuChi", SalesManagementSystem.Helpers.LoaiPhanQuyen.TuyChon);
                        bool canXoa     = SalesManagementSystem.Helpers.PermissionHelper.HasPermission("PhieuChi", SalesManagementSystem.Helpers.LoaiPhanQuyen.Xoa);

                        foreach (var item in Model.Items)
                        {
                            <tr class="align-middle pc-row" data-id="@item.ID" style="cursor: pointer;">
                                <td class="text-center align-middle">
                                    <i class="bi bi-caret-right-fill text-muted toggle-icon" style="font-size: 0.95rem;"></i>
                                </td>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 6px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow-sm">
                                            <li>
                                                <button type="button" class="dropdown-item py-2"
                                                        onclick="openFormModal('@Url.Action("Details","PhieuChi",new{id=item.ID})')">
                                                    <i class="bi bi-eye text-info me-2"></i>Xem chi tiết
                                                </button>
                                            </li>
                                            @if (item.TrangThai == 1 && (canSua || canTuyChon || canXoa))
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                            }
                                            else if (item.TrangThai == 2 && canTuyChon)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                            }
                                            else if (item.TrangThai == 3)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                            }
                                            @if (item.TrangThai == 1)
                                            {
                                                if (canSua)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2"
                                                                onclick="openFormModal('@Url.Action("Edit","PhieuChi",new{id=item.ID})')">
                                                            <i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật
                                                        </button>
                                                    </li>
                                                }
                                                if (canTuyChon)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 text-success btn-ghiso"
                                                                data-id="@item.ID" data-so="@item.SoPhieuChi">
                                                            <i class="bi bi-journal-check text-success me-2"></i>ghi
                                                        </button>
                                                    </li>
                                                }
                                                if (canXoa)
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 text-danger"
                                                                onclick="confirmDelete('@Url.Action("Delete","PhieuChi",new{id=item.ID})', 'Bạn có chắc chắn muốn xóa phiếu @item.SoPhieuChi?')">
                                                            <i class="bi bi-trash-fill text-danger me-2"></i>Xóa
                                                        </button>
                                                    </li>
                                                }
                                            }
                                            else if (item.TrangThai == 2)
                                            {
                                                if (canSua)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 text-primary"
                                                                onclick="openFormModal('@Url.Action("AdjustAllocation", "PhieuChi", new { id = item.ID })')">
                                                                <i class="bi bi-sliders text-primary me-2"></i>Cập nhật
                                                        </button>
                                                    </li>
                                                }
                                                if (canTuyChon)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 text-warning btn-huy"
                                                                data-id="@item.ID" data-so="@item.SoPhieuChi">
                                                                <i class="bi bi-x-circle text-warning me-2"></i>Hủy
                                                        </button>
                                                    </li>
                                                }
                                            }
                                            else
                                            {
                                                <li><span class="dropdown-item text-muted disabled">Phiếu đã hủy</span></li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@(stt++)</td>
                                <td class="text-center align-middle fw-semibold text-primary">@item.SoPhieuChi</td>
                                <td class="text-center align-middle">@item.NgayChi.ToString("dd/MM/yyyy")</td>
                                <td class="align-middle">@item.TenKhoanMuc</td>
                                <td class="align-middle">@item.TenTaiKhoanThanhToan</td>
                                <td class="align-middle">@item.TenNhaCungCap</td>
                                <td class="align-middle">
                                    @if (!string.IsNullOrEmpty(item.NguoiNhanTien))
                                    {
                                        @item.NguoiNhanTien
                                        if (!string.IsNullOrEmpty(item.SoDienThoaiNguoiNhan))
                                        {
                                            <br/><small class="text-muted">(@item.SoDienThoaiNguoiNhan)</small>
                                        }
                                    }
                                    else
                                    {
                                        @item.TenNguoiNhan
                                    }
                                </td>
                                <td class="text-end align-middle fw-semibold">@item.SoTienChi.ToString("N0")</td>
                                <td class="text-end align-middle fw-semibold text-success">@item.SoTienPhanBo.ToString("N0")</td>
                                <td class="text-center align-middle">
                                    <span class="@item.CssTrangThai">@item.TenTrangThai</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không có dữ liệu
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    <tfoot>
                        <tr class="fw-bold bg-light">
                            <td colspan="9" class="text-end">Tổng cộng</td>
                            <td class="text-end">@Model.Items.Sum(x => x.SoTienChi).ToString("N0")</td>
                            <td class="text-end text-success">@Model.Items.Sum(x => x.SoTienPhanBo).ToString("N0")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
    @Html.Partial("_Pagination", Model)
</div>

<!-- Modal Hủy Phiếu Chi -->
<div class="modal fade" id="modalHuyPhieuChi" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content shadow-lg" style="border: none; border-radius: 6px;">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-uppercase" style="color:#0b5b84;">HỦY PHIẾU CHI</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="huy-id" />
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Lý do hủy <span class="text-danger">*</span></label>
                    <textarea id="huy-lydo" class="form-control" rows="3" placeholder="Nhập lý do hủy phiếu..." required></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light d-flex justify-content-end gap-2">
                <button type="button" id="btnConfirmHuy" class="btn" style="background-color: #ffc107; color: #fff; font-weight: bold; border-radius: 4px; padding: 8px 16px; font-size: 0.9rem;">ĐỒNG Ý</button>
                <button type="button" class="btn" data-bs-dismiss="modal" style="background-color: #e9ecef; color: #333; font-weight: bold; border-radius: 4px; padding: 8px 16px; font-size: 0.9rem; border: none;">ĐỂ SAU</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var $pane = $('#phieuchi-table-container').closest('.tab-pane');
    if ($pane.length === 0) $pane = $('body');

    // Cập nhật Dashboard nếu có dữ liệu cầu nối
    var $bridge = $('#dashboard-data-bridge');
    if ($bridge.length) {
        var tongChi = $bridge.attr('data-tong-chi');
        var trend = $bridge.attr('data-tong-chi-trend');
        var trendClass = $bridge.attr('data-tong-chi-trend-class');
        var quyTienMat = $bridge.attr('data-quy-tien-mat');
        var duNganHang = $bridge.attr('data-du-ngan-hang');
        var nganHangCount = $bridge.attr('data-ngan-hang-count');
        var congNoNcc = $bridge.attr('data-cong-no-ncc');
        var congNoNccLabel = $bridge.attr('data-cong-no-ncc-label');

        $pane.find('#db-tong-chi').text(tongChi);
        
        var trendHtml = '';
        if (trendClass === 'up') {
            trendHtml = '<span class="trend up text-success"><i class="bi bi-arrow-up-short"></i>' + trend + '</span>';
        } else if (trendClass === 'down') {
            trendHtml = '<span class="trend down text-danger"><i class="bi bi-arrow-down-short"></i>' + trend + '</span>';
        } else {
            trendHtml = '<span class="trend text-muted">' + trend + '</span>';
        }
        $pane.find('#db-tong-chi-trend').html(trendHtml);
        
        $pane.find('#db-quy-tien-mat').text(quyTienMat);
        $pane.find('#db-du-ngan-hang').text(duNganHang);
        $pane.find('#db-ngan-hang-count').text(nganHangCount + ' ngân hàng');
        $pane.find('#db-cong-no-ncc').text(congNoNcc);
        $pane.find('#db-cong-no-ncc-label').text(congNoNccLabel);

        // Cập nhật tiêu đề nhãn "Tổng chi" dựa theo bộ lọc ngày
        var tuNgay = $pane.find('input[name="tuNgay"]').val();
        var denNgay = $pane.find('input[name="denNgay"]').val();
        if (tuNgay || denNgay) {
            $pane.find('#db-label-tong-chi').text('Tổng chi kỳ này');
        } else {
            $pane.find('#db-label-tong-chi').text('Tổng chi tháng này');
        }
    }

    // ghi
    $pane.off('click.phieuchi_ghiso', '.btn-ghiso');
    $pane.on('click.phieuchi_ghiso', '.btn-ghiso', function () {
        var id = $(this).data('id');
        var so = $(this).data('so');
        if (!confirm('Bạn có chắc muốn ghi phiếu ' + so + '?')) return;
        $.post('@Url.Action("GhiSo","PhieuChi")', { id: id }, function (res) {
            if (res.success) {
                showToast('success', res.message);
                TabManager.reloadActiveTabGrid(false);
            } else {
                showToast('error', res.message);
            }
        }).fail(function () { showToast('error', 'Lỗi kết nối máy chủ.'); });
    });

    // Hủy
    $pane.off('click.phieuchi_huy', '.btn-huy');
    $pane.on('click.phieuchi_huy', '.btn-huy', function () {
        var id = $(this).data('id');
        var so = $(this).data('so');
        
        $pane.find('#huy-id').val(id);
        $pane.find('#huy-lydo').val('');
        $pane.find('#modalHuyPhieuChi .modal-title').text('HỦY PHIẾU ' + so);
        
        var myModal = new bootstrap.Modal($pane.find('#modalHuyPhieuChi')[0]);
        myModal.show();
    });

    $pane.off('click', '#btnConfirmHuy');
    $pane.on('click', '#btnConfirmHuy', function () {
        var id = $pane.find('#huy-id').val();
        var lyDo = $pane.find('#huy-lydo').val().trim();
        
        if (!lyDo) {
            showToast('error', 'Vui lòng nhập lý do hủy.');
            $pane.find('#huy-lydo').focus();
            return;
        }
        
        $.post('@Url.Action("Huy","PhieuChi")', { id: id, lyDo: lyDo }, function (res) {
            if (res.success) {
                showToast('success', res.message);
                var modal = bootstrap.Modal.getInstance($pane.find('#modalHuyPhieuChi')[0]);
                if (modal) modal.hide();
                TabManager.reloadActiveTabGrid(false);
            } else {
                showToast('error', res.message);
            }
        }).fail(function () { showToast('error', 'Lỗi kết nối máy chủ.'); });
    });
})();
</script>

<style>
    #tblPhieuChiList th {
        position: relative;
        background-clip: padding-box;
    }
    #tblPhieuChiList th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblPhieuChiList th .resizer:hover, #tblPhieuChiList th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var table = document.getElementById('tblPhieuChiList');
        if (!table) return;
        
        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            // Skip for icon columns, checkbox columns and action columns
            if(th.innerText.trim() === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
            if(th.innerText.trim() === 'Thao tác') return;
            
            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;
            
            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function(e) {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);
                
                e.preventDefault();
            });
        });
    })();
</script>
