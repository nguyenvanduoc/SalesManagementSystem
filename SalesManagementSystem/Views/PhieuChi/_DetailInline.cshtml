@model SalesManagementSystem.Models.ViewModels.PhieuChiViewModel

<div class="p-3 bg-light border rounded m-2">
    @if (Model.ChiTiets != null && Model.ChiTiets.Count > 0)
    {
        <table class="table table-sm table-bordered table-hover bg-white mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 50px;">STT</th>
                    <th class="text-center" style="width: 150px;">Số phiếu nhập</th>
                    <th>Loại chi</th>
                    <th>Diễn giải</th>
                    <th class="text-end" style="width: 150px;">Số tiền phân bổ</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = 1;
                    foreach (var item in Model.ChiTiets)
                    {
                        <tr>
                            <td class="text-center align-middle">@(stt++)</td>
                            <td class="text-center align-middle text-primary fw-semibold">@item.SoPhieuNhap</td>
                            <td class="align-middle">
                                @if (item.LoaiChi == 1)
                                {
                                    <span class="badge bg-success">Thanh toán phiếu nhập</span>
                                }
                                else if (item.LoaiChi == 2)
                                {
                                    <span class="badge bg-info text-dark">Trả tiền trước</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Khác</span>
                                }
                            </td>
                            <td class="align-middle">@item.DienGiai</td>
                            <td class="text-end align-middle fw-bold text-success">@item.SoTienPhanBo.ToString("N0")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning mb-0 py-2">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Phiếu chi này chưa có dữ liệu phân bổ.
        </div>
    }
</div>
