@{
    ViewBag.Title = "Trang chủ";
    var userSession = (SalesManagementSystem.Models.ViewModels.UserLoginViewModel)Session[SalesManagementSystem.Helpers.CommonConstants.USER_SESSION];
    string hoTen = userSession != null ? (userSession.HoDem + " " + userSession.Ten).Trim() : "Người dùng";
}

<div class="d-flex flex-column align-items-center justify-content-center" style="min-height: calc(100vh - 150px);">
    <i class="bi bi-shield-lock text-muted" style="font-size: 5rem; margin-bottom: 20px;"></i>
    <h2 class="fw-bold text-muted">Xin chào: @hoTen</h2>
</div>