@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.CongNoNCCViewModel>

@{
    ViewBag.Title = "Công Nợ Phải Trả NCC";
    decimal tongPhaiTra = ViewBag.TongPhaiTra ?? 0M;
    decimal tongDaTra   = ViewBag.TongDaTra   ?? 0M;
    decimal tongConLai  = ViewBag.TongConLai  ?? 0M;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-uppercase" style="color:#0b5b84;font-size:1.25rem;">
        CÔNG NỢ PHẢI TRẢ NHÀ CUNG CẤP
    </h4>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("GetList","CongNoNCC")" id="searchForm">
            <div class="row g-3 align-items-end">
                
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Thời gian</label>
                    <select class="form-select form-select-sm ddl-thoi-gian">
                                <option value="current_month">Đầu tháng đến hiện tại</option>
                        <option value="month_1">Tháng 1</option>
                        <option value="month_2">Tháng 2</option>
                        <option value="month_3">Tháng 3</option>
                        <option value="month_4">Tháng 4</option>
                        <option value="month_5">Tháng 5</option>
                        <option value="month_6">Tháng 6</option>
                        <option value="month_7">Tháng 7</option>
                        <option value="month_8">Tháng 8</option>
                        <option value="month_9">Tháng 9</option>
                        <option value="month_10">Tháng 10</option>
                        <option value="month_11">Tháng 11</option>
                        <option value="month_12">Tháng 12</option>
                        <option value="quarter_1">Quý 1</option>
                        <option value="quarter_2">Quý 2</option>
                        <option value="quarter_3">Quý 3</option>
                        <option value="quarter_4">Quý 4</option>
                            <option value="current_year">Từ đầu năm đến hiện tại</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1 fw-semibold">Từ ngày nhập</label>
                    <input type="date" class="form-control form-control-sm" name="tuNgay" value="@ViewBag.TuNgay" />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1 fw-semibold">Đến ngày nhập</label>
                    <input type="date" class="form-control form-control-sm" name="denNgay" value="@ViewBag.DenNgay" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small mb-1 fw-semibold">Nhà cung cấp</label>
                    <select class="form-select form-select-sm" name="idNhaCungCap">
                        <option value="">-- Tất cả NCC --</option>
                        @if (ViewBag.NhaCungCapList != null)
                        {
                            foreach (System.Web.Mvc.SelectListItem item in ViewBag.NhaCungCapList)
                            {
                                <option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small mb-1 fw-semibold">Trạng thái công nợ</label>
                    <select class="form-select form-select-sm" name="trangThaiCongNo">
                        <option value="">-- Tất cả --</option>
                        <option value="1" @(ViewBag.TrangThaiCongNo == 1 ? "selected" : "")>Còn nợ</option>
                        <option value="2" @(ViewBag.TrangThaiCongNo == 2 ? "selected" : "")>Đã thanh toán hết</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm text-white px-3" style="background-color:#2998e4;border:none;">
                        <i class="bi bi-search me-1"></i>Tìm kiếm
                    </button>
                    <button type="button" class="btn btn-sm text-white px-3 btn-reset" style="background-color:#f1c40f;border:none;">
                        Làm mới
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Grid dữ liệu & Cards tổng hợp -->

<!-- Grid dữ liệu -->
<div id="table-container">
    @Html.Partial("_CongNoNCCList", Model)
</div>

@section Scripts {
    <script>
        (function () {
            var $script = $('script').last();
            var $pane = $script.closest('.tab-pane');
            if ($pane.length === 0) $pane = $('body');

            function fDate(y, m, d) {
                var sm = m < 10 ? '0' + m : m;
                var sd = d < 10 ? '0' + d : d;
                return y + '-' + sm + '-' + sd;
            }

            function getDays(y, m) {
                var days = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
                if (m === 2 && ((y % 4 === 0 && y % 100 !== 0) || y % 400 === 0)) return 29;
                return days[m];
            }

            // Xử lý đổi Thời gian
            $pane.find('.ddl-thoi-gian').off('change').on('change', function () {
                var val = $(this).val();
                if (!val) return;

                var now = new Date();
                var y = now.getFullYear();
                var s = '', e = '';

                if (val === 'current_year') {
                    s = fDate(y, 1, 1);
                    e = fDate(now.getFullYear(), now.getMonth() + 1, now.getDate());
                } else if (val === 'current_month') {
                    var cm = now.getMonth() + 1;
                    s = fDate(y, cm, 1);
                    e = fDate(now.getFullYear(), now.getMonth() + 1, now.getDate());
                } else if (val.indexOf('month_') === 0) {
                    var m = parseInt(val.replace('month_', ''), 10);
                    s = fDate(y, m, 1);
                    e = fDate(y, m, getDays(y, m));
                } else if (val.indexOf('quarter_') === 0) {
                    var q = parseInt(val.replace('quarter_', ''), 10);
                    var startM = (q - 1) * 3 + 1;
                    var endM = startM + 2;
                    s = fDate(y, startM, 1);
                    e = fDate(y, endM, getDays(y, endM));
                }

                if (s && e) {
                    $pane.find('input[name="tuNgay"]').val(s);
                    $pane.find('input[name="denNgay"]').val(e);
                    $pane.find('#searchForm').trigger('submit');
                }
            });

            // Nút Làm mới
            $pane.find('.btn-reset').off('click').on('click', function (e) {
                e.preventDefault();
                var $form = $pane.find('#searchForm');
                if ($form.length > 0) {
                    $form[0].reset();
                    $form.find('select').val('');
                    $form.trigger('submit');
                }
            });
        })();
    </script>
}
