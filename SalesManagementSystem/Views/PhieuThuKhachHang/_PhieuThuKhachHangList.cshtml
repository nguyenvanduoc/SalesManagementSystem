@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.PhieuThuKhachHangListViewModel>
@using SalesManagementSystem.Helpers
@using System.Globalization

@{
    var cultureVi = new CultureInfo("vi-VN");
    bool canDinhKem = PermissionHelper.HasPermission("PhieuThuKhachHang", LoaiPhanQuyen.CapNhat);
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height: 350px;">
            <table id="tblPhieuThuList" class="table table-custom table-bordered table-hover mb-0" style="width:100%; min-width:1200px;">
                <thead>
                    <tr>
                        <th width="40"></th>
                        <th class="text-center" style="width: 80px;">Thao t&#225;c</th>
                        <th class="text-center" style="width: 60px;">STT</th>
                        <th class="text-center" style="width: 140px;">S&#7889; phi&#7871;u thu</th>
                        <th class="text-center" style="width: 120px;">Ng&#224;y thu</th>
                        <th>Kh&#225;ch h&#224;ng</th>
                        <th class="text-end" style="width: 150px;">T&#7891;n &#273;&#7847;u k&#7923;</th>
                        <th class="text-end" style="width: 150px;">S&#7889; ti&#7873;n thu</th>
                        <th class="text-end" style="width: 150px;">S&#7889; ti&#7873;n ph&#226;n b&#7893;</th>
                        <th class="text-end" style="width: 150px;">Ti&#7873;n tr&#7843; tr&#432;&#7899;c</th>
                        <th class="text-end" style="width: 150px;">L&#361;y k&#7871;</th>
                        <th class="text-center" style="width: 95px;">&#272;&#237;nh k&#232;m</th>
                        <th class="text-center" style="width: 130px;">Tr&#7841;ng th&#225;i</th>
                        <th>Ng&#432;&#7901;i t&#7841;o</th>
                        <th class="text-center" style="width: 160px;">Ng&#224;y t&#7841;o</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int rowNum = 1;
                        foreach (var item in Model.Items)
                        {
                            int stt = ((Model.CurrentPage - 1) * Model.PageSize) + rowNum;
                            rowNum++;
                            
                            <tr class="pt-row" data-id="@item.ID">
                                <td class="text-center align-middle">
                                    <i class="bi bi-caret-right-fill text-muted toggle-icon" style="cursor: pointer; font-size: 0.9rem;"></i>
                                </td>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 3px 7px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            <li>
                                                <button type="button" class="dropdown-item py-2" onclick="openFormModal('@Url.Action("Details", "PhieuThuKhachHang", new { id = item.ID })')">
                                                    <i class="bi bi-eye text-info me-2"></i>Xem chi ti&#7871;t
                                                </button>
                                            </li>
                                            @if (item.TrangThai == 1)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item py-2" onclick="openFormModal('@Url.Action("Edit", "PhieuThuKhachHang", new { id = item.ID })')">
                                                        <i class="bi bi-pencil-square text-primary me-2"></i>C&#7853;p nh&#7853;t
                                                    </button>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <button type="button" class="dropdown-item py-2 text-danger" onclick="confirmDelete('@Url.Action("Delete", "PhieuThuKhachHang", new { id = item.ID })', 'B&#7841;n c&#243; ch&#7855;c ch&#7855;n mu&#7889;n x&#243;a phi&#7871;u @item.SoPhieuThu?')">
                                                        <i class="bi bi-trash-fill text-danger me-2"></i>X&#243;a
                                                    </button>
                                                </li>
                                            }
                                            else if (item.TrangThai == 2)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item py-2 text-primary" onclick="openFormModal('@Url.Action("AdjustAllocation", "PhieuThuKhachHang", new { id = item.ID })')">
                                                        <i class="bi bi-sliders text-primary me-2"></i>C&#7853;p nh&#7853;t ph&#226;n b&#7893;
                                                    </button>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item py-2 text-secondary btn-view-pt-files"
                                                        data-id="@item.ID" data-so="@item.SoPhieuThu">
                                                    <i class="bi bi-paperclip text-secondary me-2"></i>Xem file &#273;&#237;nh k&#232;m
                                                </button>
                                            </li>
                                            @if (canDinhKem)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item py-2 text-primary btn-upload-pt-file"
                                                            data-id="@item.ID" data-so="@item.SoPhieuThu">
                                                        <i class="bi bi-upload text-primary me-2"></i>&#272;&#237;nh k&#232;m file
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@stt</td>
                                <td class="align-middle text-center">
                                    <button type="button" class="btn btn-link fw-bold text-decoration-none p-0" style="color: #2998e4;" onclick="openFormModal('@Url.Action("Edit", "PhieuThuKhachHang", new { id = item.ID })')">
                                        @item.SoPhieuThu
                                    </button>
                                </td>
                                <td class="align-middle text-center">@item.NgayThu.ToString("dd/MM/yyyy")</td>
                                <td class="align-middle">@item.TenKhachHang</td>
                                <td class="align-middle text-end text-secondary fw-semibold">@item.TonDauKy.ToString("N0", cultureVi)</td>
                                <td class="align-middle text-end text-dark fw-semibold">@item.SoTienThu.ToString("N0", cultureVi)</td>
                                <td class="align-middle text-end text-success">@item.SoTienPhanBo.ToString("N0", cultureVi)</td>
                                <td class="align-middle text-end text-primary">@item.TienTraTruoc.ToString("N0", cultureVi)</td>
                                <td class="align-middle text-end fw-semibold text-danger">@item.LuyKe.ToString("N0", cultureVi)</td>
                                <td class="text-center align-middle">
                                    <input type="checkbox"
                                           class="form-check-input pt-has-file-checkbox"
                                           data-id="@item.ID"
                                           @(item.HasDinhKem ? "checked=\"checked\"" : "")
                                           disabled />
                                </td>
                                <td class="text-center align-middle">
                                    <span class="@item.CssTrangThai px-2.5 py-1.5" style="font-size: 0.75rem; font-weight: 600; border-radius: 4px; display: inline-block; min-width: 100px;">
                                        @item.TenTrangThai
                                    </span>
                                </td>
                                <td class="align-middle">@item.NguoiTao</td>
                                <td class="align-middle text-center">@(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="14" class="text-center py-4 text-muted">Ch&#432;a c&#243; phi&#7871;u thu n&#224;o ph&#249; h&#7907;p.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @Html.Partial("_Pagination", Model)
</div>

<div class="modal fade" id="modalPhieuThuFiles" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-uppercase" style="color:#0b5b84;">FILE &#272;&#205;NH K&#200;M</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalPhieuThuFilesContent" style="min-height:200px;">
                <div class="text-center py-5 text-muted">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    &#272;ang t&#7843;i danh s&#225;ch file...
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn text-dark fw-bold" style="background:#e9ecef;border:none;" data-bs-dismiss="modal">&#272;&#211;NG</button>
            </div>
        </div>
    </div>
</div>

<input type="file" id="ptFileInput" multiple style="display:none;" />

<style>
    #tblPhieuThuList th {
        position: relative;
        background-clip: padding-box;
    }
    #tblPhieuThuList th .resizer {
        position: absolute;
        top: 0;
        right: -3px;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        background-color: transparent;
    }
    #tblPhieuThuList th .resizer:hover, #tblPhieuThuList th .resizer.resizing {
        background-color: rgba(11, 91, 132, 0.5);
    }
</style>
<script>
    (function() {
        var $pane = $('#tblPhieuThuList').closest('.tab-pane');
        if ($pane.length === 0) $pane = $('body');
        var currentUploadPhieuThuId = 0;
        var currentUploadPhieuThuSo = '';
        // Intercept pagination clicks specifically for PhieuThu to prevent global conflicts
        $pane.off('click.phieuthu_pag', '.pagination .ajax-link');
        $pane.on('click.phieuthu_pag', '.pagination .ajax-link', function(e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            
            var $li = $(this).closest('li');
            if ($li.hasClass('disabled') || $li.hasClass('active')) return;
            
            var href = $(this).attr('href');
            if (!href || href === '#' || href.indexOf('javascript:') === 0) return;

            var page = 1;
            var matchPage = href.match(/[?&]page=(\\d+)/);
            if (matchPage) page = parseInt(matchPage[1], 10);
            
            var pageSize = $pane.find('.page-size-select').val() || 20;

            var $form = $pane.find('#searchFormPhieuThu');
            var url;
            if ($form.length > 0) {
                var action = $form.attr('action') || href.split('?')[0];
                var params = $form.serializeArray();
                params = params.filter(function (item) {
                    return item.name !== 'page' && item.name !== 'pageSize';
                });
                params.push({ name: 'page', value: page });
                params.push({ name: 'pageSize', value: pageSize });
                url = action + '?' + $.param(params);
            } else {
                url = href;
            }

            var $grid = $pane.find('#table-container');
            if (typeof showLoadingLocal === 'function') showLoadingLocal($grid);
            
            $.ajax({
                url: url,
                type: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (res) {
                    if (typeof hideLoadingLocal === 'function') hideLoadingLocal($grid);
                    $grid.html(res);
                    if (typeof reInitPlugins === 'function') reInitPlugins($pane.attr('id'));
                },
                error: function() {
                    if (typeof hideLoadingLocal === 'function') hideLoadingLocal($grid);
                    if (typeof showToast === 'function') showToast('error', 'L?i khi t?i d? li?u.');
                }
            });
        });

        // Intercept pageSize select changes specifically for PhieuThu
        $pane.off('change.phieuthu_ps', '.page-size-select');
        $pane.on('change.phieuthu_ps', '.page-size-select', function(e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            
            var pageSize = $(this).val();
            var $paginationBlock = $(this).closest('.custom-pagination');
            var baseUrl = $paginationBlock.attr('data-action') || '@Url.Action("GetList", "PhieuThuKhachHang")';
            
            var $form = $pane.find('#searchFormPhieuThu');
            var url;
            if ($form.length > 0) {
                var action = $form.attr('action') || baseUrl;
                var params = $form.serializeArray();
                params = params.filter(function (item) {
                    return item.name !== 'page' && item.name !== 'pageSize';
                });
                params.push({ name: 'page', value: 1 });
                params.push({ name: 'pageSize', value: pageSize });
                url = action + '?' + $.param(params);
            } else {
                url = baseUrl + '?page=1&pageSize=' + pageSize;
            }

            var $grid = $pane.find('#table-container');
            if (typeof showLoadingLocal === 'function') showLoadingLocal($grid);
            
            $.ajax({
                url: url,
                type: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (res) {
                    if (typeof hideLoadingLocal === 'function') hideLoadingLocal($grid);
                    $grid.html(res);
                    if (typeof reInitPlugins === 'function') reInitPlugins($pane.attr('id'));
                },
                error: function() {
                    if (typeof hideLoadingLocal === 'function') hideLoadingLocal($grid);
                    if (typeof showToast === 'function') showToast('error', 'L?i khi t?i d? li?u.');
                }
            });
        });


        function normalizePhieuThuFileLabels($scope) {
            var labelView = 'Xem file \u0111\u00ednh k\u00e8m';
            var labelUpload = '\u0110\u00ednh k\u00e8m file';
            var labelDownload = 'T\u1ea3i xu\u1ed1ng';
            var labelDelete = 'X\u00f3a file';
            var labelEmpty = 'Ch\u01b0a c\u00f3 file \u0111\u00ednh k\u00e8m n\u00e0o.';

            $scope.find('.btn-view-pt-files').each(function () {
                $(this).html('<i class="bi bi-paperclip text-secondary me-2"></i>' + labelView);
            });
            $scope.find('.btn-upload-pt-file').each(function () {
                $(this).html('<i class="bi bi-upload text-primary me-2"></i>' + labelUpload);
            });
            $scope.find('.phieuthu-file-list th').eq(0).text('Thao t\u00e1c');
            $scope.find('.phieuthu-file-list th').eq(2).text('T\u00ean file');
            $scope.find('.phieuthu-file-list th').eq(3).text('Ng\u01b0\u1eddi t\u1ea3i l\u00ean');
            $scope.find('.phieuthu-file-list th').eq(4).text('Ng\u00e0y t\u1ea3i');
            $scope.find('.phieuthu-file-list .dropdown-header').text('Thao t\u00e1c');
            $scope.find('.phieuthu-file-list a[href*="DownloadFile"]').each(function () {
                $(this).html('<i class="bi bi-download me-2 text-success"></i> ' + labelDownload);
            });
            $scope.find('.phieuthu-file-list .btn-delete-pt-file').each(function () {
                $(this).html('<i class="bi bi-trash-fill me-2 text-danger"></i> ' + labelDelete);
            });
            $scope.find('.phieuthu-file-list td[colspan="5"]').text(labelEmpty);
        }

        normalizePhieuThuFileLabels($pane);

        function loadPhieuThuFiles(idPhieuThu, soPhieuThu) {
            var $modal = $pane.find('#modalPhieuThuFiles');
            var $content = $pane.find('#modalPhieuThuFilesContent');
            var safeSoPhieuThu = $('<div>').text(soPhieuThu || '').html();
            $modal.find('.modal-title').html('FILE &#272;&#205;NH K&#200;M ' + safeSoPhieuThu);
            $content.html('<div class="text-center py-5 text-muted"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>&#272;ang t&#7843;i danh s&#225;ch file...</div>');
            bootstrap.Modal.getOrCreateInstance($modal[0]).show();

            $.get('@Url.Action("GetFiles", "PhieuThuKhachHang")', { idPhieuThu: idPhieuThu }, function (res) {
                $content.html(res);
                $content.find('.phieuthu-file-list').removeClass('mt-3').addClass('mt-0');
                normalizePhieuThuFileLabels($content);
                setPhieuThuFileCheckbox(idPhieuThu, hasPhieuThuFiles($content));
            }).fail(function () {
                $content.html('<div class="text-center text-danger py-4">L&#7895;i t&#7843;i danh s&#225;ch file &#273;&#237;nh k&#232;m.</div>');
                if (typeof showToast === 'function') showToast('error', 'L&#7895;i t&#7843;i danh s&#225;ch file &#273;&#237;nh k&#232;m.');
            });
        }

        function reloadCurrentPhieuThuFiles() {
            if (!currentUploadPhieuThuId) return;
            $.get('@Url.Action("GetFiles", "PhieuThuKhachHang")', { idPhieuThu: currentUploadPhieuThuId }, function (res) {
                var $content = $pane.find('#modalPhieuThuFilesContent');
                $content.html(res);
                $content.find('.phieuthu-file-list').removeClass('mt-3').addClass('mt-0');
                normalizePhieuThuFileLabels($content);
                setPhieuThuFileCheckbox(currentUploadPhieuThuId, hasPhieuThuFiles($content));
            });
        }

        function setPhieuThuFileCheckbox(idChungTuBanHang, checked) {
            $pane.find('.pt-has-file-checkbox[data-id="' + idChungTuBanHang + '"]').prop('checked', checked);
        }

        function hasPhieuThuFiles($scope) {
            return $scope.find('.phieuthu-file-list tbody tr').filter(function () {
                return $(this).find('td[colspan]').length === 0;
            }).length > 0;
        }

        $pane.off('click.phieuthu_view_files', '.btn-view-pt-files');
        $pane.on('click.phieuthu_view_files', '.btn-view-pt-files', function () {
            currentUploadPhieuThuId = $(this).data('id');
            currentUploadPhieuThuSo = $(this).data('so');
            loadPhieuThuFiles(currentUploadPhieuThuId, currentUploadPhieuThuSo);
        });

        $pane.off('click.phieuthu_upload_file', '.btn-upload-pt-file');
        $pane.on('click.phieuthu_upload_file', '.btn-upload-pt-file', function () {
            currentUploadPhieuThuId = $(this).data('id');
            currentUploadPhieuThuSo = $(this).data('so');
            $pane.find('#ptFileInput').val('').trigger('click');
        });

        $pane.off('change.phieuthu_file_input', '#ptFileInput');
        $pane.on('change.phieuthu_file_input', '#ptFileInput', function () {
            if (!this.files || this.files.length === 0 || !currentUploadPhieuThuId) return;

            var files = this.files;
            var uploaded = 0;
            var hasError = false;
            if (typeof showToast === 'function') showToast('info', 'Dang tai len ' + files.length + ' file...');

            for (var i = 0; i < files.length; i++) {
                var formData = new FormData();
                formData.append('idPhieuThu', currentUploadPhieuThuId);
                formData.append('file', files[i]);

                $.ajax({
                    url: '@Url.Action("UploadFile", "PhieuThuKhachHang")',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (res) {
                        uploaded++;
                        if (!res.success) hasError = true;
                        if (uploaded === files.length) {
                            if (typeof showToast === 'function') {
                                showToast(hasError ? 'warning' : 'success', hasError ? 'Mot so file khong the tai len.' : 'Tai file len thanh cong.');
                            }
                            if (!hasError) setPhieuThuFileCheckbox(currentUploadPhieuThuId, true);
                            loadPhieuThuFiles(currentUploadPhieuThuId, currentUploadPhieuThuSo);
                        }
                    },
                    error: function () {
                        uploaded++;
                        hasError = true;
                        if (uploaded === files.length) {
                            if (typeof showToast === 'function') showToast('warning', 'Mot so file khong the tai len.');
                            loadPhieuThuFiles(currentUploadPhieuThuId, currentUploadPhieuThuSo);
                        }
                    }
                });
            }
        });

        $pane.off('click.phieuthu_delete_file', '.btn-delete-pt-file');
        $pane.on('click.phieuthu_delete_file', '.btn-delete-pt-file', function () {
            var id = $(this).data('id');
            showConfirm('Ban co chac chan muon xoa file dinh kem nay?', function () {
                $.post('@Url.Action("DeleteFile", "PhieuThuKhachHang")', { id: id }, function (res) {
                    if (res.success) {
                        if (typeof showToast === 'function') showToast('success', res.message);
                        reloadCurrentPhieuThuFiles();
                    } else {
                        if (typeof showToast === 'function') showToast('error', res.message);
                    }
                }).fail(function () {
                    if (typeof showToast === 'function') showToast('error', 'Loi ket noi may chu.');
                });
            });
        });

        var table = document.getElementById('tblPhieuThuList');
        if (!table) return;

        var ths = table.querySelectorAll('th');
        ths.forEach(function(th) {
            var thText = th.innerText.trim();
            if(thText === '' && (th.style.width === '35px' || th.style.width === '40px' || th.style.width === '50px')) return;
            if(thText === 'Thao t\u00e1c' || thText === 'Thao t\u00e1c') return;

            if(th.querySelector('.resizer')) return;

            var resizer = document.createElement('div');
            resizer.classList.add('resizer');
            th.appendChild(resizer);

            var startX, startWidth;

            resizer.addEventListener('mousedown', function(e) {
                startX = e.pageX;
                startWidth = th.offsetWidth;
                resizer.classList.add('resizing');

                var doDrag = function(e) {
                    var newWidth = startWidth + (e.pageX - startX);
                    if(newWidth > 30) {
                        th.style.width = newWidth + 'px';
                        th.style.minWidth = newWidth + 'px';
                        th.style.maxWidth = newWidth + 'px';
                    }
                };

                var stopDrag = function() {
                    resizer.classList.remove('resizing');
                    document.removeEventListener('mousemove', doDrag);
                    document.removeEventListener('mouseup', stopDrag);
                };

                document.addEventListener('mousemove', doDrag);
                document.addEventListener('mouseup', stopDrag);

                e.preventDefault();
            });
        });
    })();
</script>
