@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.PhieuThuKhachHangListViewModel>

@{
    ViewBag.Title = "Phiếu thu khách hàng";
}

@using SalesManagementSystem.Helpers
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">@ViewBag.Title</h4>
    @if (PermissionHelper.HasPermission("PhieuThuKhachHang", LoaiPhanQuyen.Them))
    {
        <button class="btn btn-sm btn-primary fw-bold px-3 shadow-sm" onclick="openFormModal('@Url.Action("Create")')">
            <i class="bi bi-plus-circle me-1"></i> Tạo phiếu thu
        </button>
    }
</div>

<!-- Bộ lọc tìm kiếm theo chuẩn UI compact trên 1 dòng -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-2">
        <form method="get" action="@Url.Action("GetList")" id="searchForm">
            <div class="row g-2 align-items-end">
                
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Thời gian</label>
                    <select class="form-select form-select-sm ddl-thoi-gian no-select2">
                                <option value="current_month">Đầu tháng đến hiện tại</option>
                        <option value="month_1">Tháng 1</option>
                        <option value="month_2">Tháng 2</option>
                        <option value="month_3">Tháng 3</option>
                        <option value="month_4">Tháng 4</option>
                        <option value="month_5">Tháng 5</option>
                        <option value="month_6">Tháng 6</option>
                        <option value="month_7">Tháng 7</option>
                        <option value="month_8">Tháng 8</option>
                        <option value="month_9">Tháng 9</option>
                        <option value="month_10">Tháng 10</option>
                        <option value="month_11">Tháng 11</option>
                        <option value="month_12">Tháng 12</option>
                        <option value="quarter_1">Quý 1</option>
                        <option value="quarter_2">Quý 2</option>
                        <option value="quarter_3">Quý 3</option>
                        <option value="quarter_4">Quý 4</option>
                            <option value="current_year">Từ đầu năm đến hiện tại</option>
                    </select>
                </div>
                
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Từ ngày</label>
                    <input type="date" name="tuNgay" class="form-control form-control-sm" value="@ViewBag.TuNgay">
                </div>
                
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Đến ngày</label>
                    <input type="date" name="denNgay" class="form-control form-control-sm" value="@ViewBag.DenNgay">
                </div>
                
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Số chứng từ</label>
                    <input type="text" name="soPhieuThu" class="form-control form-control-sm" placeholder="Mã chứng từ..." value="@ViewBag.SoPhieuThu">
                </div>
                
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Khách hàng</label>
                    <select name="idKhachHang" id="idKhachHang_PhieuThu" class="form-select form-select-sm select2">
                        <option value="">Tất cả khách hàng</option>
                        @if (ViewBag.KhachHangList != null)
                        {
                            foreach (var item in (SelectList)ViewBag.KhachHangList)
                            {
                                <option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Text</option>
                            }
                        }
                    </select>
                </div>
                
                <div class="col-md-2 d-flex gap-2" style="padding-bottom: 2px;">
                    <button type="submit" class="btn btn-sm text-white px-3 w-100 shadow-sm" style="background-color: #2998e4; border: none; height: 31px;">
                        <i class="bi bi-search me-1"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn btn-sm text-white px-3 btn-reset w-100 shadow-sm" style="background-color: #f1c40f; border: none; height: 31px;">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                    </button>
                </div>
                
            </div>
        </form>
    </div>
</div>

<div id="table-container">
    @Html.Partial("_PhieuThuKhachHangList", Model)
</div>

@section Scripts {
    <style>
        .select2-container .select2-selection--single {
            height: 31px !important;
            padding-top: 1px !important;
            border: 1px solid #ced4da !important;
            border-radius: 4px !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            font-size: 0.875rem !important;
            line-height: 29px !important;
            color: #495057 !important;
            padding-left: 8px !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 29px !important;
        }
    </style>
    <script>
        (function() {
            var $script = $('script').last();
            var $pane = $script.closest('.tab-pane');
            if ($pane.length === 0) $pane = $('body');

            // Initialize select2 simply
            $pane.find('.select2').select2({
                width: '100%',
                dropdownParent: $pane
            });
        
            $pane.off('click.phieuthu_reset', '.btn-reset');
            $pane.on('click.phieuthu_reset', '.btn-reset', function(e) {
                e.preventDefault();
                e.stopImmediatePropagation();
                
                var $form = $pane.find('#searchForm');
                if ($form.length > 0) {
                    $form[0].reset();
                    
                    // Xóa trắng các input text (bao gồm cả flatpickr)
                    $form.find('input[type="text"]').val('');
                    
                    // Reset Khách hàng (bỏ qua ddl-thoi-gian)
                    $form.find('.select2-hidden-accessible').not('.ddl-thoi-gian').val('').trigger('change');
                    
                    // Set thời gian về current_year và trigger change cho cả native select và select2
                    $form.find('.ddl-thoi-gian').val('current_year').trigger('change').trigger('change.select2');
                    
                    $form.trigger('submit');
                }
            });

            // Local reload grid function
            window.loadData = function() {
                $pane.find('#searchForm').submit();
            };

            // Handle row click to expand details - delegate to document to survive AJAX grid reloads
            $(document).off('click.pt-expand', '.pt-row');
            $(document).on('click.pt-expand', '.pt-row', function (e) {
                if ($(e.target).closest('button, a, .dropdown').length > 0) return;
                var $row = $(this);
                var id = $row.data('id');
                if (!id) return;
                var $nextRow = $row.next();
                var isAlreadyExpanded = $nextRow.hasClass('pt-detail-row') && $nextRow.data('parent-id') == id;
                $('.pt-detail-row').remove();
                $('.pt-row').removeClass('table-active');
                $('.pt-row .toggle-icon').removeClass('bi-caret-down-fill text-primary').addClass('bi-caret-right-fill text-muted');
                if (isAlreadyExpanded) return;
                $row.addClass('table-active');
                $row.find('.toggle-icon').removeClass('bi-caret-right-fill text-muted').addClass('bi-caret-down-fill text-primary');
                var loadingHtml = '<tr class="pt-detail-row" data-parent-id="' + id + '"><td colspan="16" class="p-0 border-0"><div class="text-center p-3 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>&#272;ang t&#7843;i chi ti&#7871;t...</div></td></tr>';
                $row.after(loadingHtml);
                var url = '@Url.Action("GetDetailInline", "PhieuThuKhachHang")/' + id;
                $.ajax({
                    url: url,
                    type: 'GET',
                    global: false,
                    success: function (res) {
                        var html = '<tr class="pt-detail-row" data-parent-id="' + id + '"><td colspan="16" class="p-0 border-0 shadow-inner"><div class="detail-container p-2" style="background-color: #f8f9fa;">' + res + '</div></td></tr>';
                        $row.next('.pt-detail-row').replaceWith(html);
                    },
                    error: function () {
                        $row.next('.pt-detail-row').find('td').html('<div class="text-center p-3 text-danger">L&#7895;i khi t&#7843;i chi ti&#7871;t.</div>');
                    }
                });
            });
        })();
    </script>
}
