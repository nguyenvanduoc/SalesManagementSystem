@model SalesManagementSystem.Models.ViewModels.DmKhoHangCreateEditViewModel

@{
    Layout = null;
    ViewBag.Title = "Cập nhật kho hàng";
}

<div class="modal-header bg-light">
    <h5 class="modal-title fw-bold text-uppercase" style="color: #0b5b84;">@ViewBag.Title</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

@using (Html.BeginForm("Edit", "KhoHang", FormMethod.Post, new { id = "globalForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ID)

    <div class="modal-body p-4">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-3">
                @Html.ValidationSummary(false, "")
            </div>
        }
        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Mã kho hàng <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.MaKhoHang, new { @class = "form-control", placeholder = "Nhập mã kho hàng" })
                @Html.ValidationMessageFor(m => m.MaKhoHang, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Tên kho hàng <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.TenKhoHang, new { @class = "form-control", placeholder = "Nhập tên kho hàng" })
                @Html.ValidationMessageFor(m => m.TenKhoHang, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Địa chỉ</label>
                @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", placeholder = "Nhập địa chỉ" })
                @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Người đại diện</label>
                @Html.TextBoxFor(m => m.NguoiDaiDien, new { @class = "form-control", placeholder = "Nhập người đại diện" })
                @Html.ValidationMessageFor(m => m.NguoiDaiDien, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Thứ tự</label>
                @Html.TextBoxFor(m => m.STT, new { @class = "form-control", type = "number", placeholder = "Thứ tự sắp xếp" })
            </div>
        </div>
    </div>
    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn text-white px-4" style="background-color: #2998e4; border: none;">
            <i class="bi bi-save me-1"></i> Lưu thông tin
        </button>
    </div>
}
