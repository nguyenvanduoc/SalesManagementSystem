@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.DieuChinhNhapKhoListViewModel>
@{
    ViewBag.Title = "Điều chỉnh phiếu nhập kho";
}

<style>
    .select2-container--default .select2-selection--single { height: 31px; border: 1px solid #ced4da; border-radius: 0.25rem; }
    .select2-container--default .select2-selection--single .select2-selection__rendered { font-size: 0.875rem; color: #495057; line-height: 29px; padding-left: 8px; }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 29px; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-uppercase" style="color:#0b5b84;font-size:1.25rem;">
        @ViewBag.Title
    </h4>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form id="searchForm" method="get" action="@Url.Action("Index", "DieuChinhNhapKho")">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1">Thời gian</label>
                    <select class="form-select form-select-sm ddl-thoi-gian no-select2">
                        <option value="current_month">Đầu tháng đến hiện tại</option>
                        <option value="month_1">Tháng 1</option>
                        <option value="month_2">Tháng 2</option>
                        <option value="month_3">Tháng 3</option>
                        <option value="month_4">Tháng 4</option>
                        <option value="month_5">Tháng 5</option>
                        <option value="month_6">Tháng 6</option>
                        <option value="month_7">Tháng 7</option>
                        <option value="month_8">Tháng 8</option>
                        <option value="month_9">Tháng 9</option>
                        <option value="month_10">Tháng 10</option>
                        <option value="month_11">Tháng 11</option>
                        <option value="month_12">Tháng 12</option>
                        <option value="quarter_1">Quý 1</option>
                        <option value="quarter_2">Quý 2</option>
                        <option value="quarter_3">Quý 3</option>
                        <option value="quarter_4">Quý 4</option>
                        <option value="current_year">Từ đầu năm đến hiện tại</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Từ ngày</label>
                    <input type="date" class="form-control form-control-sm" name="tuNgay" value="@ViewBag.TuNgay">
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Đến ngày</label>
                    <input type="date" class="form-control form-control-sm" name="denNgay" value="@ViewBag.DenNgay">
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Số chứng từ</label>
                    <input type="text" class="form-control form-control-sm" name="soChungTu" value="@ViewBag.SoChungTu" placeholder="Số phiếu...">
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Loại nhập kho</label>
                    @Html.DropDownList("idLoaiNhap", (SelectList)ViewBag.LoaiNhaps, "-- Tất cả --", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Kho hàng</label>
                    @Html.DropDownList("idKho", (SelectList)ViewBag.Khos, "-- Tất cả --", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Nhà cung cấp</label>
                    @Html.DropDownList("idNhaCungCap", (SelectList)ViewBag.NhaCungCaps, "-- Tất cả --", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Khách hàng</label>
                    @Html.DropDownList("idKhachHang", (SelectList)ViewBag.KhachHangs, "-- Tất cả --", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-md-2 d-flex align-items-end pb-1">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="chiDonDieuChinh" id="chkChiDonDieuChinh" value="true" @(ViewBag.ChiDonDieuChinh == true ? "checked" : "") />
                        <label class="form-check-label small fw-bold text-muted" for="chkChiDonDieuChinh">Đã điều chỉnh</label>
                    </div>
                </div>
                <div class="col-md-8 d-flex align-items-end pb-1 gap-2 justify-content-end">
                    <button type="submit" class="btn text-white btn-sm px-3 shadow-sm" style="background:#2998e4;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn text-white btn-sm px-3 btn-reset shadow-sm" style="background:#f1c40f;">
                        Làm mới
                    </button>
                    <button type="button" class="btn text-white btn-sm px-3 btn-export shadow-sm" style="background:#2ecc71;">
                        <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="table-container">
    @Html.Partial("_AdjustList", Model)
</div>

<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử điều chỉnh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="historyModalBody">
                <div class="text-center"><div class="spinner-border text-primary" role="status"></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var $pane = $('script').last().closest('.tab-pane');
            if ($pane.length === 0) $pane = $('body');

            $pane.on('click', '.btn-reset', function(e) {
                e.preventDefault();
                var $form = $pane.find('#searchForm');
                $form[0].reset();
                
                var date = new Date();
                var firstDay = new Date(date.getFullYear(), date.getMonth(), 1).toISOString().split('T')[0];
                var lastDay = new Date(date.getFullYear(), date.getMonth() + 1, 0).toISOString().split('T')[0];
                $form.find('input[name="tuNgay"]').val(firstDay);
                $form.find('input[name="denNgay"]').val(lastDay);
                
                $pane.find('select.form-select').val('').trigger('change');
                $pane.find('.ddl-thoi-gian').val('current_month').trigger('change');
                
                $form.trigger('submit');
            });

            $pane.on('click', '.btn-export', function(e) {
                e.preventDefault();
                var data = $pane.find('#searchForm').serialize();
                window.location.href = '/DieuChinhNhapKho/ExportExcel?' + data;
            });

            window.viewHistory = function(id) {
                $('#historyModal').modal('show');
                $('#historyModalBody').html('<div class="text-center"><div class="spinner-border text-primary" role="status"></div></div>');
                $.ajax({
                    url: '/DieuChinhNhapKho/History/' + id,
                    type: 'GET',
                    success: function (res) {
                        $('#historyModalBody').html(res);
                    },
                    error: function () {
                        $('#historyModalBody').html('<div class="alert alert-danger">Có lỗi xảy ra khi tải lịch sử.</div>');
                    }
                });
            };
        })();
    </script>
}
