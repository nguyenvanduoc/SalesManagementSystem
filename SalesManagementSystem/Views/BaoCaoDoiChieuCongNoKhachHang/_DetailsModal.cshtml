@{
    Layout = null;
    int loaiDong = ViewBag.LoaiDong != null ? (int)ViewBag.LoaiDong : 0;
}

<div class="modal fade" id="detailsModalKH" tabindex="-1" aria-labelledby="detailsModalKHLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">

            @* ====== PHIẾU BÁN HÀNG ====== *@
            @if (loaiDong == 1)
            {
                string soChungTu    = ViewBag.BH_SoChungTu ?? "";
                string tenKH        = ViewBag.BH_TenKH ?? "";
                DateTime? ngayCT    = ViewBag.BH_NgayChungTu as DateTime?;
                decimal tongTienHang= ViewBag.BH_TongTienHang != null ? (decimal)ViewBag.BH_TongTienHang : 0m;
                decimal tongCong    = ViewBag.BH_TongCong != null ? (decimal)ViewBag.BH_TongCong : 0m;
                decimal daThanhToan = ViewBag.BH_DaThanhToan != null ? (decimal)ViewBag.BH_DaThanhToan : 0m;
                decimal conLai      = ViewBag.BH_ConLai != null ? (decimal)ViewBag.BH_ConLai : 0m;
                string nguoiTao     = ViewBag.BH_NguoiTao ?? "";

                <div class="modal-header" style="background: linear-gradient(135deg, #0b5b84, #1a8cc1); color: white; border-bottom: none; padding: 18px 24px;">
                    <div>
                        <h5 class="modal-title fw-bold mb-1" id="detailsModalKHLabel">
                            <i class="bi bi-cart-check me-2"></i>Chi tiết Phiếu Bán Hàng
                        </h5>
                        <div style="font-size: 0.85rem; opacity: 0.9;">
                            <span class="badge bg-light text-primary me-2 px-3 py-1" style="font-size:0.85rem;">@soChungTu</span>
                            @if (ngayCT.HasValue)
                            {
                                <span class="me-3"><i class="bi bi-calendar3 me-1"></i>@ngayCT.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (!string.IsNullOrEmpty(nguoiTao))
                            {
                                <span><i class="bi bi-person me-1"></i>Người lập: @nguoiTao</span>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-0">
                    <!-- Info header -->
                    <div class="px-4 py-3" style="background: #f0f7ff; border-bottom: 1px solid #dbe9f5;">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;background:#e8f4fd;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-person-circle text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted" style="font-size:0.75rem;">Khách hàng</div>
                                        <div class="fw-semibold" style="font-size:0.95rem;">@tenKH</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;background:#e8f4fd;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-calendar-event text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted" style="font-size:0.75rem;">Ngày lập phiếu</div>
                                        <div class="fw-semibold" style="font-size:0.95rem;">
                                            @(ngayCT.HasValue ? ngayCT.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chi tiết sản phẩm -->
                    <div class="px-4 pt-3 pb-1">
                        <div class="fw-semibold text-primary mb-2" style="font-size:0.9rem;">
                            <i class="bi bi-list-ul me-1"></i>Danh sách mặt hàng xuất bán
                        </div>
                    </div>
                    <div class="table-responsive px-4 pb-3">
                        <table class="table table-bordered table-hover" style="font-size:0.875rem;white-space:nowrap;">
                            <thead style="background:#f4f6f9;color:#333;">
                                <tr>
                                    <th class="text-center" style="width:45px;">STT</th>
                                    <th class="text-center">Mã SP</th>
                                    <th>Tên sản phẩm</th>
                                    <th class="text-center">ĐVT</th>
                                    <th class="text-end">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th class="text-end">Tổng tiền hàng</th>
                                    <th>Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var chiTiets = ViewBag.ChiTiets as List<SalesManagementSystem.Models.ViewModels.BaoCaoDoiChieuCongNoKhachHangDetailViewModel>;
                                    int idx = 0;
                                    if (chiTiets != null && chiTiets.Any())
                                    {
                                        foreach (var ct in chiTiets)
                                        {
                                            idx++;
                                            <tr>
                                                <td class="text-center">@idx</td>
                                                <td class="text-center"><span class="badge bg-secondary">@ct.MaSanPham</span></td>
                                                <td>@ct.TenSanPham</td>
                                                <td class="text-center">@ct.DVT</td>
                                                <td class="text-end">@ct.SoLuong.ToString("N0")</td>
                                                <td class="text-end">@ct.DonGia.ToString("N0")</td>
                                                <td class="text-end fw-semibold">@ct.ThanhTien.ToString("N0")</td>
                                                <td class="text-end fw-bold text-primary">@ct.TongSauThue.ToString("N0")</td>
                                                <td>@ct.GhiChu</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted">Không tìm thấy chi tiết mặt hàng</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot style="background:#f4f6f9;font-weight:bold;">
                                <tr>
                                    <td colspan="4" class="text-end">TỔNG CỘNG:</td>
                                    <td class="text-end">@(((decimal)(ViewBag.TongSoLuong ?? 0m)).ToString("N0"))</td>
                                    <td></td>
                                    <td class="text-end">@(((decimal)(ViewBag.TongThanhTien ?? 0m)).ToString("N0"))</td>
                                    <td class="text-end text-primary">@tongCong.ToString("N0")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Summary cards -->
                    <div class="px-4 pb-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="rounded-3 p-3 text-center" style="background:#e8f4fd;border:1px solid #bcd9f0;">
                                    <div class="text-muted small mb-1">Tổng tiền bán hàng</div>
                                    <div class="fw-bold text-primary" style="font-size:1.1rem;">@tongCong.ToString("N0")</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="rounded-3 p-3 text-center" style="background:#e8f8f5;border:1px solid #a9dfd0;">
                                    <div class="text-muted small mb-1">Đã thanh toán</div>
                                    <div class="fw-bold text-success" style="font-size:1.1rem;">@daThanhToan.ToString("N0")</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="rounded-3 p-3 text-center" style="background:#fff3cd;border:1px solid #ffeeba;">
                                    <div class="text-muted small mb-1">Còn phải thu</div>
                                    <div class="fw-bold text-danger" style="font-size:1.1rem;">@conLai.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ====== PHIẾU TRẢ HÀNG BÁN ====== *@
            else if (loaiDong == 2)
            {
                string soChungTu        = ViewBag.TH_SoChungTu ?? "";
                string tenKH            = ViewBag.TH_TenKH ?? "";
                DateTime? ngayCT        = ViewBag.TH_NgayChungTu as DateTime?;
                decimal tongTienHang    = ViewBag.TH_TongTienHang != null ? (decimal)ViewBag.TH_TongTienHang : 0m;
                decimal tongTienDaHoan  = ViewBag.TH_TongTienDaHoan != null ? (decimal)ViewBag.TH_TongTienDaHoan : 0m;
                decimal conPhaiHoan     = ViewBag.TH_ConPhaiHoan != null ? (decimal)ViewBag.TH_ConPhaiHoan : 0m;
                string lyDoTra          = ViewBag.TH_LyDoTraHang ?? "";
                string nguoiTao         = ViewBag.TH_NguoiTao ?? "";

                <div class="modal-header" style="background: linear-gradient(135deg, #e67e22, #d35400); color: white; border-bottom: none; padding: 18px 24px;">
                    <div>
                        <h5 class="modal-title fw-bold mb-1" id="detailsModalKHLabel">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Chi tiết Phiếu Trả Hàng Bán
                        </h5>
                        <div style="font-size: 0.85rem; opacity: 0.9;">
                            <span class="badge bg-light text-warning me-2 px-3 py-1" style="font-size:0.85rem;">@soChungTu</span>
                            @if (ngayCT.HasValue)
                            {
                                <span class="me-3"><i class="bi bi-calendar3 me-1"></i>@ngayCT.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (!string.IsNullOrEmpty(nguoiTao))
                            {
                                <span><i class="bi bi-person me-1"></i>Người lập: @nguoiTao</span>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-0">
                    <!-- Info header -->
                    <div class="px-4 py-3" style="background: #fff8f0; border-bottom: 1px solid #f9e2d0;">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;background:#fdebd0;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-person-circle text-warning"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted" style="font-size:0.75rem;">Khách hàng trả hàng</div>
                                        <div class="fw-semibold" style="font-size:0.95rem;">@tenKH</div>
                                    </div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(lyDoTra))
                            {
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:34px;height:34px;background:#fdebd0;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                            <i class="bi bi-chat-square-text text-warning"></i>
                                        </div>
                                        <div>
                                            <div class="text-muted" style="font-size:0.75rem;">Lý do trả hàng</div>
                                            <div class="fw-semibold" style="font-size:0.95rem;">@lyDoTra</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Chi tiết sản phẩm trả -->
                    <div class="px-4 pt-3 pb-1">
                        <div class="fw-semibold text-warning mb-2" style="font-size:0.9rem;">
                            <i class="bi bi-list-ul me-1"></i>Danh sách sản phẩm trả lại
                        </div>
                    </div>
                    <div class="table-responsive px-4 pb-3">
                        <table class="table table-bordered table-hover" style="font-size:0.875rem;white-space:nowrap;">
                            <thead style="background:#f4f6f9;color:#333;">
                                <tr>
                                    <th class="text-center" style="width:45px;">STT</th>
                                    <th class="text-center">Mã SP</th>
                                    <th>Tên sản phẩm</th>
                                    <th class="text-center">ĐVT</th>
                                    <th class="text-end">Số lượng trả</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền trả</th>
                                    <th>Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var chiTiets = ViewBag.ChiTiets as List<SalesManagementSystem.Models.ViewModels.BaoCaoDoiChieuCongNoKhachHangDetailViewModel>;
                                    int idx = 0;
                                    if (chiTiets != null && chiTiets.Any())
                                    {
                                        foreach (var ct in chiTiets)
                                        {
                                            idx++;
                                            <tr>
                                                <td class="text-center">@idx</td>
                                                <td class="text-center"><span class="badge bg-secondary">@ct.MaSanPham</span></td>
                                                <td>@ct.TenSanPham</td>
                                                <td class="text-center">@ct.DVT</td>
                                                <td class="text-end text-warning fw-bold">@ct.SoLuong.ToString("N0")</td>
                                                <td class="text-end">@ct.DonGia.ToString("N0")</td>
                                                <td class="text-end fw-bold text-danger">@ct.ThanhTien.ToString("N0")</td>
                                                <td>@ct.GhiChu</td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                            <tfoot style="background:#f4f6f9;font-weight:bold;">
                                <tr>
                                    <td colspan="4" class="text-end">TỔNG CỘNG:</td>
                                    <td class="text-end text-warning">@(((decimal)(ViewBag.TongSoLuong ?? 0m)).ToString("N0"))</td>
                                    <td></td>
                                    <td class="text-end text-danger">@tongTienHang.ToString("N0")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Summary cards -->
                    <div class="px-4 pb-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="rounded-3 p-3 text-center" style="background:#fef5e7;border:1px solid #f9e79f;">
                                    <div class="text-muted small mb-1">Tổng tiền giá trị trả</div>
                                    <div class="fw-bold text-warning" style="font-size:1.1rem;">@tongTienHang.ToString("N0")</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="rounded-3 p-3 text-center" style="background:#e8f8f5;border:1px solid #a9dfd0;">
                                    <div class="text-muted small mb-1">Đã hoàn tiền</div>
                                    <div class="fw-bold text-success" style="font-size:1.1rem;">@tongTienDaHoan.ToString("N0")</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="rounded-3 p-3 text-center" style="background:#fceae8;border:1px solid #f5b7b1;">
                                    <div class="text-muted small mb-1">Còn phải hoàn</div>
                                    <div class="fw-bold text-danger" style="font-size:1.1rem;">@conPhaiHoan.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ====== PHIẾU THU TIỀN KHÁCH HÀNG ====== *@
            else if (loaiDong == 3)
            {
                string soPhieuThu     = ViewBag.PT_SoPhieuThu ?? "";
                string tenKH          = ViewBag.PT_TenKH ?? "";
                DateTime? ngayThu     = ViewBag.PT_NgayThu as DateTime?;
                decimal soTienThu     = ViewBag.PT_SoTienThu != null ? (decimal)ViewBag.PT_SoTienThu : 0m;
                string ghiChu         = ViewBag.PT_GhiChu ?? "";
                string hinhThuc       = ViewBag.PT_HinhThuc ?? "";
                string tenTaiKhoan    = ViewBag.PT_TenTaiKhoan ?? "";
                string nganHang       = ViewBag.PT_NganHang ?? "";
                string nguoiTao       = ViewBag.PT_NguoiTao ?? "";

                <div class="modal-header" style="background: linear-gradient(135deg, #27ae60, #1abc9c); color: white; border-bottom: none; padding: 18px 24px;">
                    <div>
                        <h5 class="modal-title fw-bold mb-1" id="detailsModalKHLabel">
                            <i class="bi bi-cash-stack me-2"></i>Chi tiết Phiếu Thu Tiền Khách Hàng
                        </h5>
                        <div style="font-size: 0.85rem; opacity: 0.9;">
                            <span class="badge bg-light text-success me-2 px-3 py-1" style="font-size:0.85rem;">@soPhieuThu</span>
                            @if (ngayThu.HasValue)
                            {
                                <span class="me-3"><i class="bi bi-calendar3 me-1"></i>@ngayThu.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (!string.IsNullOrEmpty(nguoiTao))
                            {
                                <span><i class="bi bi-person me-1"></i>Người lập: @nguoiTao</span>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-0">
                    <div class="px-4 py-4">
                        <div class="row g-4">
                            <!-- Thông tin phiếu thu -->
                            <div class="col-md-6">
                                <div class="card border-0 rounded-3 h-100" style="background:#f8fffe;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
                                    <div class="card-header border-0 pb-0" style="background:transparent;">
                                        <h6 class="fw-bold text-success mb-0"><i class="bi bi-info-circle me-1"></i>Thông tin phiếu thu</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm table-borderless mb-0">
                                            <tr>
                                                <td class="text-muted" style="width:140px;">Số phiếu thu</td>
                                                <td><span class="badge bg-success px-3">@soPhieuThu</span></td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Ngày thu</td>
                                                <td class="fw-semibold">@(ngayThu.HasValue ? ngayThu.Value.ToString("dd/MM/yyyy") : "-")</td>
                                            </tr>
                                            @if (!string.IsNullOrEmpty(nguoiTao))
                                            {
                                                <tr>
                                                    <td class="text-muted">Người lập phiếu</td>
                                                    <td class="fw-semibold">@nguoiTao</td>
                                                </tr>
                                            }
                                            <tr>
                                                <td class="text-muted">Khách hàng</td>
                                                <td class="fw-semibold">@tenKH</td>
                                            </tr>
                                            @if (!string.IsNullOrEmpty(hinhThuc))
                                            {
                                                <tr>
                                                    <td class="text-muted">Hình thức thu</td>
                                                    <td class="fw-semibold">@hinhThuc</td>
                                                </tr>
                                            }
                                            @if (!string.IsNullOrEmpty(tenTaiKhoan))
                                            {
                                                <tr>
                                                    <td class="text-muted">Tài khoản thu</td>
                                                    <td class="fw-semibold">@tenTaiKhoan</td>
                                                </tr>
                                            }
                                            @if (!string.IsNullOrEmpty(nganHang))
                                            {
                                                <tr>
                                                    <td class="text-muted">Ngân hàng</td>
                                                    <td class="fw-semibold">@nganHang</td>
                                                </tr>
                                            }
                                            @if (!string.IsNullOrEmpty(ghiChu))
                                            {
                                                <tr>
                                                    <td class="text-muted">Ghi chú / Diễn giải</td>
                                                    <td>@ghiChu</td>
                                                </tr>
                                            }
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Số tiền thu -->
                            <div class="col-md-6">
                                <div class="card border-0 rounded-3 h-100 text-center d-flex align-items-center justify-content-center"
                                     style="background: linear-gradient(135deg, #27ae60, #1abc9c); color: white;">
                                    <div class="card-body">
                                        <div class="mb-2" style="font-size: 0.9rem; opacity: 0.9;">
                                            <i class="bi bi-wallet2 me-1"></i>SỐ TIỀN THU
                                        </div>
                                        <div style="font-size: 2rem; font-weight: 800; letter-spacing: -0.5px;">
                                            @soTienThu.ToString("N0")
                                        </div>
                                        <div style="font-size: 0.85rem; opacity: 0.85; margin-top: 4px;">VNĐ</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="modal-footer" style="border-top: 1px solid #e9ecef; padding: 12px 20px; background:#fafbfc;">
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Đóng
                </button>
            </div>
        </div>
    </div>
</div>
