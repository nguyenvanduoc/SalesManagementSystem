@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.NhaCungCapViewModel>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height: 350px;">
            <table class="table table-custom table-bordered table-hover mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 40px;"><input type="checkbox" class="form-check-input" id="checkAll"></th>
                        <th class="text-center" style="width: 50px;">Thao tác</th>
                        <th class="text-center" style="width: 50px;">STT</th>
                        <th>Mã nhà cung cấp</th>
                        <th>Tên nhà cung cấp</th>
                        <th>Điện thoại</th>
                        <th>Email</th>
                        <th>Địa chỉ</th>
                        <th class="text-center">Ngày tạo</th>
                        <th>Người tạo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <input type="checkbox" class="form-check-input row-checkbox" value="@item.ID">
                                </td>
                                <td class="text-center align-middle">
                                    <div class="dropdown dropdown-hover">
                                        <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 6px;">
                                            <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow">
                                            <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>
                                            <li><hr class="dropdown-divider"></li>
                                         
                                            @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("NhaCungCap", SalesManagementSystem.Helpers.LoaiPhanQuyen.CapNhat))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item" onclick="openFormModal('@Url.Action("Edit", "NhaCungCap", new { id = item.ID })')">
                                                        <i class="bi bi-pencil-square me-2 text-primary"></i> Chỉnh sửa
                                                    </button>
                                                </li>
                                            }
                                            @if (SalesManagementSystem.Helpers.PermissionHelper.HasPermission("NhaCungCap", SalesManagementSystem.Helpers.LoaiPhanQuyen.Xoa))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger" onclick="confirmDelete('@Url.Action("Delete", "NhaCungCap", new { id = item.ID })', 'Bạn có chắc chắn muốn xóa nhà cung cấp @item.MaNhaCungCap?')">
                                                        <i class="bi bi-trash-fill me-2 text-danger"></i> Xóa
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center align-middle">@stt</td>
                                <td class="align-middle">@item.MaNhaCungCap</td>
                                <td class="align-middle">@item.TenNhaCungCap</td>
                                <td class="align-middle">@item.DienThoai</td>
                                <td class="align-middle">@item.Email</td>
                                <td class="align-middle">@item.DiaChi</td>
                                <td class="text-center align-middle">
                                    @(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy HH") : "")
                                </td>
                                <td class="align-middle">@item.TenNguoiTao</td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">Chưa có dữ liệu nhà cung cấp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @Html.Partial("_Pagination", Model)
</div>
