@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.NhaCungCapViewModel>

@{
    ViewBag.Title = "Danh mục nhà cung cấp";
}

@using SalesManagementSystem.Helpers
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">@ViewBag.Title</h4>
    <div class="d-flex gap-2">
        @if (PermissionHelper.HasPermission("NhaCungCap", LoaiPhanQuyen.Them))
        {
            <button type="button" class="btn btn-primary" style="background-color: #3498db; border-color: #3498db;" onclick="openFormModal('@Url.Action("Create", "NhaCungCap")')">
                <i class="bi bi-plus-lg fw-bold"></i> Thêm mới
            </button>
        }
        @if (PermissionHelper.HasPermission("NhaCungCap", LoaiPhanQuyen.Xoa))
        {
            <button type="button" class="btn btn-danger" style="background-color: #e74c3c; border-color: #e74c3c;" onclick="deleteSelectedNhaCungCap()">
                <i class="bi bi-trash"></i> Xóa
            </button>
        }
    </div>
</div>

<!-- Bộ lọc tìm kiếm theo chuẩn UI -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("GetList")" id="searchForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1 fw-semibold">Mã nhà cung cấp</label>
                    <input type="text" name="ma" class="form-control form-control-sm" placeholder="Tìm mã..." value="@ViewBag.Ma">
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small mb-1 fw-semibold">Tên nhà cung cấp</label>
                    <input type="text" name="ten" class="form-control form-control-sm" placeholder="Tìm tên..." value="@ViewBag.Ten">
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small mb-1 fw-semibold">Điện thoại</label>
                    <input type="text" name="dt" class="form-control form-control-sm" placeholder="Tìm số điện thoại..." value="@ViewBag.Dt">
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small mb-1 fw-semibold">Email</label>
                    <input type="text" name="email" class="form-control form-control-sm" placeholder="Tìm email..." value="@ViewBag.Email">
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm text-white px-3 w-100" style="background-color: #2998e4; border: none;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn btn-sm text-white px-3 w-100 btn-reset" style="background-color: #f1c40f; border: none;">
                        Làm mới
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="table-container">
    @Html.Partial("_NhaCungCapList", Model)
</div>

@section Scripts {
    <script>
        (function() {
            var $pane = $('#searchForm').closest('.tab-pane');
            if ($pane.length === 0) $pane = $('body');

            // Check/Uncheck all checkboxes
            $pane.on('change', '#checkAll', function() {
                $pane.find('.row-checkbox').prop('checked', $(this).prop('checked'));
            });

            // If any row checkbox is unchecked, uncheck the header checkbox
            $pane.on('change', '.row-checkbox', function() {
                if ($pane.find('.row-checkbox:checked').length === $pane.find('.row-checkbox').length && $pane.find('.row-checkbox').length > 0) {
                    $pane.find('#checkAll').prop('checked', true);
                } else {
                    $pane.find('#checkAll').prop('checked', false);
                }
            });

            $pane.on('click', '.btn-reset', function() {
                $pane.find('input[name="ma"]').val('');
                $pane.find('input[name="ten"]').val('');
                $pane.find('input[name="dt"]').val('');
                $pane.find('input[name="email"]').val('');
                $pane.find('#searchForm').trigger('submit');
            });

            window.deleteSelectedNhaCungCap = function() {
                var selectedIds = [];
                $pane.find('.row-checkbox:checked').each(function() {
                    selectedIds.push($(this).val());
                });

                if (selectedIds.length === 0) {
                    showToast('warning', 'Vui lòng chọn ít nhất một bản ghi để thao tác.');
                    return;
                }

                var url = '@Url.Action("Delete", "NhaCungCap")';
                var msg = "Bạn có chắc chắn muốn xóa " + selectedIds.length + " nhà cung cấp đã chọn không?";
                
                confirmBatchDelete(url, selectedIds, msg);
            };
        })();
    </script>
}
