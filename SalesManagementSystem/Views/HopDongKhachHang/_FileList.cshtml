@model IEnumerable<SalesManagementSystem.Models.Entities.HopDongKhachHangFile>

<div class="mt-3" style="overflow: visible;">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th class="text-center" style="width: 60px;">Thao tác</th>
                <th class="text-center" style="width: 50px;">STT</th>
                <th>Tên file</th>
                <th>Người tải lên</th>
                <th class="text-center">Ngày tải</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int stt = 1;
                foreach (var file in Model)
                {
                    <tr>
                        <td class="text-center align-middle">
                            <div class="dropdown dropdown-hover">
                                <button class="btn btn-sm btn-light border dropdown-toggle-hide-arrow shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 6px;">
                                    <i class="bi bi-grid-3x3-gap-fill text-dark"></i>
                                </button>
                                <ul class="dropdown-menu shadow">
                                    <li><h6 class="dropdown-header text-uppercase fw-bold text-dark">Thao tác</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a href="@Url.Action("ViewFile", "HopDongKhachHang", new { id = file.ID })" target="_blank" class="dropdown-item text-primary">
                                            <i class="bi bi-eye me-2 text-primary"></i> Xem file
                                        </a>
                                    </li>
                                    <li>
                                        <a href="@Url.Action("DownloadFile", "HopDongKhachHang", new { id = file.ID })" target="_blank" download class="dropdown-item text-success">
                                            <i class="bi bi-download me-2 text-success"></i> Tải xuống
                                        </a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0);" onclick="DeleteFile(@file.ID, this)" class="dropdown-item text-danger">
                                            <i class="bi bi-trash me-2 text-danger"></i> Xóa file
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                        <td class="text-center align-middle">@(stt++)</td>
                        <td class="fw-bold align-middle">
                            @if (file.LoaiFile.ToLower() == "pdf") { <i class="bi bi-file-earmark-pdf text-danger me-2"></i> }
                            else if (file.LoaiFile.ToLower() == "jpg" || file.LoaiFile.ToLower() == "png") { <i class="bi bi-file-image text-success me-2"></i> }
                            else if (file.LoaiFile.ToLower().StartsWith("doc")) { <i class="bi bi-file-earmark-word text-primary me-2"></i> }
                            else if (file.LoaiFile.ToLower().StartsWith("xls")) { <i class="bi bi-file-earmark-excel text-success me-2"></i> }
                            else { <i class="bi bi-file-earmark text-muted me-2"></i> }
                            @file.TenFile
                        </td>

                        <td class="align-middle">@file.TenNguoiTao</td>
                        <td class="text-center align-middle">@(file.NgayTao?.ToString("dd/MM/yyyy"))</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                        Chưa có file đính kèm nào.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
