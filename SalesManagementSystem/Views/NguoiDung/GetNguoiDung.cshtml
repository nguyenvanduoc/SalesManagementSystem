@model IEnumerable<SalesManagementSystem.Models.ViewModels.AclLoginVM>
@{
    ViewBag.Title = "Quản lý Tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 text-primary-custom" style="color: #0b5b84;">@ViewBag.Title</h4>
    <button type="button" class="btn btn-primary" onclick="openFormModal('@Url.Action("CreateNguoiDung", "NguoiDung")')" style="background-color: #0b5b84; border: none;">
        <i class="bi bi-plus-circle me-1"></i> Thêm mới
    </button>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form id="searchForm" onsubmit="event.preventDefault(); loadData(1);">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <input type="text" id="keyword" name="keyword" class="form-control" placeholder="Tìm kiếm theo Tên đăng nhập hoặc Tên nhân viên..." value="@ViewBag.Keyword">
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn text-white px-3" style="background-color: #2998e4; border: none;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn text-white px-3" style="background-color: #f1c40f; border: none;" onclick="resetSearch()">
                        Làm mới
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div id="table-container">
        @Html.Partial("_NguoiDungList", Model)
    </div>
</div>

@section Scripts {
    <script>
        function loadData(page) {
            var keyword = $('#keyword').val();
            var pageSize = $('#pageSizeSelect').length > 0 ? $('#pageSizeSelect').val() : 10;
            
            $.ajax({
                url: '@Url.Action("GetNguoiDung", "NguoiDung")',
                type: 'GET',
                data: { page: page, pageSize: pageSize, keyword: keyword },
                success: function (result) {
                    $('#table-container').html(result);
                },
                error: function () {
                    if (typeof showToast === "function") {
                        showToast('error', 'Lỗi khi tải dữ liệu.');
                    } else {
                        alert('Lỗi khi tải dữ liệu.');
                    }
                }
            });
        }

        function resetSearch() {
            $('#keyword').val('');
            loadData(1);
        }

        // Lắng nghe thay đổi kích thước trang (pageSize) nếu có dropdown trong PartialView
        $(document).on('change', '#pageSizeSelect', function() {
            loadData(1);
        });

        // Xử lý nút bấm phân trang sử dụng AJAX
        $(document).on('click', '.ajax-link', function (e) {
            e.preventDefault();
            var page = $(this).data('page');
            if (page) {
                loadData(page);
            }
        });
    </script>
}
