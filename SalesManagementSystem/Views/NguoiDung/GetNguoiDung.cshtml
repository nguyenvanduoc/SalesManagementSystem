@model SalesManagementSystem.Models.ViewModels.PagedListViewModel<SalesManagementSystem.Models.ViewModels.AclLoginViewModel>
@{
    ViewBag.Title = "Quản lý Tài khoản";
}

@using SalesManagementSystem.Helpers
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold text-uppercase" style="color: #0b5b84; font-size: 1.25rem;">@ViewBag.Title</h4>
    @if (PermissionHelper.HasPermission("NguoiDung", LoaiPhanQuyen.Them))
    {
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success" onclick="openFormModal('@Url.Action("CreateNguoiDung", "NguoiDung", new { isManager = true })')" style="border: none;">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm cấp trên
            </button>
            <button type="button" class="btn btn-primary" onclick="openFormModal('@Url.Action("CreateNguoiDung", "NguoiDung", new { isManager = false })')" style="background-color: #0b5b84; border: none;">
                <i class="bi bi-plus-circle me-1"></i> Thêm mới
            </button>
        </div>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form id="searchForm" method="get" action="@Url.Action("GetNguoiDung", "NguoiDung")">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <input type="text" id="keyword" name="keyword" class="form-control" placeholder="Tìm kiếm theo Tên đăng nhập hoặc Tên nhân sự..." value="@ViewBag.Keyword">
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn text-white px-3" style="background-color: #2998e4; border: none;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn text-white px-3 btn-reset" style="background-color: #f1c40f; border: none;">
                        Làm mới
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div id="table-container">
        @Html.Partial("_NguoiDungList", Model)
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var $pane = $('#searchForm').closest('.tab-pane');
            if ($pane.length === 0) $pane = $('body');

            $pane.find('#searchForm').on('submit', function(e) {
                e.preventDefault();
                var keyword = $pane.find('#keyword').val();
                var pageSize = $pane.find('.page-size-select').length > 0 ? $pane.find('.page-size-select').last().val() : 10;
                
                $.ajax({
                    url: '@Url.Action("GetNguoiDung", "NguoiDung")',
                    type: 'GET',
                    data: { page: 1, pageSize: pageSize, keyword: keyword },
                    success: function (result) {
                        $pane.find('#table-container').html(result);
                    },
                    error: function () {
                        if (typeof showToast === "function") {
                            showToast('error', 'Lỗi khi tải dữ liệu.');
                        } else {
                            alert('Lỗi khi tải dữ liệu.');
                        }
                    }
                });
            });

        })();
    </script>
}
