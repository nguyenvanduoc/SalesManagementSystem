@model SalesManagementSystem.Models.ViewModels.ChangePasswordViewModel

@{
    Layout = null;
}

<div class="modal-header bg-light">
    <h5 class="modal-title fw-bold text-uppercase" style="color: #0b5b84;">Cập nhật mật khẩu</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

@using (Html.BeginForm("ChangePassword", "NguoiDung", FormMethod.Post, new { id = "frmChangePassword" }))
{
    @Html.AntiForgeryToken()
    <div class="modal-body px-4 py-4">
        <div class="row mb-4 align-items-center">
            <label class="col-sm-4 col-form-label text-sm-start" style="color: #0b5b84;">
                Mật khẩu cũ <span class="text-danger">(*)</span>
            </label>
            <div class="col-sm-8">
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control rounded-2", required = "required", autocomplete = "new-password", oninvalid = "this.setCustomValidity('Bạn chưa nhập thông tin Mật khẩu cũ')", oninput = "this.setCustomValidity('')" })
                @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger small mt-1 d-block" })
            </div>
        </div>

        <div class="row mb-4 align-items-center">
            <label class="col-sm-4 col-form-label text-sm-start" style="color: #0b5b84;">
                Mật khẩu mới <span class="text-danger">(*)</span>
            </label>
            <div class="col-sm-8">
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control rounded-2", required = "required", autocomplete = "new-password", oninvalid = "this.setCustomValidity('Bạn chưa nhập thông tin Mật khẩu mới')", oninput = "this.setCustomValidity('')" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small mt-1 d-block" })
            </div>
        </div>

        <div class="row mb-4 align-items-center">
            <label class="col-sm-4 col-form-label text-sm-start" style="color: #0b5b84;">
                Nhập lại mật khẩu <span class="text-danger">(*)</span>
            </label>
            <div class="col-sm-8">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control rounded-2", required = "required", autocomplete = "new-password", oninvalid = "this.setCustomValidity('Bạn chưa nhập thông tin Nhập lại mật khẩu')", oninput = "this.setCustomValidity('')" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1 d-block" })
            </div>
        </div>

        <div class="row">
            <div class="col-12 text-muted" style="font-size: 0.95rem; color: #0b5b84;">
                Lưu ý: Mật khẩu phải có ít nhất 8 ký tự (bao gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt)
            </div>
        </div>
    </div>
    
    <div class="modal-footer justify-content-center border-0 pb-4 pt-0">
        <button type="submit" class="btn px-4 py-2 text-white shadow-sm" style="background-color: #26c6da; border-radius: 4px; font-weight: 500;">
            Lưu
        </button>
        <button type="button" class="btn px-4 py-2 text-white shadow-sm ms-2" data-bs-dismiss="modal" style="background-color: #95a5a6; border-radius: 4px; font-weight: 500;">
            Đóng
        </button>
    </div>
}

<script>
    // Cho phép validation hoạt động trong modal (unobtrusive ajax)
    if ($.validator && $.validator.unobtrusive) {
        var form = document.getElementById('frmChangePassword');
        $.validator.unobtrusive.parse(form);
    }
</script>
